
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Promotions | Carry Nest</title>

    <link rel="stylesheet" href="/Styles/admin/coupons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <div class="sidebar-top">

            <div class="logo-section">
                <div class="logo-box">C</div>
                <h2>CARRY NEST</h2>
                <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Close menu">
                    <i class="ri-close-line"></i>
                </button>
            </div>

            <nav class="menu-wrapper">

                <a href="/admin/dashboard" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-dashboard-line"></i>
                        Dashboard
                    </span>
                </a>

                <div class="dropdown-wrapper">
                    <button type="button" class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-shopping-bag-line"></i>
                            Products
                        </span>
                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/products">All Products</a>
                        <a href="/admin/add-product">Add Product</a>
                        <a href="/admin/category">Categories</a>
                        <a href="/admin/brands">Brands</a>
                    </div>
                </div>

                <div class="dropdown-wrapper">
                    <button type="button" class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-shopping-cart-line"></i>
                            Orders
                        </span>
                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/orders">All Orders</a>
                        <a href="/admin/orders?status=pending">Pending</a>
                        <a href="/admin/orders?status=shipped">Shipped</a>
                        <a href="/admin/orders?status=delivered">Delivered</a>
                    </div>
                </div>

                <div class="dropdown-wrapper">
                    <button type="button" class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-arrow-go-back-line"></i>
                            Returns
                        </span>
                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/return-requests">Requests</a>
                    </div>
                </div>

                <a href="/admin/customers" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-group-line"></i>
                        Customers
                    </span>
                </a>

                <a href="/admin/wallet" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-wallet-3-line"></i>
                        Wallet & Payments
                    </span>
                </a>

                <a href="/admin/coupons" class="menu-item active">
                    <span class="menu-left">
                        <i class="ri-price-tag-3-line"></i>
                        Promotions
                    </span>
                </a>

                <a href="/admin/sales-report" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-bar-chart-box-line"></i>
                        Reports
                    </span>
                </a>

            </nav>
        </div>

        <div class="logout-section">
            <a href="/admin/logout" class="logout-btn">
                <i class="ri-logout-box-r-line"></i>
                Logout
            </a>
        </div>

    </aside>

    <!-- MOBILE SIDEBAR OVERLAY -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="topbar-left">
                <button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open navigation">
                    <i class="ri-menu-line"></i>
                </button>

                <div>
                    <p class="breadcrumb">
                        Admin <span>/</span> Promotions
                    </p>
                </div>
            </div>

            <div class="top-right">

                <div class="admin-profile">
                    <div class="admin-avatar">AD</div>
                    <div class="admin-profile-info">
                        <h4>Admin User</h4>
                        <span>Super Admin</span>
                    </div>
                </div>

            </div>

        </header>

        <!-- PAGE HEADER -->
        <section class="page-header">

            <div class="page-header-info">
                <div class="page-eyebrow">
                    <i class="ri-price-tag-3-line"></i>
                    Promotion Management
                </div>

                <h1>Promotions</h1>

                <p>Manage coupon codes, product discounts and category offers.</p>
            </div>

        </section>

        <!-- COUPONS SECTION -->
        <section class="management-section">

            <div class="section-heading">

                <div class="section-heading-info">
                    <div class="section-icon coupon-section-icon">
                        <i class="ri-coupon-3-line"></i>
                    </div>

                    <div>
                        <h2>Coupons</h2>
                        <p>Manage coupon codes and customer discounts.</p>
                    </div>
                </div>

                <a href="/admin/coupons/add" class="section-action-btn">
                    <i class="ri-add-line"></i>
                    Add Coupon
                </a>

            </div>

            <div class="table-card">

                <div class="table-card-header">
                    <div>
                        <h3>Coupon List</h3>
                        <p>Manage coupon validity, discount and status.</p>
                    </div>

                    <span class="section-label">
                        <i class="ri-ticket-2-line"></i>
                        Coupon Management
                    </span>
                </div>

                <div class="table-responsive">

                    <table class="coupons-table">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Coupon Details</th>
                                <th>Code</th>
                                <th>Type</th>
                                <th>Applies To</th>
                                <th>Discount</th>
                                <th>Validity</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (coupons && coupons.length > 0) { %>

                                <% coupons.forEach((coupon, index) => { %>

                                    <tr>

                                        <td class="row-number">
                                            <%= (couponPage - 1) * 5 + index + 1 %>
                                        </td>

                                        <td>
                                            <div class="coupon-details">
                                                <strong><%= coupon.description %></strong>
                                                <span>Coupon promotion</span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="coupon-code">
                                                <%= coupon.discountCode %>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="type-badge">
                                                <%= coupon.discountType === "percentage"
                                                    ? "Percentage"
                                                    : "Fixed Amount" %>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="target-text">
                                                <%= coupon.applyTo === "cart_total"
                                                    ? "Cart Total"
                                                    : "Each Product" %>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="discount-value">
                                                <% if (coupon.discountType === "percentage") { %>
                                                    <%= coupon.discountValue %>%
                                                <% } else { %>
                                                    ₹<%= Number(coupon.discountValue || 0).toLocaleString("en-IN") %>
                                                <% } %>
                                            </span>
                                        </td>

                                        <td>
                                            <div class="date-range">
                                                <span>
                                                    <%= new Date(coupon.validFrom).toLocaleDateString("en-IN") %>
                                                </span>
                                                <i class="ri-arrow-right-line"></i>
                                                <span>
                                                    <%= new Date(coupon.validTo).toLocaleDateString("en-IN") %>
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="status-cell">

                                                <form
                                                    action="/admin/coupons/toggle/<%= coupon._id %>?_method=PATCH"
                                                    method="POST"
                                                    class="coupon-toggle-form"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="status-toggle <%= coupon.isActive ? 'active' : '' %>"
                                                        aria-label="Toggle coupon status"
                                                        title="Toggle coupon status"
                                                    >
                                                        <span class="toggle-circle"></span>
                                                    </button>
                                                </form>

                                                <span class="status-text <%= coupon.isActive ? 'active-text' : 'inactive-text' %>">
                                                    <%= coupon.isActive ? "Active" : "Inactive" %>
                                                </span>

                                            </div>
                                        </td>

                                        <td>
                                            <div class="action-buttons">

                                                <a
                                                    href="/admin/coupons/edit/<%= coupon._id %>"
                                                    class="action-btn edit-action"
                                                    title="Edit coupon"
                                                    aria-label="Edit coupon"
                                                >
                                                    <i class="ri-pencil-line"></i>
                                                </a>

                                                <form
                                                    action="/admin/coupons/delete/<%= coupon._id %>?_method=DELETE"
                                                    method="POST"
                                                    class="delete-coupon-form"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="action-btn delete-action"
                                                        title="Delete coupon"
                                                        aria-label="Delete coupon"
                                                    >
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                </form>

                                            </div>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="9" class="empty-row">
                                        <div class="empty-state">
                                            <div class="empty-icon">
                                                <i class="ri-coupon-3-line"></i>
                                            </div>
                                            <strong>No coupons available</strong>
                                            <p>Create your first coupon to start offering discounts.</p>
                                            <a href="/admin/coupons/add" class="empty-action">
                                                <i class="ri-add-line"></i>
                                                Create Coupon
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

                <!-- COUPON PAGINATION -->
                <% if (couponTotalPages > 1) { %>

                    <div class="pagination-footer">

                        <span class="pagination-info">
                            Coupon page <strong><%= couponPage %></strong> of <strong><%= couponTotalPages %></strong>
                        </span>

                        <div class="pagination">

                            <% if (couponPage > 1) { %>
                                <a href="?couponPage=<%= couponPage - 1 %>&offerPage=<%= offerPage %>" class="page-btn">
                                    <i class="ri-arrow-left-line"></i>
                                    Previous
                                </a>
                            <% } %>

                            <% for (let i = 1; i <= couponTotalPages; i++) { %>
                                <a
                                    href="?couponPage=<%= i %>&offerPage=<%= offerPage %>"
                                    class="page-btn <%= couponPage === i ? 'active' : '' %>"
                                >
                                    <%= i %>
                                </a>
                            <% } %>

                            <% if (couponPage < couponTotalPages) { %>
                                <a href="?couponPage=<%= couponPage + 1 %>&offerPage=<%= offerPage %>" class="page-btn">
                                    Next
                                    <i class="ri-arrow-right-line"></i>
                                </a>
                            <% } %>

                        </div>

                    </div>

                <% } %>

            </div>

        </section>

        <!-- OFFERS SECTION -->
        <section class="management-section offers-section">

            <div class="section-heading">

                <div class="section-heading-info">
                    <div class="section-icon offer-section-icon">
                        <i class="ri-percent-line"></i>
                    </div>

                    <div>
                        <h2>Product & Category Offers</h2>
                        <p>Manage product-specific and category discounts.</p>
                    </div>
                </div>

                <a href="/admin/add-offer" class="section-action-btn">
                    <i class="ri-add-line"></i>
                    Add New Offer
                </a>

            </div>

            <div class="table-card">

                <div class="table-card-header">
                    <div>
                        <h3>Offer List</h3>
                        <p>Manage offer details, discount percentage and validity.</p>
                    </div>

                    <span class="section-label offer-label">
                        <i class="ri-percent-line"></i>
                        Offers Management
                    </span>
                </div>

                <div class="table-responsive">

                    <table class="offers-table">

                        <thead>
                            <tr>
                                <th>Offer Details</th>
                                <th>Type</th>
                                <th>Target</th>
                                <th>Discount</th>
                                <th>Validity</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (offers && offers.length > 0) { %>

                                <% offers.forEach(offer => { %>

                                    <tr>

                                        <td>
                                            <div class="offer-details">
                                                <strong><%= offer.title %></strong>
                                                <span>
                                                    ID: <%= String(offer._id).slice(-6).toUpperCase() %>
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="offer-type-badge">
                                                <%= offer.offerType === "product" ? "Product" : "Category" %>
                                            </span>
                                        </td>

                                        <td>
                                            <div class="offer-target">
                                                <% if (offer.offerType === "product") { %>
                                                    <i class="ri-shopping-bag-line"></i>
                                                    <%= offer.productId?.productName || "Product unavailable" %>
                                                <% } else { %>
                                                    <i class="ri-folder-line"></i>
                                                    <%= offer.categoryId?.name || "Category unavailable" %>
                                                <% } %>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="offer-discount">
                                                <%= offer.discountPercentage %>% OFF
                                            </span>
                                        </td>

                                        <td>
                                            <div class="offer-date-range">
                                                <span>
                                                    <%= new Date(offer.validFrom).toLocaleDateString("en-IN") %>
                                                </span>
                                                <span class="date-separator">to</span>
                                                <span>
                                                    <%= new Date(offer.validTo).toLocaleDateString("en-IN") %>
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="offer-status <%= offer.isActive ? 'active' : 'inactive' %>">
                                                <span class="status-dot"></span>
                                                <%= offer.isActive ? "Active" : "Inactive" %>
                                            </span>
                                        </td>

                                        <td>
                                            <div class="offer-actions">

                                                <a
                                                    href="/admin/edit-offer/<%= offer._id %>"
                                                    class="action-btn edit-action"
                                                    title="Edit offer"
                                                    aria-label="Edit offer"
                                                >
                                                    <i class="ri-pencil-line"></i>
                                                </a>

                                                <form
                                                    action="/admin/offers/toggle/<%= offer._id %>?_method=PATCH"
                                                    method="POST"
                                                    class="toggle-offer-form"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="action-btn toggle-action"
                                                        title="Toggle offer"
                                                        aria-label="Toggle offer status"
                                                    >
                                                        <i class="ri-refresh-line"></i>
                                                    </button>
                                                </form>

                                                <form
                                                    action="/admin/offers/delete/<%= offer._id %>?_method=DELETE"
                                                    method="POST"
                                                    class="delete-offer-form"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="action-btn delete-action"
                                                        title="Delete offer"
                                                        aria-label="Delete offer"
                                                    >
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                </form>

                                            </div>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="7" class="empty-row">
                                        <div class="empty-state">
                                            <div class="empty-icon">
                                                <i class="ri-percent-line"></i>
                                            </div>
                                            <strong>No offers available</strong>
                                            <p>Create your first product or category offer.</p>
                                            <a href="/admin/add-offer" class="empty-action">
                                                <i class="ri-add-line"></i>
                                                Create Offer
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

                <!-- OFFER PAGINATION -->
                <% if (offerTotalPages > 1) { %>

                    <div class="pagination-footer">

                        <span class="pagination-info">
                            Offer page <strong><%= offerPage %></strong> of <strong><%= offerTotalPages %></strong>
                        </span>

                        <div class="pagination">

                            <% if (offerPage > 1) { %>
                                <a href="?couponPage=<%= couponPage %>&offerPage=<%= offerPage - 1 %>" class="page-btn">
                                    <i class="ri-arrow-left-line"></i>
                                    Previous
                                </a>
                            <% } %>

                            <% for (let i = 1; i <= offerTotalPages; i++) { %>
                                <a
                                    href="?couponPage=<%= couponPage %>&offerPage=<%= i %>"
                                    class="page-btn <%= offerPage === i ? 'active' : '' %>"
                                >
                                    <%= i %>
                                </a>
                            <% } %>

                            <% if (offerPage < offerTotalPages) { %>
                                <a href="?couponPage=<%= couponPage %>&offerPage=<%= offerPage + 1 %>" class="page-btn">
                                    Next
                                    <i class="ri-arrow-right-line"></i>
                                </a>
                            <% } %>

                        </div>

                    </div>

                <% } %>

            </div>

        </section>

        <footer class="page-footer">
            <span>Carry Nest Admin</span>
            <span>Promotion Management</span>
        </footer>

    </main>

</div>

<!-- SWEETALERT -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // SIDEBAR DROPDOWNS
    document.querySelectorAll(".dropdown-btn").forEach(button => {
        button.addEventListener("click", () => {
            const wrapper = button.closest(".dropdown-wrapper");

            document.querySelectorAll(".dropdown-wrapper").forEach(item => {
                if (item !== wrapper) {
                    item.classList.remove("active");
                    item.querySelector(".dropdown-menu")?.classList.remove("show");
                }
            });

            wrapper.classList.toggle("active");
            wrapper.querySelector(".dropdown-menu")?.classList.toggle("show");
        });
    });

    // MOBILE SIDEBAR
    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");
    const mobileMenuBtn = document.getElementById("mobileMenuBtn");
    const sidebarClose = document.getElementById("sidebarClose");

    function openSidebar() {
        sidebar.classList.add("sidebar-open");
        sidebarOverlay.classList.add("show");
        document.body.classList.add("sidebar-visible");
    }

    function closeSidebar() {
        sidebar.classList.remove("sidebar-open");
        sidebarOverlay.classList.remove("show");
        document.body.classList.remove("sidebar-visible");
    }

    mobileMenuBtn?.addEventListener("click", openSidebar);
    sidebarClose?.addEventListener("click", closeSidebar);
    sidebarOverlay?.addEventListener("click", closeSidebar);

    // COUPON DELETE CONFIRMATION
    document.querySelectorAll(".delete-coupon-form").forEach(form => {
        form.addEventListener("submit", function(event) {
            event.preventDefault();

            Swal.fire({
                title: "Delete this coupon?",
                text: "This coupon will be permanently deleted.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc2626",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Delete Coupon",
                cancelButtonText: "Cancel"
            }).then(result => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });

    // OFFER STATUS CONFIRMATION
    document.querySelectorAll(".toggle-offer-form").forEach(form => {
        form.addEventListener("submit", function(event) {
            event.preventDefault();

            Swal.fire({
                title: "Change offer status?",
                text: "Do you want to activate or deactivate this offer?",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#2563eb",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Yes, change",
                cancelButtonText: "Cancel"
            }).then(result => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });

    // OFFER DELETE CONFIRMATION
    document.querySelectorAll(".delete-offer-form").forEach(form => {
        form.addEventListener("submit", function(event) {
            event.preventDefault();

            Swal.fire({
                title: "Delete this offer?",
                text: "This action cannot be undone.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc2626",
                cancelButtonColor: "#64748b",
                confirmButtonText: "Delete Offer",
                cancelButtonText: "Cancel"
            }).then(result => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });
</script>

</body>
</html>
