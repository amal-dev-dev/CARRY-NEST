<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Coupons | Carry Nest</title>

    <link
        rel="stylesheet"
        href="/Styles/admin/coupons.css"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

</head>

<body>


<div class="dashboard-container">


    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">

        <div>

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-box">
                    C
                </div>

                <h2>CARRY NEST</h2>

            </div>


            <!-- MENU -->

            <div class="menu-wrapper">


                <!-- DASHBOARD -->

                <a
                    href="/admin/dashboard"
                    class="menu-item"
                >

                    <span class="menu-left">

                        <i class="ri-dashboard-line"></i>

                        Dashboard

                    </span>

                </a>


                <!-- PRODUCTS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-bag-line"></i>

                            Products

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>


                    <div class="dropdown-menu">

                        <a href="/admin/products">
                            All Products
                        </a>

                        <a href="/admin/add-product">
                            Add Product
                        </a>

                        <a href="/admin/category">
                            Categories
                        </a>

                        <a href="#">
                            Brands
                        </a>

                    </div>

                </div>


                <!-- ORDERS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-cart-line"></i>

                            Orders

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>


                    <div class="dropdown-menu">

                        <a href="/admin/orders">
                            All Orders
                        </a>

                        <a href="#">
                            Pending
                        </a>

                        <a href="#">
                            Processing
                        </a>

                        <a href="#">
                            Shipped
                        </a>

                    </div>

                </div>


                <!-- RETURNS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-arrow-go-back-line"></i>

                            Returns

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>


                    <div class="dropdown-menu">

                        <a href="/admin/return-requests">
                            Requests
                        </a>

                    </div>

                </div>


                <!-- CUSTOMERS -->

                <a
                    href="/admin/customers"
                    class="menu-item"
                >

                    <span class="menu-left">

                        <i class="ri-group-line"></i>

                        Customers

                    </span>

                </a>


                <!-- WALLET -->

                <a
                    href="/admin/wallet"
                    class="menu-item"
                >

                    <span class="menu-left">

                        <i class="ri-wallet-3-line"></i>

                        Wallet & Payments

                    </span>

                </a>


                <!-- PROMOTIONS -->

                <a
                    href="/admin/coupons"
                    class="menu-item active"
                >

                    <span class="menu-left">

                        <i class="ri-price-tag-3-line"></i>

                        Promotions

                    </span>

                </a>


                <!-- REPORTS -->

                <a
                    href="/admin/sales-report"
                    class="menu-item"
                >

                    <span class="menu-left">

                        <i class="ri-bar-chart-box-line"></i>

                        Reports

                    </span>

                </a>

            </div>

        </div>


        <!-- LOGOUT -->

        <div class="logout-section">

            <a
                href="/admin/logout"
                class="logout-btn"
            >

                <i class="ri-logout-box-r-line"></i>

                Logout

            </a>

        </div>

    </aside>



    <!-- ================= MAIN CONTENT ================= -->

    <main class="main-content">


        <!-- TOPBAR -->

        <header class="topbar">

            <div>

                <p class="breadcrumb">

                    Admin
                    /
                    Promotions
                    /
                    Coupons

                </p>

            </div>


            <div class="top-right">

                <i
                    class="ri-notification-3-line notification"
                ></i>


                <div class="admin-profile">

                    <div class="admin-avatar">
                        AD
                    </div>

                    <div>

                        <h4>Admin User</h4>

                        <span>Super Admin</span>

                    </div>

                </div>

            </div>

        </header>



        <!-- ================= PAGE HEADER ================= -->

        <section class="page-header">

            <div>

                <h1>
                    Active Coupons
                </h1>

                <p>
                    Manage discounts and promotional offers
                </p>

            </div>


            <a
                href="/admin/coupons/add"
                class="create-btn"
            >

                <i class="ri-add-line"></i>

                Create Coupon

            </a>

        </section>



        <!-- ================= COUPON TABLE ================= -->

        <section class="coupon-card">

            <div class="table-responsive">

                <table>

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Offer Name</th>

                            <th>Code</th>

                            <th>Type</th>

                            <th>Target</th>

                            <th>Discount</th>

                            <th>Valid Period</th>

                            <th>Status</th>

                            <th>Actions</th>

                        </tr>

                    </thead>


                    <tbody>

                        <% if (coupons && coupons.length > 0) { %>

                            <% coupons.forEach((coupon, index) => { %>

                                <tr>

                                    <!-- ID -->

                                    <td>
                                        <%= index + 1 %>
                                    </td>


                                    <!-- OFFER NAME -->

                                    <td>

                                        <div class="offer-name">

                                            <strong>
                                                <%= coupon.description %>
                                            </strong>

                                        </div>

                                    </td>


                                    <!-- CODE -->

                                    <td>

                                        <span class="coupon-code">

                                            <%= coupon.discountCode %>

                                        </span>

                                    </td>


                                    <!-- TYPE -->

                                    <td>

                                        <span class="type-text">

                                            <%= coupon.discountType === "percentage"
                                                ? "Percentage"
                                                : "Flat" %>

                                        </span>

                                    </td>


                                    <!-- TARGET -->

                                    <td>

                                        <%= coupon.applyTo === "cart_total"
                                            ? "All Products"
                                            : "Each Product" %>

                                    </td>


                                    <!-- DISCOUNT -->

                                    <td>

                                        <% if (coupon.discountType === "percentage") { %>

                                            <strong>
                                                <%= coupon.discountValue %>%
                                            </strong>

                                        <% } else { %>

                                            <strong>
                                                ₹<%= coupon.discountValue %>
                                            </strong>

                                        <% } %>

                                    </td>


                                    <!-- VALID PERIOD -->

                                    <td>

                                        <div class="valid-period">

                                            <%= new Date(coupon.validFrom)
                                                .toISOString()
                                                .split("T")[0] %>

                                            <span>to</span>

                                            <%= new Date(coupon.validTo)
                                                .toISOString()
                                                .split("T")[0] %>

                                        </div>

                                    </td>


                                    <!-- STATUS -->

                                    <td>
                                        <div class="status-wrapper">

                                            <form
                                                action="/admin/coupons/toggle/<%= coupon._id %>?_method=PATCH"
                                                method="POST"
                                            >
                                                <button
                                                    type="submit"
                                                    class="status-toggle <%= coupon.isActive ? 'active' : '' %>"
                                                >
                                                    <span class="toggle-circle"></span>
                                                </button>
                                            </form>

                                            <span class="status-text <%= coupon.isActive ? 'active-text' : 'inactive-text' %>">
                                                <%= coupon.isActive ? "Active" : "Inactive" %>
                                            </span>

                                        </div>
                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="action-buttons">

                                            <a
                                                href="/admin/coupons/edit/<%= coupon._id %>"
                                                class="edit-btn"
                                            >

                                                <i class="ri-pencil-line"></i>

                                            </a>


                                                <form
                                                    action="/admin/coupons/delete/<%= coupon._id %>"
                                                    method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this coupon?')"
                                                >

                                                    <button type="submit" class="delete-btn">

                                                        <i class="ri-delete-bin-line"></i>

                                                    </button>

                                                </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td
                                    colspan="9"
                                    class="empty-row"
                                >

                                    No coupons found.

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </section>



        <!-- ================= ACTIVE OFFERS ================= -->

        <section class="offers-section">

            <div class="offers-table-container">
                <div class="offers-table-header">
                    <div>
                        <h2>Product & Category Offers</h2>
                        <p>Manage your offers, discounts, and validity periods.</p>
                    </div>
                    <a href="/admin/add-offer" class="add-offer-btn">
                        <i class="ri-add-line"></i> Add New Offer
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="offers-table">
                        <thead>
                            <tr>
                                <th>Offer Details</th>
                                <th>Type</th>
                                <th>Target</th>
                                <th>Discount</th>
                                <th>Validity</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (offers && offers.length > 0) { %>
                                <% offers.forEach(offer => { %>
                                    <tr>
                                        <td>
                                            <div class="offer-title">
                                                <strong><%= offer.title %></strong>
                                                <small>
                                                    ID: <%= String(offer._id).slice(-6).toUpperCase() %>
                                                </small>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="offer-type-badge">
                                                <%= offer.offerType === "product" ? "Product" : "Category" %>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="offer-target">
                                                <% if (offer.offerType === "product") { %>
                                                    <%= offer.productId?.productName || "Product unavailable" %>
                                                <% } else { %>
                                                    <%= offer.categoryId?.name || "Category unavailable" %>
                                                <% } %>
                                            </span>
                                        </td>

                                        <td>
                                            <span class="discount-badge">
                                                <%= offer.discountPercentage %>% OFF
                                            </span>
                                        </td>

                                        <td>
                                            <div class="validity-info">
                                                <span>
                                                    <%= new Date(offer.validFrom).toLocaleDateString("en-IN") %>
                                                </span>
                                                <small>to</small>
                                                <span>
                                                    <%= new Date(offer.validTo).toLocaleDateString("en-IN") %>
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="status-badge <%= offer.isActive ? 'active' : 'inactive' %>">
                                                <span class="status-dot"></span>
                                                <%= offer.isActive ? "Active" : "Inactive" %>
                                            </span>
                                        </td>

                                        <td>
                                            <div class="offer-actions">
                                                <a
                                                    href="/admin/edit-offer/<%= offer._id %>"
                                                    class="action-btn edit-btn"
                                                    title="Edit offer"
                                                >
                                                    <i class="ri-pencil-line"></i>
                                                </a>

                                                <form
                                                    action="/admin/offers/toggle/<%= offer._id %>?_method=PATCH"
                                                    method="POST"
                                                    class="toggle-offer-form"
                                                >
                                                    <button type="submit" class="action-btn toggle-btn">
                                                        <i class="ri-refresh-line"></i>
                                                    </button>
                                                </form>

                                                <form
                                                    action="/admin/offers/delete/<%= offer._id %>?_method=DELETE"
                                                    method="POST"
                                                    class="delete-offer-form"
                                                >
                                                    <button type="submit" class="action-btn delete-btn">
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                </form>

                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="empty-offers">
                                        <i class="ri-coupon-3-line"></i>
                                        <strong>No offers found</strong>
                                        <span>Create your first product or category offer.</span>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </section>


    </main>

</div>



<!-- ================= JAVASCRIPT ================= -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.querySelectorAll(".toggle-offer-form").forEach(form => {
    form.addEventListener("submit", function (event) {
        event.preventDefault();

        const offerForm = this;

        Swal.fire({
            title: "Change Offer Status?",
            text: "Do you want to change this offer's status?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#2563eb",
            cancelButtonColor: "#6b7280",
            confirmButtonText: "Yes, change it",
            cancelButtonText: "Cancel"
        }).then(result => {
            if (result.isConfirmed) {
                offerForm.submit();
            }
        });
    });
});
</script>

<script>
document.querySelectorAll(".delete-offer-form").forEach(form => {
    form.addEventListener("submit", function (event) {
        event.preventDefault();

        const deleteForm = this;

        Swal.fire({
            title: "Delete this offer?",
            text: "This action cannot be undone.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc2626",
            cancelButtonColor: "#6b7280",
            confirmButtonText: "Yes, delete",
            cancelButtonText: "Cancel"
        }).then(result => {
            if (result.isConfirmed) {
                deleteForm.submit();
            }
        });
    });
});
</script>

<script>

const dropdowns =
    document.querySelectorAll(".dropdown-btn");


dropdowns.forEach(btn => {

    btn.addEventListener("click", () => {

        const wrapper =
            btn.parentElement;

        const menu =
            wrapper.querySelector(".dropdown-menu");

        wrapper.classList.toggle("active");

        menu.classList.toggle("show");

    });

});

</script>


</body>

</html>