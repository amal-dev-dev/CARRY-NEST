<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Add Product - Carry Nest</title>

    <link rel="stylesheet" href="/Styles/admin/add-product.css">

    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"/>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div>

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-box">
                    C
                </div>

                <h2>CARRY NEST</h2>

            </div>

            <!-- MENU -->

            <div class="menu-wrapper">

                <!-- DASHBOARD -->

                <a href="/admin/dashboard" class="menu-item">

                <span class="menu-left">

                <i class="ri-dashboard-line"></i>

                <span class="menu-text">Dashboard</span>
                
                </span>

                </a>

                <!-- PRODUCTS -->

                <div class="dropdown-wrapper active">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-bag-line"></i>

                            Products

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu show">

                        <a href="/admin/products">
                            All Products
                        </a>

                        <a href="/admin/add-product"
                        class="submenu-active">

                            Add Product

                        </a>

                        <a href="/admin/category">
                            Categories
                        </a>

                        <a href="/admin/brands">
                            Brands
                        </a>

                    </div>

                </div>

                <!-- ORDERS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-cart-line"></i>

                            Orders

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">
                        
                        <a href="/admin/orders">All Orders</a>
                        <a href="/admin/orders?status=pending">Pending</a>
                        <a href="/admin/orders?status=shipped">Shipped</a>
                        <a href="/admin/orders?status=delivered">Delivered</a>


                    </div>

                </div>

                <!-- RETURNS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-arrow-go-back-line"></i>

                            Returns

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">

                        <a href="/admin/return-requests">
                            Requests
                        </a>

                    </div>

                </div>

                <!-- CUSTOMERS -->

                <a href="/admin/customers"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-group-line"></i>

                        Customers

                    </span>

                </a>

                <!-- WALLET -->

                <a href="/admin/wallet"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-wallet-3-line"></i>

                        Wallet & Payments

                    </span>

                </a>

                <!-- PROMOTIONS -->

                <a href="/admin/coupons"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-price-tag-3-line"></i>

                        Promotions

                    </span>

                </a>

                <!-- REPORTS -->

                <a href="/admin/sales-report"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-bar-chart-box-line"></i>

                        Reports

                    </span>

                </a>

            </div>

        </div>

        <!-- LOGOUT -->

        <div class="logout-section">

            <a href="/admin/logout"
            class="logout-btn">

                <i class="ri-logout-box-r-line"></i>

                Logout

            </a>

        </div>

    </aside>

    <!-- MAIN CONTENT -->

    <main class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="top-left">

                <p class="breadcrumb">

                    Admin / Products / Add Product

                </p>

            </div>

            <div class="top-right">

                <span class="notification">

                    <i class="ri-notification-3-line"></i>

                </span>

                <div class="admin-profile">

                    <div class="admin-avatar">
                        AD
                    </div>

                    <div>

                        <h4>Admin User</h4>

                        <span>Super Admin</span>

                    </div>

                </div>

            </div>

        </header>

        <!-- FORM START -->

        <form action="/admin/add-product"
              method="POST"
              enctype="multipart/form-data"
              class="product-form"
              id="productForm">

            <!-- PAGE HEADER -->

            <section class="page-header">

                <div>

                    <h1>Add New Product</h1>

                    <p>
                        Manage your product inventory
                    </p>

                </div>

                <div class="header-btns">

                    <button type="button"
                    class="cancel-btn">
                    <a href="/admin/products" style="text-decoration: none;color: #000;">
                        Cancel
                    </a>
                    </button>

                    <button type="submit"
                    class="save-btn">

                        <i class="ri-save-line"></i>

                        Save Changes

                    </button>

                </div>

            </section>

            <!-- PRODUCT DETAILS -->

            <section class="form-card">

                <div class="section-title">

                    <i class="ri-price-tag-3-line"></i>

                    <h3>Product Details</h3>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label>Product Name</label>

                        <input type="text"
                        name="productName"
                        placeholder="Product name"
                        class="productName"
                        value="<%= formData?.productName || '' %>">

                    </div>

                    <div class="form-group">
                        <label for="brand">Brand</label>

                            <select name="brand" id="brand">
                                <option value="">Select Brand</option>

                                <% if (brands && brands.length > 0) { %>
                                    <% brands.forEach((brand) => { %>
                                        <option
                                            value="<%= brand.name %>"
                                            <%= formData?.brand === brand.name ? 'selected' : '' %>
                                        >
                                            <%= brand.name %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>

                        <% if (!brands || brands.length === 0) { %>
                            <small class="error-message">
                                No active brands available. Please add a brand first.
                            </small>
                        <% } %>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label>Category</label>

                        <select name="category">
                            <% categories.forEach((cat) => { %>
                                <option
                                    value="<%= cat._id %>"
                                    <%= formData?.category === cat._id.toString() ? 'selected' : '' %>
                                >
                                    <%= cat.name %>
                                </option>
                            <% }) %>
                        </select>

                    </div>

                </div>

                <div class="form-group">

                    <label>Description</label>

                    <textarea name="description" rows="5"><%= formData?.description || '' %></textarea>

                </div>

            </section>

            <!-- PRODUCT VARIANTS -->
            <section class="form-card">

                <div class="variant-top">

                    <div class="section-title">
                        <i class="ri-layout-grid-line"></i>
                        <h3>Product Variants</h3>
                    </div>

                    <button type="button" class="variant-btn">
                        <i class="ri-add-line"></i>
                        Add Color Variant
                    </button>

                </div>

                <!-- VARIANTS CONTAINER -->
                <div id="variantsContainer">

                    <%
                        const submittedColors = Array.isArray(formData?.colors)
                            ? formData.colors
                            : formData?.colors
                                ? [formData.colors]
                                : [''];
                    %>

                    <% submittedColors.forEach((color, index) => { %>

                        <div class="variant-card">

                            <div class="variant-header">

                                <div class="color-info">

                                    <div
                                        class="color-circle"
                                        style="background-color: <%= color %>"
                                    ></div>

                                    <input
                                        type="text"
                                        name="colors[]"
                                        class="colorInput"
                                        placeholder="Enter Color"
                                        value="<%= color %>"
                                    />

                                </div>

                                <% if (index > 0) { %>

                                    <button
                                        type="button"
                                        class="removeVariant"
                                    >
                                        <i class="ri-delete-bin-line"></i>
                                        Remove
                                    </button>

                                <% } %>

                            </div>

                        </div>

                    <% }) %>

                </div>

                <%
                    const submittedSizes = Array.isArray(formData?.sizes)
                        ? formData.sizes
                        : formData?.sizes !== undefined
                            ? [formData.sizes]
                            : ['Standard', 'Professional', 'Travel'];

                    const submittedStocks = Array.isArray(formData?.stocks)
                        ? formData.stocks
                        : formData?.stocks !== undefined
                            ? [formData.stocks]
                            : [];

                    const submittedRegularPrices = Array.isArray(formData?.regularPrices)
                        ? formData.regularPrices
                        : formData?.regularPrices !== undefined
                            ? [formData.regularPrices]
                            : [];

                    const submittedSalePrices = Array.isArray(formData?.salePrices)
                        ? formData.salePrices
                        : formData?.salePrices !== undefined
                            ? [formData.salePrices]
                            : [];

                    const variantRowCount = Math.max(
                        3,
                        submittedSizes.length,
                        submittedStocks.length,
                        submittedRegularPrices.length,
                        submittedSalePrices.length
                    );
                %>

                <!-- TABLE -->
                <div class="variant-table">

                    <table>
                        <thead>
                            <tr>
                                <th>Size</th>
                                <th>Stock</th>
                                <th>Original Price</th>
                                <th>Sale Price</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% for (let i = 0; i < variantRowCount; i++) { %>

                                <tr>

                                    <td>
                                        <input
                                            type="text"
                                            name="sizes[]"
                                            value="<%= submittedSizes[i] ?? '' %>"
                                        >
                                    </td>

                                    <td>
                                        <input
                                            type="number"
                                            name="stocks[]"
                                            placeholder="Stock"
                                            value="<%= submittedStocks[i] ?? '' %>"
                                        >
                                    </td>

                                    <td>
                                        <input
                                            type="number"
                                            name="regularPrices[]"
                                            placeholder="₹ Original Price"
                                            value="<%= submittedRegularPrices[i] ?? '' %>"
                                        >
                                    </td>

                                    <td>
                                        <input
                                            type="number"
                                            name="salePrices[]"
                                            placeholder="₹ Sale Price"
                                            value="<%= submittedSalePrices[i] ?? '' %>"
                                        >
                                    </td>

                                </tr>

                            <% } %>

                        </tbody>
                        
                    </table>

                </div>

                <!-- IMAGE UPLOAD -->
                <div class="image-upload">

                    <div class="upload-box">
                        <label for="images">
                            <i class="ri-upload-cloud-line"></i>
                            <p>Upload Images</p>
                            <span>Minimum 3 Images</span>
                        </label>

                        <input
                            type="file"
                            id="images"
                            name="images"
                            multiple
                            accept="image/*"
                        >
                    </div>

                    <div id="previewContainer"></div>

                </div>

            </section>

            <!-- CROP MODAL -->
            <div id="cropModal" class="crop-modal">
                <div class="crop-content">
                    <img id="cropImage" alt="Crop Preview">

                    <div class="crop-buttons">
                        <button type="button" id="cropBtn">Crop Image</button>
                        <button type="button" id="closeCropBtn" class="close-crop-btn">Cancel</button>
                    </div>
                </div>
            </div>
        </form>

        <!-- FORM END -->

    </main>

</div>

<script>

const dropdowns = document.querySelectorAll(".dropdown-btn");

dropdowns.forEach((dropdown)=>{

    dropdown.addEventListener("click",()=>{

        const menu = dropdown.nextElementSibling;

        if(menu){
            menu.classList.toggle("show");
        }

    });

});

const imageInput = document.getElementById("images");
const previewContainer = document.getElementById("previewContainer");
const productForm = document.getElementById("productForm");

let cropper;
let selectedFiles = [];
let croppedFiles = [];
let currentIndex = 0;

// Color Picker

document.addEventListener("input", (e) => {

    if(e.target.classList.contains("colorInput")){

        const circle =
        e.target
        .closest(".color-info")
        .querySelector(".color-circle");

        circle.style.backgroundColor = e.target.value;

    }

});

//color variants

const variantBtn = document.querySelector(".variant-btn");
const variantsContainer = document.getElementById("variantsContainer");

variantBtn.addEventListener("click", () => {

    const variantCard = document.createElement("div");

    variantCard.classList.add("variant-card");

    variantCard.innerHTML = `

        <div class="variant-header">

            <div class="color-info">

                <div class="color-circle"></div>

                <input
                    type="text"
                    name="colors[]"
                    class="colorInput"
                    placeholder="Enter Color"
                />

            </div>

            <button
                type="button"
                class="removeVariant">

                <i class="ri-delete-bin-line"></i>

                Remove

            </button>

        </div>

    `;

    variantsContainer.appendChild(variantCard);

});

document.addEventListener("click", (e) => {

    const removeBtn = e.target.closest(".removeVariant");

    if(removeBtn){

        const allVariants =
        document.querySelectorAll(".variant-card");

        if(allVariants.length > 1){

            removeBtn
            .closest(".variant-card")
            .remove();

        }

    }

});


// Image Selection
imageInput.addEventListener("change", (e) => {

    selectedFiles = Array.from(e.target.files);

    if(selectedFiles.length === 0) return;

    croppedFiles = [];
    currentIndex = 0;

    previewContainer.innerHTML = "";

    showCropper(currentIndex);

});

// Show Cropper
function showCropper(index){

    const file = selectedFiles[index];

    const reader = new FileReader();

    reader.onload = function(event){

        const cropModal = document.getElementById("cropModal");
        const cropImage = document.getElementById("cropImage");

        cropModal.style.display = "flex";

        cropImage.src = event.target.result;

        if(cropper){
            cropper.destroy();
        }

       cropper = new Cropper(cropImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            responsive: true,
            background: false
        });

    };

    reader.readAsDataURL(file);

}

// Crop Button
document.getElementById("cropBtn")
.addEventListener("click", () => {

    if(!cropper) return;

    const canvas = cropper.getCroppedCanvas({
        width: 500,
        height: 500
    });

    canvas.toBlob((blob) => {

        const croppedFile = new File(
            [blob],
            selectedFiles[currentIndex].name,
            {
                type: "image/jpeg"
            }
        );

        croppedFiles.push(croppedFile);

        const img = document.createElement("img");

        img.src = URL.createObjectURL(blob);

        img.classList.add("preview-image");

        previewContainer.appendChild(img);

        cropper.destroy();

        currentIndex++;

        // Next image
        if(currentIndex < selectedFiles.length){

            showCropper(currentIndex);

        }else{

            document.getElementById("cropModal")
            .style.display = "none";

            const dt = new DataTransfer();

            croppedFiles.forEach(file => {
                dt.items.add(file);
            });

            imageInput.files = dt.files;

        }

    }, "image/jpeg");

});

document.getElementById("closeCropBtn").addEventListener("click", () => {
    const cropModal = document.getElementById("cropModal");
    cropModal.style.display = "none";

    if (cropper) {
        cropper.destroy();
        cropper = null;
    }

    imageInput.value = "";
    selectedFiles = [];
    croppedFiles = [];
    currentIndex = 0;
});


</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if(typeof message !== "undefined" && message){ %>

<script>

Swal.fire({
    icon: "error",
    title: "Validation Error",
    text: "<%= message %>"
});

</script>

<% } %>


<script>
    const brandSelect = document.getElementById("brand");

    brandSelect.addEventListener("invalid", function () {
        if (!this.value) {
            this.setCustomValidity("Please select a valid active brand.");
        }
    });

    brandSelect.addEventListener("change", function () {
        this.setCustomValidity("");
    });
</script>

</body>
</html>