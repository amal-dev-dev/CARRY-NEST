<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Edit Product - Carry Nest</title>

    <link rel="stylesheet" href="/Styles/admin/add-product.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.css">
    <script src="https://unpkg.com/cropperjs@1.6.2/dist/cropper.min.js"></script>
</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div>

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-box">
                    C
                </div>

                <h2>CARRY NEST</h2>

            </div>

            <!-- MENU -->

            <div class="menu-wrapper">

                <!-- DASHBOARD -->

                <a href="/admin/dashboard" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-dashboard-line"></i>

                        Dashboard

                    </span>

                </a>

                <!-- PRODUCTS -->

                <div class="dropdown-wrapper active">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-bag-line"></i>

                            Products

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu show">

                        <a href="/admin/products" class="submenu-active">
                            All Products
                        </a>

                        <a href="/admin/add-product">

                            Add Product

                        </a>

                        <a href="/admin/category">
                            Categories
                        </a>

                        <a href="#">
                            Brands
                        </a>

                    </div>

                </div>

                <!-- ORDERS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-cart-line"></i>

                            Orders

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                </div>

                <!-- RETURNS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-arrow-go-back-line"></i>

                            Returns

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                </div>

                <!-- CUSTOMERS -->

                <a href="/admin/customers"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-group-line"></i>

                        Customers

                    </span>

                </a>

                <!-- WALLET -->

                <a href="#"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-wallet-3-line"></i>

                        Wallet & Payments

                    </span>

                </a>

                <!-- PROMOTIONS -->

                <a href="#"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-price-tag-3-line"></i>

                        Promotions

                    </span>

                </a>

                <!-- REPORTS -->

                <a href="#"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-bar-chart-box-line"></i>

                        Reports

                    </span>

                </a>

            </div>

        </div>

        <!-- LOGOUT -->

        <div class="logout-section">

            <a href="/admin/logout"
            class="logout-btn">

                <i class="ri-logout-box-r-line"></i>

                Logout

            </a>

        </div>

    </aside>

    <!-- MAIN CONTENT -->

    <main class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="top-left">

                <p class="breadcrumb">

                    Admin / Products / Edit Product

                </p>

            </div>

            <div class="top-right">

                <input type="text"
                placeholder="Search..."
                class="top-search">

                <span class="notification">

                    <i class="ri-notification-3-line"></i>

                </span>

                <div class="admin-profile">

                    <div class="admin-avatar">
                        AD
                    </div>

                    <div>

                        <h4>Admin User</h4>

                        <span>Super Admin</span>

                    </div>

                </div>

            </div>

        </header>

        <!-- FORM START -->

        <form action="/admin/products/<%= product._id %>?_method=PATCH"
        method="POST"
        enctype="multipart/form-data">

            <!-- PAGE HEADER -->

            <section class="page-header">

                <div>

                    <h1>Update Product</h1>

                    <p>
                        Manage your product inventory
                    </p>

                </div>

                <div class="header-btns">

                    <button type="button"
                    class="cancel-btn">
                    <a href="/admin/products" style="text-decoration: none;color: #000;">
                        Cancel
                    </a>
                    </button>

                    <button type="submit"
                    class="save-btn">

                        <i class="ri-save-line"></i>

                        Update Changes

                    </button>

                </div>

            </section>

            <!-- PRODUCT DETAILS -->

            <section class="form-card">

                <div class="section-title">

                    <i class="ri-price-tag-3-line"></i>

                    <h3>Product Details</h3>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label>Product Name</label>

                        <input
                        type="text"
                        name="productName"
                        value="<%= product.productName %>">

                    </div>

                    <div class="form-group">

                        <label>Brand</label>

                        <select name="brand">

                            <option
                                value="American Tourister"
                                <%= product.brand === "American Tourister" ? "selected" : "" %>>
                                American Tourister
                            </option>

                            <option
                                value="Safari"
                                <%= product.brand === "Safari" ? "selected" : "" %>>
                                Safari
                            </option>

                        </select>

                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label>Category</label>

                            <select name="category">

                                <% categories.forEach(cat => { %>

                                    <option
                                        value="<%= cat._id %>"
                                        <%= product.category.toString() === cat._id.toString()
                                            ? "selected"
                                            : "" %>>

                                        <%= cat.name %>

                                    </option>

                                <% }) %>

                            </select>

                    </div>

                    <div class="form-group">

                        <label>Offer</label>

                        <select name="offer">

                            <option>10% OFF</option>

                            <option>20% OFF</option>

                        </select>

                    </div>

                </div>

                <div class="form-group">

                    <label>Description</label>

                    <textarea name="description"><%= product.description %></textarea>

                </div>

            </section>

                <!-- PRODUCT VARIANTS -->

                <section class="form-card">

                    <div class="variant-top">

                        <div class="section-title">

                            <i class="ri-layout-grid-line"></i>

                            <h3>Product Variants</h3>

                        </div>

                        <button type="button"
                        class="variant-btn">

                            <i class="ri-add-line"></i>

                            Add Color Variant

                        </button>

                    </div>

                        <div id="variantsContainer">

                            <div class="variant-card">

                                <div class="variant-header">

                                    <div class="color-info">

                                        <div class="color-circle"></div>

                                        <input
                                            type="text"
                                            name="colors[]"
                                            class="colorInput"
                                            value="<%= product.colors[0] %>"
                                        />

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- TABLE -->

                        <div class="variant-table">

                            <table>

                                <thead>

                                    <tr>

                                        <th>Size</th>
                                        <th>Stock</th>
                                        <th>Original Price</th>
                                        <th>Sale Price</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    <%
                                    const standard = product.variants.find(v => v.size === "Standard");
                                    const professional = product.variants.find(v => v.size === "Professional");
                                    const travel = product.variants.find(v => v.size === "Travel");
                                    %>

                                    <tr>

                                        <td>

                                            <input type="text"
                                            name="size[]"
                                            value="Standard">

                                        </td>

                                        <td>

                                            <input
                                                type="number"
                                                name="stock[]"
                                                value="<%= standard?.stock || '' %>">

                                        </td>

                                        <td>

                                            <input
                                            type="number"
                                            name="regularPrice[]"
                                            value="<%= standard?.regularPrice || '' %>">


                                        </td>

                                        <td>

                                            <input
                                                type="number"
                                                name="salePrice[]"
                                                value="<%= standard?.salePrice || '' %>">

                                        </td>

                                    </tr>

                                    <tr>

                                        <td>

                                            <input type="text"
                                            name="size[]"
                                            value="Professional">

                                        </td>

                                        <td>

                                            <input type="number"
                                            name="stock[]"
                                            value="<%= professional?.stock || '' %>">

                                        </td>

                                        <td>

                                            <input type="number"
                                            name="regularPrice[]"
                                            value="<%= professional?.regularPrice || '' %>">

                                        </td>

                                        <td>

                                            <input type="number"
                                            name="salePrice[]"
                                            value="<%= professional?.salePrice || '' %>">

                                        </td>

                                    </tr>

                                    <tr>

                                        <td>

                                            <input type="text"
                                            name="size[]"
                                            value="Travel">

                                        </td>

                                        <td>

                                            <input type="number"
                                            name="stock[]"
                                            value="<%= travel?.stock || '' %>">

                                        </td>

                                        <td>

                                            <input type="number"
                                            name="regularPrice[]"
                                            value="<%= travel?.regularPrice || '' %>">

                                        </td>

                                        <td>

                                            <input type="number"
                                            name="salePrice[]"
                                            value="<%= travel?.salePrice || '' %>">

                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                        <!-- IMAGE UPLOAD -->

                        <div class="image-upload">

                            <!-- Existing Images -->

                            <div class="existing-images">

                                <% product.productImage.forEach((image,index) => { %>

                                    <div class="image-preview">

                                        <img
                                            src="<%= image %>"
                                            alt="Product Image"
                                            style="width:80px;height:80px;object-fit:cover;border-radius:8px;">

                                        <button
                                            type="button"
                                            class="remove-image-btn"
                                            data-index="<%= index %>">

                                            ✖

                                        </button>

                                    </div>

                                <% }) %>

                            </div>

                            <input
                                type="hidden"
                                id="removedImages"
                                name="removedImages">

                            <!-- Upload New Images -->

                            <div class="upload-box">

                                <label for="images">

                                    <i class="ri-upload-cloud-line"></i>

                                    <p>Upload New Images</p>

                                    <span>Minimum 3 Images</span>

                                </label>

                                <input
                                    type="file"
                                    id="images"
                                    name="images"
                                    multiple
                                    accept="image/*">

                            </div>

                            <!-- New Selected Image Preview -->

                            <div id="previewContainer"></div>

                        </div>

                        <div id="cropModal" class="crop-modal">

                            <div class="crop-content">

                                <img id="cropImage">

                                <div class="crop-buttons">

                                    <button
                                        type="button"
                                        id="cropBtn">

                                        Crop Image

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </section>

        </form>

        <!-- FORM END -->

    </main>

</div>

<script>

const dropdowns = document.querySelectorAll(".dropdown-btn");

dropdowns.forEach((dropdown)=>{

    dropdown.addEventListener("click",()=>{

        const menu =
        dropdown.nextElementSibling;

        if(menu){

            menu.classList.toggle("show");

        }

    });

});

const variantBtn = document.querySelector(".variant-btn");
const variantsContainer = document.getElementById("variantsContainer");

variantBtn.addEventListener("click", () => {

    const variantCard = document.createElement("div");

    variantCard.classList.add("variant-card");

    variantCard.innerHTML = `

        <div class="variant-header">

            <div class="color-info">

                <div class="color-circle"></div>

                <input
                    type="text"
                    name="colors[]"
                    class="colorInput"
                    placeholder="Enter Color"
                />

            </div>

            <button
                type="button"
                class="removeVariant">

                <i class="ri-delete-bin-line"></i>

                Remove

            </button>

        </div>

    `;

    variantsContainer.appendChild(variantCard);

});

document.addEventListener("click", (e) => {

    const removeBtn = e.target.closest(".removeVariant");

    if(removeBtn){

        const allVariants =
        document.querySelectorAll(".variant-card");

        if(allVariants.length > 1){

            removeBtn
            .closest(".variant-card")
            .remove();

        }

    }

});


document.addEventListener("input", (e) => {

    if(e.target.classList.contains("colorInput")){

        const circle =
        e.target
        .closest(".color-info")
        .querySelector(".color-circle");

        circle.style.backgroundColor = e.target.value;

    }

});

let removedImages = [];

document.querySelectorAll(".remove-image-btn")
.forEach(btn=>{

    btn.addEventListener("click",()=>{

        const index = btn.dataset.index;

        removedImages.push(index);

        document.getElementById("removedImages")
        .value = removedImages.join(",");

        btn.parentElement.remove();

    });

});

const imageInput = document.getElementById("images");
const previewContainer = document.getElementById("previewContainer");

let cropper;
let croppedFiles = [];

imageInput.addEventListener("change", async (e) => {

    const files = Array.from(e.target.files);

    croppedFiles = [];

    let currentIndex = 0;

    function cropNextImage() {

        if(currentIndex >= files.length){

            const dataTransfer = new DataTransfer();

            croppedFiles.forEach(file => {

                dataTransfer.items.add(file);

            });

            imageInput.files = dataTransfer.files;

            return;

        }

        const file = files[currentIndex];

        const reader = new FileReader();

        reader.onload = function(event){

            document.getElementById( "cropModal" ).style.display = "flex";

            const cropImage = document.getElementById("cropImage" );

            cropImage.src = event.target.result;

            if(cropper){
                cropper.destroy();
            }

            cropper = new Cropper(
                cropImage,
                {
                    aspectRatio:NaN,
                    viewMode:1
                }
            );

            document.getElementById( "cropBtn" ).onclick = () => {

                const canvas = cropper.getCroppedCanvas({
                    width:800,
                    height:800
                });

                canvas.toBlob(blob => {

                    const croppedFile =  new File(
                        [blob],
                        file.name,
                        {
                            type:"image/jpeg"
                        }
                    );

                    croppedFiles.push(
                        croppedFile
                    );

                    const img = document.createElement( "img" );

                    img.src =  URL.createObjectURL(blob);

                    img.classList.add(
                        "preview-image"
                    );

                    previewContainer.appendChild(
                        img
                    );

                    cropper.destroy();

                    document.getElementById(
                        "cropModal"
                    ).style.display =
                    "none";

                    currentIndex++;

                    cropNextImage();

                },"image/jpeg");

            };
        };
        reader.readAsDataURL(file);
    }
    cropNextImage();

});


</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if(typeof message !== "undefined" && message){ %>

<script>

Swal.fire({
    icon: "error",
    title: "Validation Error",
    text: "<%= message %>"
});

</script>

<% } %>

</body>
</html>