<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
    content="width=device-width, initial-scale=1.0">

    <title>Products - Carry Nest</title>

    <link rel="stylesheet"
    href="/Styles/admin/products.css">

    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet">

</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div>

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-box">
                    C
                </div>

                <h2>CARRY NEST</h2>

            </div>

            <!-- MENU -->

            <div class="menu-wrapper">

                <a href="/admin/dashboard"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-dashboard-line"></i>

                        Dashboard

                    </span>

                </a>

                <!-- PRODUCTS -->

                <div class="menu-dropdown">

                    <div class="menu-item active dropdown-toggle">

                        <span class="menu-left">

                            <i class="ri-shopping-bag-line"></i>

                            Products

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-icon"></i>

                    </div>

                    <div class="submenu show">

                        <a href="#" class="active-submenu">
                            All Products
                        </a>

                        <a href="/admin/add-product">
                            Add Product
                        </a>

                        <a href="/admin/category">
                            Categories
                        </a>

                        <a href="#">
                            Brands
                        </a>

                    </div>

                </div>

                <!-- ORDERS -->

                <div class="menu-dropdown">

                    <div class="menu-item dropdown-toggle">

                        <span class="menu-left">

                            <i class="ri-shopping-cart-line"></i>

                            Orders

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-icon"></i>

                    </div>

                    <div class="submenu">

                        <a href="#">All Orders</a>

                        <a href="#">Pending</a>

                    </div>

                </div>

                <!-- RETURNS -->

                <div class="menu-dropdown">

                    <div class="menu-item dropdown-toggle">

                        <span class="menu-left">

                            <i class="ri-arrow-go-back-line"></i>

                            Returns

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-icon"></i>

                    </div>

                    <div class="submenu">

                        <a href="#">Requests</a>

                        <a href="#">Refunds</a>

                    </div>

                </div>

                <a href="/admin/customers"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-group-line"></i>

                        Customers

                    </span>

                </a>

                <a href="#"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-wallet-3-line"></i>

                        Wallet & Payments

                    </span>

                </a>

                <a href="#"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-price-tag-3-line"></i>

                        Promotions

                    </span>

                </a>

                <a href="#"
                class="menu-item">

                    <span class="menu-left">

                        <i class="ri-bar-chart-box-line"></i>

                        Reports

                    </span>

                </a>

            </div>

        </div>

        <!-- LOGOUT -->

        <div class="logout-section">

            <a href="#"
            class="logout-btn">

                <i class="ri-logout-box-r-line"></i>

                Logout

            </a>

        </div>

    </aside>

    <!-- MAIN CONTENT -->

    <main class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="top-left">

                <p class="breadcrumb">

                    Admin / Products

                </p>

            </div>

            <div class="top-right">

                <span class="notification">

                    <i class="ri-notification-3-line"></i>

                </span>

                <div class="admin-profile">

                    <div class="admin-avatar">
                        AD
                    </div>

                    <div>

                        <h4>Admin User</h4>

                        <span>Super Admin</span>

                    </div>

                </div>

            </div>

        </header>

        <!-- PAGE HEADER -->

        <section class="page-header">

            <div>

                <h1>Products</h1>

                <p>

                    Manage your product catalog and inventory.

                </p>

            </div>

            <div class="header-actions">

                <button class="import-btn">

                    <i class="ri-upload-line"></i>

                    Import

                </button>

                <button class="add-product-btn">

                    <a href="/admin/add-product" style="text-decoration: none; color:white;"><i class="ri-add-line"></i>

                    Add Product

                    </a>
                </button>

            </div>

        </section>

        <!-- STATS -->

        <section class="stats-grid">

            <div class="stats-card">

                <p>Total Products</p>

                <h2><%= totalProductsCount %></h2>

            </div>

            <div class="stats-card">

                <p>Low Stock</p>

                <h2 class="orange-text"><%= lowStockCount %></h2>

            </div>

            <div class="stats-card">

                <p>Out of Stock</p>

                <h2 class="red-text"><%= outOfStockCount %></h2>

            </div>

        </section>

        <!-- TABLE CARD -->

        <section class="table-card">

            <!-- TABLE TOP -->

            <div class="table-top">

                <h3>All Products</h3>

                <div class="table-actions">

                    <form action="/admin/products" method="GET" class="search-form">

                        <input
                            type="text"
                            name="search"
                            value="<%= search %>"
                            placeholder="Search product..."
                            class="table-search">

                        <button type="submit" class="filter-btn">
                            <i class="ri-search-line"></i>
                        </button>

                    </form>

                        <a href="/admin/products"
                        class="clear-search-btn">

                            Clear

                        </a>

                </div>

            </div>

            <!-- TABLE -->

            <div class="table-responsive">

                <table>

                    <thead>

                        <tr>

                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Visibility</th>
                            <th>Actions</th>

                        </tr>

                    </thead>

                        <tbody>

                            <% products.forEach((product)=>{ %>

                            <tr>

                                <td>

                                    <div class="product-info">

                                        <div class="product-image">

                                            <img
                                                src="<%= product.productImage[0] %>"
                                                alt="<%= product.productName %>"
                                            >

                                        </div>

                                        <div>

                                            <h4><%= product.productName %></h4>

                                            <span><%= product.brand %></span>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <%= product.category?.name %>
                                </td>

                                <td>
                                    ₹<%= product.variants[0]?.salePrice || 0 %>
                                </td>

                                <td>
                                    <%= product.variants[0]?.stock || 0 %>
                                </td>

                                <td>

                                    <% const totalStock = product.variants.reduce(
                                        (total, variant) => total + variant.stock,
                                        0
                                    );
                                    %>

                                    <% if(totalStock > 0){ %>

                                        <span class="status active">
                                            Active
                                        </span>

                                    <% } else { %>

                                        <span class="status out">
                                            Out of Stock
                                        </span>

                                    <% } %>

                                </td>

                                <!-- Visibility -->

                                    <td>

                                        <% if(product.isBlocked){ %>

                                            <span class="status out">
                                                Hidden
                                            </span>

                                        <% } else { %>

                                            <span class="status active">
                                                Visible
                                            </span>

                                        <% } %>

                                    </td>

                                    <!-- Actions -->

                                    <td class="action-buttons">

                                        <a href="/admin/edit-product/<%= product._id %>"
                                        class="edit-btn">

                                            <i class="ri-pencil-line"></i>

                                        </a>

                                        <% if(product.isBlocked){ %>

                                        <form action="/admin/products/<%= product._id %>/unblock?_method=PATCH"
                                            method="POST"
                                            style="display:inline;">
                                            <button type="submit" style="border:none;background:none;cursor:pointer;">
                                                <i class="ri-eye-line"></i>
                                            </button>
                                        </form>

                                        <% } else { %>

                                        <form action="/admin/products/<%= product._id %>/block?_method=PATCH"
                                            method="POST"
                                            style="display:inline;">
                                            <button type="submit" style="border:none;background:none;cursor:pointer;">
                                                <i class="ri-eye-off-line"></i>
                                            </button>
                                        </form>

                                        <% } %>
                                    </td>
                            </tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>

            <!-- PAGINATION -->

    <div class="pagination">

        <span>
            Page <%= currentPage %> of <%= totalPages %>
        </span>

        <div class="pagination-actions">

            <% if(currentPage > 1){ %>
                <a href="/admin/products?page=<%= currentPage - 1 %>&search=<%= search %>">
                    <button>
                        <i class="ri-arrow-left-s-line"></i>
                    </button>
                </a>
            <% } %>

            <% for(let i = 1; i <= totalPages; i++){ %>
                <a href="/admin/products?page=<%= i %>&search=<%= search %>">
                    <button class="<%= currentPage === i ? 'active' : '' %>">
                        <%= i %>
                    </button>
                </a>
            <% } %>

            <% if(currentPage < totalPages){ %>
                <a href="/admin/products?page=<%= currentPage + 1 %>&search=<%= search %>">
                    <button>
                        <i class="ri-arrow-right-s-line"></i>
                    </button>
                </a>
            <% } %>

        </div>

    </div>

        </section>

    </main>

</div>

<script>

const dropdowns =
document.querySelectorAll(".dropdown-toggle");

dropdowns.forEach((dropdown)=>{

    dropdown.addEventListener("click",()=>{

        const submenu =
        dropdown.nextElementSibling;

        submenu.classList.toggle("show");

    });

});

</script>

</body>
</html>