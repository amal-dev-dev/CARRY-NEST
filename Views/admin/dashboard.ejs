
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Carry Nest Admin Dashboard</title>

    <link rel="stylesheet" href="/Styles/admin/dashboard.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div>

            <div class="logo-section">
                <div class="logo-box">C</div>
                <h2>CARRY NEST</h2>
            </div>

            <div class="menu-wrapper">

                <a href="/admin/dashboard" class="menu-item active">
                    <span class="menu-left">
                        <i class="ri-dashboard-line"></i>
                        Dashboard
                    </span>
                </a>

                <!-- PRODUCTS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-shopping-bag-line"></i>
                            Products
                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/products">All Products</a>
                        <a href="/admin/add-product">Add Product</a>
                        <a href="/admin/category">Categories</a>
                        <a href="/admin/brands">Brands</a>
                    </div>

                </div>

                <!-- ORDERS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-shopping-cart-line"></i>
                            Orders
                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/orders">All Orders</a>
                        <a href="/admin/orders?status=pending">Pending</a>
                        <a href="/admin/orders?status=shipped">Shipped</a>
                        <a href="/admin/orders?status=delivered">Delivered</a>
                    </div>

                </div>

                <!-- RETURNS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-arrow-go-back-line"></i>
                            Returns
                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/return-requests">Requests</a>
                    </div>

                </div>

                <a href="/admin/customers" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-group-line"></i>
                        Customers
                    </span>
                </a>

                <a href="/admin/wallet" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-wallet-3-line"></i>
                        Wallet & Payments
                    </span>
                </a>

                <a href="/admin/coupons" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-price-tag-3-line"></i>
                        Promotions
                    </span>
                </a>

                <a href="/admin/sales-report" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-bar-chart-box-line"></i>
                        Reports
                    </span>
                </a>

            </div>

        </div>

        <div class="logout-section">
            <a href="/admin/logout" class="logout-btn">
                <i class="ri-logout-box-r-line"></i>
                Logout
            </a>
        </div>

    </aside>

    <!-- MAIN CONTENT -->

    <main class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <div>
                <p class="breadcrumb">Admin / Dashboard</p>
            </div>

            <div class="top-right">

                <div class="admin-profile">
                    <div class="admin-avatar">AD</div>

                    <div>
                        <h4>Admin User</h4>
                        <span>Super Admin</span>
                    </div>
                </div>

            </div>

        </header>

        <!-- DASHBOARD HEADER -->

        <section class="dashboard-header">

            <div>
                <h1>Dashboard Overview</h1>

                <p>
                    Welcome back, here's what's happening with Carry Nest.
                </p>
            </div>

            <div class="dashboard-actions">

                <button class="light-btn"
                    onclick="window.location.href='/admin/sales-report'">
                    View Sales Report
                </button>

                <button class="dark-btn"
                    onclick="window.location.href='/admin/add-product'">
                    + Add Product
                </button>

            </div>

        </section>

        <!-- STATISTICS -->

        <section class="stats-grid">

            <div class="stats-card">

                <div class="stats-top">
                    <span>Total Revenue</span>
                    <i class="ri-money-dollar-circle-line"></i>
                </div>

                <h2>
                    ₹<%= Number(totalRevenue || 0).toLocaleString("en-IN") %>
                </h2>

                <p class="growth">
                    Overall revenue
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">
                    <span>Total Orders</span>
                    <i class="ri-shopping-bag-line"></i>
                </div>

                <h2><%= Number(totalOrders || 0).toLocaleString("en-IN") %></h2>

                <p class="growth">
                    All orders
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">
                    <span>Active Customers</span>
                    <i class="ri-group-line"></i>
                </div>

                <h2>
                    <%= Number(activeCustomers || 0).toLocaleString("en-IN") %>
                </h2>

                <p class="growth">
                    Registered customers
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">
                    <span>Total Products</span>
                    <i class="ri-shopping-bag-3-line"></i>
                </div>

                <h2>
                    <%= typeof totalProducts !== "undefined"
                        ? Number(totalProducts || 0).toLocaleString("en-IN")
                        : "0" %>
                </h2>

                <p class="growth">
                    Products in inventory
                </p>

            </div>

        </section>

        <!-- SALES AND ORDER ANALYTICS -->

        <section class="analytics-grid">

            <!-- REVENUE CHART -->

            <div class="analytics-card">

                <div class="analytics-header">

                    <h3>Sales Overview</h3>

                    <form action="/admin/dashboard"
                        method="GET"
                        id="dashboardFilterForm"
                        style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">

                        <select name="period" id="dashboardPeriod">

                            <option value="7" <%= period === "7" ? "selected" : "" %>>
                                Last 7 Days
                            </option>

                            <option value="30" <%= period === "30" ? "selected" : "" %>>
                                Last 30 Days
                            </option>

                            <option value="90" <%= period === "90" ? "selected" : "" %>>
                                Last 90 Days
                            </option>

                            <option value="365" <%= period === "365" ? "selected" : "" %>>
                                Current Year
                            </option>

                            <option value="custom" <%= period === "custom" ? "selected" : "" %>>
                                Custom Date
                            </option>

                        </select>

                        <input
                            type="date"
                            name="startDate"
                            id="dashboardStartDate"
                            value="<%= startDateInput || '' %>"
                            style="display:none;"
                        >

                        <input
                            type="date"
                            name="endDate"
                            id="dashboardEndDate"
                            value="<%= endDateInput || '' %>"
                            style="display:none;"
                        >

                        <button type="submit"
                                id="applyDashboardFilter"
                                style="display:none;">
                            Apply
                        </button>

                    </form>

                </div>

                <div class="chart-container">

                    <canvas id="revenueChart"></canvas>

                </div>

                <div id="revenueEmpty" class="empty-analytics"
                    style="display:none;">
                    No sales data available.
                </div>

            </div>

            <!-- ORDER STATUS -->

            <div class="analytics-card">

                <div class="analytics-header">
                    <h3>Order Status Overview</h3>
                </div>

                <div class="status-chart-container">
                    <canvas id="statusChart"></canvas>
                </div>

                <div id="statusEmpty" class="empty-analytics"
                    style="display:none;">
                    No order status data available.
                </div>

                <div id="statusLegend" class="status-legend"></div>

            </div>

        </section>

        <!-- BEST SELLING PRODUCTS -->

        <section class="products-card">

            <div class="products-header">

                <h3>Best-Selling Products</h3>

                <a href="/admin/sales-report">
                    View Sales Report →
                </a>

            </div>

            <div class="table-responsive">

                <table class="products-table">

                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Product</th>
                            <th>Orders</th>
                            <th>Units Sold</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (typeof topProducts !== "undefined" &&
                            topProducts && topProducts.length) { %>

                            <% topProducts.slice(0, 5).forEach((product, index) => { %>

                                <tr>

                                    <td class="product-rank">
                                        #<%= index + 1 %>
                                    </td>

                                    <td>
                                        <%= product.productName || "Unknown Product" %>
                                    </td>

                                    <td>
                                        <%= Number(product.orders || 0)
                                            .toLocaleString("en-IN") %>
                                    </td>

                                    <td>
                                        <%= Number(product.units || 0)
                                            .toLocaleString("en-IN") %>
                                    </td>

                                    <td>
                                        ₹<%= Number(product.revenue || 0)
                                            .toLocaleString("en-IN") %>
                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>
                                <td colspan="5" class="empty-analytics">
                                    No best-selling product data available.
                                </td>
                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </section>

        <!-- ACTION REQUIRED AND RETURNS -->

        <section class="middle-grid dashboard-section">

            <!-- ACTION REQUIRED -->

            <div class="action-card">

                <h3>Action Required</h3>

                <a href="/admin/orders?status=pending"
                    class="action-item">

                    <div class="action-left">

                        <div class="action-icon blue">
                            <i class="ri-shopping-cart-line"></i>
                        </div>

                        <span>Pending Orders</span>

                    </div>

                    <div class="action-right">
                        <span><%= pendingOrders || 0 %></span>
                        <i class="ri-arrow-right-line"></i>
                    </div>

                </a>

                <a href="/admin/return-requests"
                    class="action-item">

                    <div class="action-left">

                        <div class="action-icon orange">
                            <i class="ri-arrow-go-back-line"></i>
                        </div>

                        <span>Return Requests</span>

                    </div>

                    <div class="action-right">
                        <span><%= returnRequests || 0 %></span>
                        <i class="ri-arrow-right-line"></i>
                    </div>

                </a>

                <a href="/admin/products"
                    class="action-item">

                    <div class="action-left">

                        <div class="action-icon red">
                            <i class="ri-alert-line"></i>
                        </div>

                        <span>Low Stock Products</span>

                    </div>

                    <div class="action-right">
                        <span>
                            <%= lowStockProducts
                                ? lowStockProducts.length
                                : 0 %>
                        </span>

                        <i class="ri-arrow-right-line"></i>
                    </div>

                </a>

            </div>

            <!-- RETURN SNAPSHOT -->

            <div class="returns-card">

                <h3>Returns Snapshot</h3>

                <div class="returns-grid">

                    <div class="mini-card">
                        <span>Pending Requests</span>
                        <h2><%= returnRequests || 0 %></h2>
                    </div>

                    <div class="mini-card">
                        <span>Refunds Pending</span>
                        <h2><%= refundPending || 0 %></h2>
                    </div>

                </div>

                <a href="/admin/return-requests">
                    <button class="process-btn">
                        <i class="ri-refresh-line"></i>
                        Process Returns
                    </button>
                </a>

            </div>

        </section>

        <!-- RECENT ORDERS AND STOCK ALERTS -->

        <section class="bottom-grid">

            <!-- RECENT ORDERS -->

            <div class="recent-orders">

                <div class="section-top">

                    <h3>Recent Orders</h3>

                    <a href="/admin/orders">View All</a>

                </div>

                <div class="table-responsive">

                    <table>

                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Time</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (recentOrders && recentOrders.length) { %>

                                <% recentOrders.forEach(order => { %>

                                    <tr>

                                        <td>
                                            #<%= order.orderId %>
                                        </td>

                                        <td>
                                            <%= order.userId?.name ||
                                                "Unknown Customer" %>
                                        </td>

                                        <td>
                                            ₹<%= Number(order.totalAmount || 0)
                                                .toLocaleString("en-IN") %>
                                        </td>

                                        <td>

                                            <span class="badge <%= order.orderStatus %>">
                                                <%= order.orderStatus
                                                    .replace(/_/g, " ") %>
                                            </span>

                                        </td>

                                        <td>
                                            <%= order.createdAt
                                                ? new Date(order.createdAt)
                                                    .toLocaleString("en-IN")
                                                : "N/A" %>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="5" style="text-align:center;">
                                        No orders found.
                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- STOCK ALERTS -->

            <div class="stock-alerts">

                <h3>Stock Alerts</h3>

                <% if (!lowStockProducts || lowStockProducts.length === 0) { %>

                    <div class="alert-box">

                        <div class="alert-top">
                            <i class="ri-checkbox-circle-line"></i>
                            <span>Stock Status</span>
                        </div>

                        <p>
                            All products have sufficient stock.
                        </p>

                    </div>

                <% } else { %>

                    <% lowStockProducts.slice(0, 3).forEach(product => { %>

                        <div class="alert-box">

                            <div class="alert-top">
                                <i class="ri-error-warning-line"></i>
                                <span>Low Stock Warning</span>
                            </div>

                            <p>
                                <%= product.productName %>
                                has only
                                <strong><%= product.stock %></strong>
                                item(s) remaining.
                            </p>

                        </div>

                    <% }) %>

                <% } %>

                <button class="view-products-btn"
                    onclick="window.location.href='/admin/products'">
                    View Products
                </button>

            </div>

        </section>

        <!-- REPORT LINK -->

        <section class="dashboard-section">

            <div class="products-card">

                <div class="products-header">

                    <div>
                        <h3>Detailed Sales Reports</h3>
                        <p>
                            View detailed revenue, payments, returns,
                            products and customer analytics.
                        </p>
                    </div>

                    <button class="dark-btn"
                        onclick="window.location.href='/admin/sales-report'">
                        View Full Report
                    </button>

                </div>

            </div>

        </section>

    </main>

</div>


<!-- SIDEBAR DROPDOWNS -->

<script>

    const dropdowns = document.querySelectorAll(".dropdown-btn");

    dropdowns.forEach(btn => {

        btn.addEventListener("click", () => {

            const wrapper = btn.parentElement;

            const menu = wrapper.querySelector(".dropdown-menu");

            wrapper.classList.toggle("active");

            menu.classList.toggle("show");

        });

    });

</script>

<script>
    const dashboardPeriod = document.getElementById("dashboardPeriod");

    const dashboardStartDate = document.getElementById("dashboardStartDate");

    const dashboardEndDate = document.getElementById("dashboardEndDate");

    const applyDashboardFilter = document.getElementById("applyDashboardFilter");

    const dashboardFilterForm = document.getElementById("dashboardFilterForm");


    function updateDashboardDateInputs() {

        const isCustom = dashboardPeriod.value === "custom";

        dashboardStartDate.style.display = isCustom ? "block" : "none";

        dashboardEndDate.style.display = isCustom ? "block" : "none";

        applyDashboardFilter.style.display = isCustom ? "block" : "none";

        dashboardStartDate.required = isCustom;

        dashboardEndDate.required = isCustom;
    }


    dashboardPeriod.addEventListener("change", function () {

        updateDashboardDateInputs();

        if (this.value !== "custom") {
            dashboardFilterForm.submit();
        }

    });


    updateDashboardDateInputs();
</script>

<script id="dashboardChartData" type="application/json">
<%- JSON.stringify({
    salesChart: typeof salesChart !== "undefined" ? salesChart : [],
    ordersChart: typeof ordersChart !== "undefined" ? ordersChart : [],
    statusOrders: typeof statusOrders !== "undefined" ? statusOrders : []
}).replace(/</g, "\\u003c") %>
</script>


<script>

    // =========================================
    // 1. GET BACKEND DATA
    // =========================================

    const chartData = JSON.parse(
        document.getElementById("dashboardChartData").textContent
    );

    const salesData = chartData.salesChart || [];

    const statusOrders = chartData.statusOrders || [];


    // =========================================
    // 2. CHART VARIABLES
    // =========================================

    let revenueChartInstance = null;

    let statusChartInstance = null;

    const revenueCanvas = document.getElementById("revenueChart");

    const revenueEmpty = document.getElementById("revenueEmpty");

    const statusCanvas = document.getElementById("statusChart");

    const statusEmpty = document.getElementById("statusEmpty");

    const statusLegend = document.getElementById("statusLegend");


    // =========================================
    // 3. STATUS COLORS
    // =========================================

    const statusColors = {

        pending: "#f59e0b",

        processing: "#3b82f6",

        shipped: "#8b5cf6",

        out_for_delivery: "#06b6d4",

        delivered: "#10b981",

        cancelled: "#ef4444",

        returned: "#64748b"

    };


    // =========================================
    // 4. REVENUE CHART
    // =========================================

    function renderRevenueChart() {

        if (revenueChartInstance) {
            revenueChartInstance.destroy();
        }


        const sortedSales = [...salesData].sort(
            (a, b) => a.date.localeCompare(b.date)
        );


        if (!sortedSales.length) {

            revenueCanvas.style.display = "none";

            revenueEmpty.style.display = "block";

            return;

        }


        revenueCanvas.style.display = "block";

        revenueEmpty.style.display = "none";


        const labels = sortedSales.map(item => {

            const [year, month, day] = item.date.split("-");

            return new Date(
                Number(year),
                Number(month) - 1,
                Number(day)
            ).toLocaleDateString("en-IN", {

                day: "2-digit",

                month: "short"

            });

        });


        const amounts = sortedSales.map(item =>
            Number(item.amount) || 0
        );


        revenueChartInstance = new Chart(revenueCanvas, {

            type: "line",

            data: {

                labels,

                datasets: [{

                    label: "Revenue",

                    data: amounts,

                    borderColor: "#2563eb",

                    backgroundColor: "rgba(37, 99, 235, 0.10)",

                    fill: true,

                    tension: 0.4,

                    borderWidth: 2,

                    pointRadius: 3

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {
                        display: false
                    }

                },

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {

                            callback: value =>
                                "₹" + Number(value).toLocaleString("en-IN")

                        }

                    }

                }

            }

        });

    }


    // =========================================
    // 5. ORDER STATUS CHART
    // =========================================

    function renderStatusChart() {

        if (statusChartInstance) {
            statusChartInstance.destroy();
        }

        statusLegend.innerHTML = "";


        // Orders are already filtered by the backend
        const statusCounts = {};


        statusOrders.forEach(order => {

            const status = order.status || "unknown";

            statusCounts[status] =
                (statusCounts[status] || 0) + 1;

        });


        const statusData = Object.entries(statusCounts)

            .map(([status, count]) => ({
                status,
                count
            }))

            .sort((a, b) => b.count - a.count);


        if (!statusData.length) {

            statusCanvas.style.display = "none";

            statusEmpty.style.display = "block";

            return;

        }


        statusCanvas.style.display = "block";

        statusEmpty.style.display = "none";


        const colors = statusData.map(item =>
            statusColors[item.status] || "#94a3b8"
        );


        statusChartInstance = new Chart(statusCanvas, {

            type: "doughnut",

            data: {

                labels: statusData.map(item =>
                    item.status.replace(/_/g, " ")
                ),

                datasets: [{

                    data: statusData.map(item =>
                        Number(item.count) || 0
                    ),

                    backgroundColor: colors,

                    borderWidth: 0,

                    hoverOffset: 5

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: "70%",

                plugins: {

                    legend: {
                        display: false
                    }

                }

            }

        });


        // UPDATE LEGEND
        statusData.forEach((item, index) => {

            const row = document.createElement("div");

            row.className = "status-legend-item";


            const name = document.createElement("span");

            name.className = "legend-name";


            const dot = document.createElement("span");

            dot.className = "legend-dot";

            dot.style.backgroundColor = colors[index];


            const label = document.createElement("span");

            label.textContent = item.status

                .replace(/_/g, " ")

                .replace(/\b\w/g, letter =>
                    letter.toUpperCase()
                );


            name.appendChild(dot);

            name.appendChild(label);


            const count = document.createElement("strong");

            count.textContent = Number(item.count)
                .toLocaleString("en-IN");


            row.appendChild(name);

            row.appendChild(count);


            statusLegend.appendChild(row);

        });

    }


    // =========================================
    // 6. INITIAL CHART RENDERING
    // =========================================

    renderRevenueChart();

    renderStatusChart();

</script>


</body>
</html>
