<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carry Nest Admin Dashboard</title>

    <link rel="stylesheet" href="/Styles/admin/dashboard.css">

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
    >

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div>

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-box">
                    C
                </div>

                <h2>CARRY NEST</h2>

            </div>

            <!-- MENU -->

            <div class="menu-wrapper">

                <!-- DASHBOARD -->

                <a href="/admin/dashboard" class="menu-item active">

                    <span class="menu-left">

                        <i class="ri-dashboard-line"></i>

                        Dashboard

                    </span>

                </a>

                <!-- PRODUCTS -->

                <div class="dropdown-wrapper active">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-bag-line"></i>

                            Products

                        </span>

                       <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">

                        <a href="/admin/products">
                            All Products
                        </a>

                        <a href="/admin/add-product">
                            Add Product
                        </a>

                        <a href="/admin/category" class="submenu">
                            Categories
                        </a>

                        <a href="/admin/brands">
                            Brands
                        </a>

                    </div>

                </div>

                <!-- ORDERS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-cart-line"></i>

                            Orders

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">

                        <a href="/admin/orders">
                            All Orders
                        </a>

                        <a href="#">
                            Pending
                        </a>

                        <a href="#">
                            Processing
                        </a>

                        <a href="#">
                            Shipped
                        </a>

                    </div>

                </div>

                <!-- RETURNS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-arrow-go-back-line"></i>

                            Returns

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">

                        <a href="/admin/return-requests">
                            Requests
                        </a>

                    </div>

                </div>

                <!-- CUSTOMERS -->

                <a href="/admin/customers" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-group-line"></i>

                        Customers

                    </span>

                </a>

                <!-- WALLET -->

                <a href="/admin/wallet" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-wallet-3-line"></i>

                        Wallet & Payments

                    </span>

                </a>

                <!-- PROMOTIONS -->

                <a href="/admin/coupons" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-price-tag-3-line"></i>

                        Promotions

                    </span>

                </a>

                <!-- REPORTS -->

                <a href="/admin/sales-report" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-bar-chart-box-line"></i>

                        Reports

                    </span>

                </a>

            </div>

        </div>

        <!-- LOGOUT -->

        <div class="logout-section">

            <a href="/admin/logout" class="logout-btn">

                <i class="ri-logout-box-r-line"></i>

                Logout

            </a>

        </div>

    </aside>

    <!-- MAIN CONTENT -->

    <main class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <div>

                <p class="breadcrumb">
                    Admin / Dashboard
                </p>

            </div>

            <div class="top-right">

                <div class="admin-profile">

                    <div class="admin-avatar">
                        AD
                    </div>

                    <div>

                        <h4>Admin User</h4>

                        <span>Super Admin</span>

                    </div>

                </div>

            </div>

        </header>

        <!-- DASHBOARD HEADER -->

        <section class="dashboard-header">

            <div>

                <h1>Dashboard Overview</h1>

                <p>
                    Welcome back, here's what's happening today.
                </p>

            </div>

            <div class="dashboard-actions">

                <button
                    class="light-btn"
                    onclick="window.location.href='/admin/sales-report'">

                    Download Report

                </button>

                <button class="dark-btn">
                   <a href="/admin/add-product" style="text-decoration: none;color: white;">
                    + Add Product
                   </a> 
                </button>

            </div>

        </section>

        <!-- STATS -->

        <section class="stats-grid">

            <div class="stats-card">

                <div class="stats-top">

                    <span>Total Revenue</span>

                    <i class="ri-money-dollar-circle-line"></i>

                </div>

                <h2>
                    ₹<%= totalRevenue.toLocaleString("en-IN") %>
                </h2>

                <p class="growth green">
                    ↗ 20.1% vs last month
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">

                    <span>Total Orders</span>

                    <i class="ri-shopping-bag-line"></i>

                </div>

                <h2><%= totalOrders %></h2>

                <p class="growth green">
                    ↗ 12.5% vs last month
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">

                    <span>Active Customers</span>

                    <i class="ri-group-line"></i>

                </div>

                <h2><%= activeCustomers %></h2>

                <p class="growth green">
                    ↗ 4.3% vs last month
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">

                    <span>Pending Actions</span>

                    <i class="ri-error-warning-line"></i>

                </div>

                <h2><%= pendingActions %></h2>

                <p class="growth green">
                    ↗ 8 new vs last month
                </p>

            </div>

        </section>

        <!-- MIDDLE SECTION -->

        <section class="middle-grid">

            <!-- ACTIONS -->

            <div class="action-card">

                <h3>Action Required</h3>

                <div class="action-item">

                    <div class="action-left">

                        <div class="action-icon blue">

                            <i class="ri-shopping-cart-line"></i>

                        </div>

                        <span>Pending Orders</span>

                    </div>

                    <div class="action-right">

                        <span><%= pendingOrders %></span>

                        <i class="ri-arrow-right-line"></i>

                    </div>

                </div>

                <div class="action-item">

                    <div class="action-left">

                        <div class="action-icon orange">

                            <i class="ri-arrow-go-back-line"></i>

                        </div>

                        <span>Return Requests</span>

                    </div>

                    <div class="action-right">

                        <span><%= returnRequests %></span>

                        <i class="ri-arrow-right-line"></i>

                    </div>

                </div>

                <div class="action-item">

                    <div class="action-left">

                        <div class="action-icon red">

                            <i class="ri-alert-line"></i>

                        </div>

                        <span>Low Stock Products</span>

                    </div>

                    <div class="action-right">

                        <span><%= lowStockProducts.length %></span>

                        <i class="ri-arrow-right-line"></i>

                    </div>

                </div>

            </div>

            <!-- RETURNS -->

            <div class="returns-card">

                <h3>Returns Snapshot</h3>

                <div class="returns-grid">

                    <div class="mini-card">

                        <span>Pending Requests</span>
                        
                        <h2><%= returnRequests %></h2>

                    </div>

                    <div class="mini-card">

                        <span>Refunds Pending</span>

                        <h2><%= refundPending %></h2>

                    </div>

                </div>

                <a href="/admin/return-requests">

                <button class="process-btn">

                    <i class="ri-refresh-line"></i>

                    Process Returns

                </button>

                </a>

            </div>

        </section>

        <!-- BOTTOM SECTION -->

        <section class="bottom-grid">

            <!-- ORDERS -->

            <div class="recent-orders">

                <div class="section-top">

                    <h3>Recent Orders</h3>

                    <a href="/admin/orders">
                        View All
                    </a>

                </div>

                <div class="table-responsive">

                    <table>

                        <thead>

                        <tr>

                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Time</th>

                        </tr>

                        </thead>

                        <tbody>

                            <% if (recentOrders.length === 0) { %>

                                <tr>
                                    <td colspan="5" style="text-align:center;">
                                        No orders found
                                    </td>
                                </tr>

                            <% } else { %>

                                <% recentOrders.forEach(order => { %>

                                    <tr>

                                        <td>
                                            #<%= order.orderId %>
                                        </td>

                                        <td>
                                            <%= order.userId?.name || "Unknown Customer" %>
                                        </td>

                                        <td>
                                            ₹<%= order.totalAmount.toLocaleString("en-IN") %>
                                        </td>

                                        <td>
                                            <span class="badge <%= order.orderStatus %>">
                                                <%= order.orderStatus %>
                                            </span>
                                        </td>

                                        <td>
                                            <%= new Date(order.createdAt).toLocaleString("en-IN") %>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- ALERTS -->

            <div class="stock-alerts">

                <h3>Stock Alerts</h3>

                <% if (lowStockProducts.length === 0) { %>

                    <div class="alert-box">

                        <div class="alert-top">
                            <i class="ri-checkbox-circle-line"></i>
                            <span>Stock Status</span>
                        </div>

                        <p>
                            All products have sufficient stock.
                        </p>

                    </div>

                <% } else { %>

                    <% lowStockProducts.slice(0, 3).forEach(product => { %>

                        <div class="alert-box">

                            <div class="alert-top">

                                <i class="ri-error-warning-line"></i>

                                <span>Low Stock Warning</span>

                            </div>

                            <p>
                                <%= product.productName %>
                                has only
                                <strong><%= product.stock %></strong>
                                item(s) remaining.
                            </p>

                        </div>

                    <% }) %>

                <% } %>

                <button class="view-products-btn" onclick="window.location.href='/admin/products'">
                    View Products
                </button>

            </div>

        </section>

    </main>

</div>

<script>

const dropdowns = document.querySelectorAll(".dropdown-btn");

dropdowns.forEach(btn => {

    btn.addEventListener("click", () => {

        const wrapper = btn.parentElement;

        const menu = wrapper.querySelector(".dropdown-menu");

        wrapper.classList.toggle("active");

        menu.classList.toggle("show");

    });

});

</script>

</body>
</html>