<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carry Nest Admin Dashboard</title>

    <link rel="stylesheet" href="/Styles/admin/dashboard.css">

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
    >

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div>

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-box">
                    C
                </div>

                <h2>CARRY NEST</h2>

            </div>

            <!-- MENU -->

            <div class="menu-wrapper">

                <!-- DASHBOARD -->

                <a href="/admin/dashboard" class="menu-item active">

                    <span class="menu-left">

                        <i class="ri-dashboard-line"></i>

                        Dashboard

                    </span>

                </a>

                <!-- PRODUCTS -->

                <div class="dropdown-wrapper active">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-bag-line"></i>

                            Products

                        </span>

                       <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">

                        <a href="#">
                            All Products
                        </a>

                        <a href="#">
                            Add Product
                        </a>

                        <a href="/admin/category" class="submenu">
                            Categories
                        </a>

                        <a href="#">
                            Brands
                        </a>

                    </div>

                </div>

                <!-- ORDERS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-shopping-cart-line"></i>

                            Orders

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">

                        <a href="#">
                            All Orders
                        </a>

                        <a href="#">
                            Pending
                        </a>

                        <a href="#">
                            Processing
                        </a>

                        <a href="#">
                            Shipped
                        </a>

                    </div>

                </div>

                <!-- RETURNS -->

                <div class="dropdown-wrapper">

                    <button class="dropdown-btn">

                        <span class="menu-left">

                            <i class="ri-arrow-go-back-line"></i>

                            Returns

                        </span>

                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>

                    </button>

                    <div class="dropdown-menu">

                        <a href="#">
                            Requests
                        </a>

                        <a href="#">
                            Refunds
                        </a>

                    </div>

                </div>

                <!-- CUSTOMERS -->

                <a href="/admin/customers" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-group-line"></i>

                        Customers

                    </span>

                </a>

                <!-- WALLET -->

                <a href="#" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-wallet-3-line"></i>

                        Wallet & Payments

                    </span>

                </a>

                <!-- PROMOTIONS -->

                <a href="#" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-price-tag-3-line"></i>

                        Promotions

                    </span>

                </a>

                <!-- REPORTS -->

                <a href="#" class="menu-item">

                    <span class="menu-left">

                        <i class="ri-bar-chart-box-line"></i>

                        Reports

                    </span>

                </a>

            </div>

        </div>

        <!-- LOGOUT -->

        <div class="logout-section">

            <a href="/admin/logout" class="logout-btn">

                <i class="ri-logout-box-r-line"></i>

                Logout

            </a>

        </div>

    </aside>

    <!-- MAIN CONTENT -->

    <main class="main-content">

        <!-- TOPBAR -->

        <header class="topbar">

            <div>

                <p class="breadcrumb">
                    Admin / Dashboard
                </p>

            </div>

            <div class="top-right">

                <input
                    type="text"
                    placeholder="Search..."
                    class="top-search"
                >

                <i class="ri-notification-3-line notification"></i>

                <div class="admin-profile">

                    <div class="admin-avatar">
                        AD
                    </div>

                    <div>

                        <h4>Admin User</h4>

                        <span>Super Admin</span>

                    </div>

                </div>

            </div>

        </header>

        <!-- DASHBOARD HEADER -->

        <section class="dashboard-header">

            <div>

                <h1>Dashboard Overview</h1>

                <p>
                    Welcome back, here's what's happening today.
                </p>

            </div>

            <div class="dashboard-actions">

                <button class="light-btn">
                    Download Report
                </button>

                <button class="dark-btn">
                    Add Product
                </button>

            </div>

        </section>

        <!-- STATS -->

        <section class="stats-grid">

            <div class="stats-card">

                <div class="stats-top">

                    <span>Total Revenue</span>

                    <i class="ri-money-dollar-circle-line"></i>

                </div>

                <h2>$45,231.89</h2>

                <p class="growth green">
                    ↗ 20.1% vs last month
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">

                    <span>Total Orders</span>

                    <i class="ri-shopping-bag-line"></i>

                </div>

                <h2>1,342</h2>

                <p class="growth green">
                    ↗ 12.5% vs last month
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">

                    <span>Active Customers</span>

                    <i class="ri-group-line"></i>

                </div>

                <h2>892</h2>

                <p class="growth green">
                    ↗ 4.3% vs last month
                </p>

            </div>

            <div class="stats-card">

                <div class="stats-top">

                    <span>Pending Actions</span>

                    <i class="ri-error-warning-line"></i>

                </div>

                <h2>25</h2>

                <p class="growth green">
                    ↗ 8 new vs last month
                </p>

            </div>

        </section>

        <!-- MIDDLE SECTION -->

        <section class="middle-grid">

            <!-- ACTIONS -->

            <div class="action-card">

                <h3>Action Required</h3>

                <div class="action-item">

                    <div class="action-left">

                        <div class="action-icon blue">

                            <i class="ri-shopping-cart-line"></i>

                        </div>

                        <span>Pending Orders</span>

                    </div>

                    <div class="action-right">

                        <span>12</span>

                        <i class="ri-arrow-right-line"></i>

                    </div>

                </div>

                <div class="action-item">

                    <div class="action-left">

                        <div class="action-icon orange">

                            <i class="ri-arrow-go-back-line"></i>

                        </div>

                        <span>Return Requests</span>

                    </div>

                    <div class="action-right">

                        <span>5</span>

                        <i class="ri-arrow-right-line"></i>

                    </div>

                </div>

                <div class="action-item">

                    <div class="action-left">

                        <div class="action-icon red">

                            <i class="ri-alert-line"></i>

                        </div>

                        <span>Low Stock Products</span>

                    </div>

                    <div class="action-right">

                        <span>8</span>

                        <i class="ri-arrow-right-line"></i>

                    </div>

                </div>

            </div>

            <!-- RETURNS -->

            <div class="returns-card">

                <h3>Returns Snapshot</h3>

                <div class="returns-grid">

                    <div class="mini-card">

                        <span>Requests Today</span>

                        <h2>3</h2>

                    </div>

                    <div class="mini-card">

                        <span>Refunds Pending</span>

                        <h2>7</h2>

                    </div>

                </div>

                <button class="process-btn">

                    <i class="ri-refresh-line"></i>

                    Process Returns

                </button>

            </div>

        </section>

        <!-- BOTTOM SECTION -->

        <section class="bottom-grid">

            <!-- ORDERS -->

            <div class="recent-orders">

                <div class="section-top">

                    <h3>Recent Orders</h3>

                    <a href="#">
                        View All
                    </a>

                </div>

                <div class="table-responsive">

                    <table>

                        <thead>

                        <tr>

                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Time</th>

                        </tr>

                        </thead>

                        <tbody>

                        <tr>

                            <td>#ORD-001</td>
                            <td>Alex Thompson</td>
                            <td>$120.00</td>

                            <td>

                                <span class="badge delivered">
                                    Delivered
                                </span>

                            </td>

                            <td>2 mins ago</td>

                        </tr>

                        <tr>

                            <td>#ORD-002</td>
                            <td>Sarah Parker</td>
                            <td>$54.00</td>

                            <td>

                                <span class="badge processing">
                                    Processing
                                </span>

                            </td>

                            <td>15 mins ago</td>

                        </tr>

                        <tr>

                            <td>#ORD-003</td>
                            <td>Michael Chen</td>
                            <td>$299.99</td>

                            <td>

                                <span class="badge pending">
                                    Pending
                                </span>

                            </td>

                            <td>1 hour ago</td>

                        </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- ALERTS -->

            <div class="stock-alerts">

                <h3>Stock Alerts</h3>

                <div class="alert-box">

                    <div class="alert-top">

                        <i class="ri-error-warning-line"></i>

                        <span>Low Stock Warning</span>

                    </div>

                    <p>
                        Wireless Headphones is below threshold.
                    </p>

                </div>

                <div class="alert-box">

                    <div class="alert-top">

                        <i class="ri-error-warning-line"></i>

                        <span>Low Stock Warning</span>

                    </div>

                    <p>
                        Wireless Headphones is below threshold.
                    </p>

                </div>

                <div class="alert-box">

                    <div class="alert-top">

                        <i class="ri-error-warning-line"></i>

                        <span>Low Stock Warning</span>

                    </div>

                    <p>
                        Wireless Headphones is below threshold.
                    </p>

                </div>

                <button class="view-products-btn">
                    View Products
                </button>

            </div>

        </section>

    </main>

</div>

<script>

const dropdowns = document.querySelectorAll(".dropdown-btn");

dropdowns.forEach(btn => {

    btn.addEventListener("click", () => {

        const wrapper = btn.parentElement;

        const menu = wrapper.querySelector(".dropdown-menu");

        wrapper.classList.toggle("active");

        menu.classList.toggle("show");

    });

});

</script>

</body>
</html>