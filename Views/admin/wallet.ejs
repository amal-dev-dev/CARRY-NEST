
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wallet & Payments | CARRY NEST</title>

    <link rel="stylesheet" href="/Styles/admin/wallet.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css">
</head>

<body>

<div class="dashboard-container">

    <!-- SIDEBAR OVERLAY -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <div class="sidebar-top">

            <div class="logo-section">
                <div class="logo-box">C</div>
                <div class="logo-text">
                    <h2>CARRY NEST</h2>
                </div>
            </div>

            <nav class="menu-wrapper">

                <a href="/admin/dashboard" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-dashboard-line"></i>
                        <span>Dashboard</span>
                    </span>
                </a>

                <!-- PRODUCTS -->
                <div class="dropdown-wrapper">

                    <button type="button" class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-shopping-bag-line"></i>
                            <span>Products</span>
                        </span>
                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/products">All Products</a>
                        <a href="/admin/add-product">Add Product</a>
                        <a href="/admin/category">Categories</a>
                        <a href="/admin/brands">Brands</a>
                    </div>

                </div>

                <!-- ORDERS -->
                <div class="dropdown-wrapper">

                    <button type="button" class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-shopping-cart-line"></i>
                            <span>Orders</span>
                        </span>
                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/orders">All Orders</a>
                        <a href="/admin/orders?status=pending">Pending</a>
                        <a href="/admin/orders?status=shipped">Shipped</a>
                        <a href="/admin/orders?status=delivered">Delivered</a>
                    </div>

                </div>

                <!-- RETURNS -->
                <div class="dropdown-wrapper">

                    <button type="button" class="dropdown-btn">
                        <span class="menu-left">
                            <i class="ri-arrow-go-back-line"></i>
                            <span>Returns</span>
                        </span>
                        <i class="ri-arrow-down-s-line dropdown-arrow"></i>
                    </button>

                    <div class="dropdown-menu">
                        <a href="/admin/return-requests">Requests</a>
                    </div>

                </div>

                <a href="/admin/customers" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-group-line"></i>
                        <span>Customers</span>
                    </span>
                </a>

                <a href="/admin/wallet" class="menu-item active">
                    <span class="menu-left">
                        <i class="ri-wallet-3-line"></i>
                        <span>Wallet & Payments</span>
                    </span>
                </a>

                <a href="/admin/coupons" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-price-tag-3-line"></i>
                        <span>Promotions</span>
                    </span>
                </a>

                <a href="/admin/sales-report" class="menu-item">
                    <span class="menu-left">
                        <i class="ri-bar-chart-box-line"></i>
                        <span>Reports</span>
                    </span>
                </a>

            </nav>

        </div>

        <!-- LOGOUT -->
        <div class="logout-section">
            <a href="/admin/logout" class="logout-btn">
                <i class="ri-logout-box-r-line"></i>
                <span>Logout</span>
            </a>
        </div>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="topbar-left">

                <button
                    type="button"
                    class="sidebar-toggle"
                    id="sidebarToggle"
                    aria-label="Toggle sidebar"
                >
                    <i class="ri-menu-line"></i>
                </button>

                <div class="breadcrumb">
                    <span>Admin</span>
                    <i class="ri-arrow-right-s-line"></i>
                    <strong>Wallet & Payments</strong>
                </div>

            </div>

            <div class="topbar-right">

                <div class="admin-profile">

                    <div class="admin-avatar">AD</div>

                    <div class="admin-info">
                        <h4>Admin User</h4>
                        <span>Super Admin</span>
                    </div>

                </div>

            </div>

        </header>

        <!-- PAGE CONTENT -->
        <div class="wallet-content">

            <!-- PAGE HEADING -->
            <section class="page-heading">

                <div>
                    <h1>Wallet & Payments</h1>
                    <p>Monitor transactions, revenue and refund requests.</p>
                </div>

                <div class="heading-icon">
                    <i class="ri-wallet-3-line"></i>
                </div>

            </section>

            <!-- SUMMARY CARDS -->
            <section class="summary-cards">

                <!-- TOTAL TRANSACTIONS -->
                <article class="summary-card">

                    <div class="card-top">
                        <span class="summary-label">Total Transactions</span>
                        <div class="summary-icon transaction-icon">
                            <i class="ri-exchange-funds-line"></i>
                        </div>
                    </div>

                    <h2>
                        <%= Number(totalTransactions || 0).toLocaleString("en-IN") %>
                    </h2>

                    <p class="card-description">
                        <i class="ri-file-list-3-line"></i>
                        All matching transactions
                    </p>

                </article>

                <!-- REVENUE -->
                <article class="summary-card">

                    <div class="card-top">
                        <span class="summary-label">Razorpay Revenue</span>
                        <div class="summary-icon revenue-icon">
                            <i class="ri-money-rupee-circle-line"></i>
                        </div>
                    </div>

                    <h2 class="revenue-value">
                        ₹<%= Number(revenue || 0).toLocaleString("en-IN", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) %>
                    </h2>

                    <p class="card-description">
                        <i class="ri-shield-check-line"></i>
                        Completed online payments
                    </p>

                </article>

                <!-- REFUNDS -->
                <article class="summary-card">

                    <div class="card-top">
                        <span class="summary-label">Refunds Due</span>
                        <div class="summary-icon refund-icon">
                            <i class="ri-refund-2-line"></i>
                        </div>
                    </div>

                    <h2>
                        <%= Number(refundsDue || 0).toLocaleString("en-IN") %>
                    </h2>

                    <p class="card-description refund-description">
                        <i class="ri-time-line"></i>
                        Return requests awaiting action
                    </p>

                </article>

            </section>

            <!-- TRANSACTIONS -->
            <section class="transactions-card">

                <!-- TABLE HEADER -->
                <div class="transactions-header">

                    <div class="transactions-title">
                        <h2>Transaction History</h2>
                        <p>View and track customer transactions</p>
                    </div>

                    <div class="transaction-actions">

                        <form
                            action="/admin/wallet"
                            method="GET"
                            class="search-form"
                            id="searchForm"
                        >

                            <div class="transaction-search">
                                <i class="ri-search-line"></i>

                                <input
                                    type="search"
                                    name="search"
                                    id="transactionSearch"
                                    value="<%= search || '' %>"
                                    placeholder="Search customer..."
                                    aria-label="Search transactions by customer"
                                >
                            </div>

                            <button type="submit" class="search-btn">
                                Search
                            </button>

                        </form>

                        <% if (search) { %>
                            <a href="/admin/wallet" class="clear-search">
                                <i class="ri-close-line"></i>
                                Clear
                            </a>
                        <% } %>

                    </div>

                </div>

                <!-- SEARCH INFORMATION -->
                <% if (search) { %>
                    <div class="search-info">
                        <i class="ri-search-line"></i>
                        Showing results for
                        <strong>"<%= search %>"</strong>
                    </div>
                <% } %>

                <!-- TABLE -->
                <div class="table-wrapper">

                    <table class="transactions-table">

                        <thead>
                            <tr>
                                <th>Transaction ID</th>
                                <th>Customer</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (transactions && transactions.length > 0) { %>

                                <% transactions.forEach(transaction => { %>

                                    <tr>

                                        <!-- TRANSACTION ID -->
                                        <td>
                                            <span class="transaction-id">
                                                <%= transaction.transactionId || "N/A" %>
                                            </span>
                                        </td>

                                        <!-- CUSTOMER -->
                                        <td>
                                            <div class="user-cell">

                                                <div class="user-avatar">
                                                    <%= transaction.user?.name
                                                        ?.charAt(0)
                                                        ?.toUpperCase() || "U" %>
                                                </div>

                                                <div class="user-details">
                                                    <span class="user-name">
                                                        <%= transaction.user?.name || "Unknown User" %>
                                                    </span>

                                                    <span class="user-email">
                                                        <%= transaction.user?.email || "" %>
                                                    </span>
                                                </div>

                                            </div>
                                        </td>

                                        <!-- TYPE -->
                                        <td>
                                            <span class="type-badge
                                                <%= transaction.type?.toLowerCase() === 'refund'
                                                    ? 'type-refund'
                                                    : transaction.type?.toLowerCase() === 'deposit'
                                                        ? 'type-deposit'
                                                        : 'type-purchase' %>">

                                                <i class="<%= transaction.type?.toLowerCase() === 'refund'
                                                    ? 'ri-refund-2-line'
                                                    : transaction.type?.toLowerCase() === 'deposit'
                                                        ? 'ri-add-circle-line'
                                                        : 'ri-shopping-bag-line' %>">
                                                </i>

                                                <%= transaction.type || "Transaction" %>
                                            </span>
                                        </td>

                                        <!-- AMOUNT -->
                                        <td>
                                            <span class="transaction-amount
                                                <%= transaction.type === 'Refund' ||
                                                    transaction.type === 'Deposit'
                                                    ? 'amount-positive'
                                                    : 'amount-negative' %>">

                                                <%= transaction.type === 'Refund' ||
                                                    transaction.type === 'Deposit'
                                                    ? '+' : '-' %>

                                                ₹<%= Number(transaction.amount || 0)
                                                    .toLocaleString("en-IN", {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                    }) %>
                                            </span>
                                        </td>

                                        <!-- STATUS -->
                                        <td>
                                            <span class="status-badge
                                                status-<%= (transaction.status || 'unknown').toLowerCase() %>">

                                                <span class="status-dot"></span>
                                                <%= transaction.status || "Unknown" %>
                                            </span>
                                        </td>

                                        <!-- DATE -->
                                        <td>
                                            <span class="transaction-date">
                                                <%= transaction.createdAt
                                                    ? new Date(transaction.createdAt).toLocaleDateString("en-IN", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric"
                                                    })
                                                    : "N/A" %>
                                            </span>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>
                                    <td colspan="6" class="empty-table">

                                        <div class="empty-state">
                                            <div class="empty-icon">
                                                <i class="ri-wallet-3-line"></i>
                                            </div>

                                            <h3>No transactions found</h3>

                                            <p>
                                                <% if (search) { %>
                                                    No customers match your search.
                                                <% } else { %>
                                                    Transactions will appear here when available.
                                                <% } %>
                                            </p>

                                            <% if (search) { %>
                                                <a href="/admin/wallet" class="empty-reset-btn">
                                                    Clear Search
                                                </a>
                                            <% } %>
                                        </div>

                                    </td>
                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

                <!-- TABLE FOOTER -->
                <div class="transactions-footer">

                    <div class="showing-text">
                        <% if (totalTransactions > 0) { %>

                            Showing
                            <strong>
                                <%= ((currentPage - 1) * 10) + 1 %>
                            </strong>

                            to

                            <strong>
                                <%= Math.min(currentPage * 10, totalTransactions) %>
                            </strong>

                            of

                            <strong>
                                <%= totalTransactions %>
                            </strong>

                            transactions

                        <% } else { %>

                            0 transactions

                        <% } %>
                    </div>

                    <!-- PAGINATION -->
                    <% if (totalPages > 1) { %>

                        <div class="pagination">

                            <% if (currentPage > 1) { %>

                                <a
                                    href="/admin/wallet?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>"
                                    class="page-btn"
                                    aria-label="Previous page"
                                >
                                    <i class="ri-arrow-left-s-line"></i>
                                    <span>Previous</span>
                                </a>

                            <% } %>

                            <% for (let i = 1; i <= totalPages; i++) { %>

                                <a
                                    href="/admin/wallet?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>"
                                    class="page-btn page-number
                                        <%= currentPage === i ? 'active' : '' %>"
                                >
                                    <%= i %>
                                </a>

                            <% } %>

                            <% if (currentPage < totalPages) { %>

                                <a
                                    href="/admin/wallet?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>"
                                    class="page-btn"
                                    aria-label="Next page"
                                >
                                    <span>Next</span>
                                    <i class="ri-arrow-right-s-line"></i>
                                </a>

                            <% } %>

                        </div>

                    <% } %>

                </div>

            </section>

        </div>

    </main>

</div>

<!-- JAVASCRIPT -->
<script>

    // SIDEBAR MOBILE TOGGLE
    const sidebar = document.getElementById("sidebar");
    const sidebarToggle = document.getElementById("sidebarToggle");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    function openSidebar() {
        sidebar.classList.add("sidebar-open");
        sidebarOverlay.classList.add("overlay-active");
    }

    function closeSidebar() {
        sidebar.classList.remove("sidebar-open");
        sidebarOverlay.classList.remove("overlay-active");
    }

    sidebarToggle.addEventListener("click", () => {
        if (sidebar.classList.contains("sidebar-open")) {
            closeSidebar();
        } else {
            openSidebar();
        }
    });

    sidebarOverlay.addEventListener("click", closeSidebar);


    // SIDEBAR DROPDOWNS
    const dropdownButtons = document.querySelectorAll(".dropdown-btn");

    dropdownButtons.forEach(button => {

        button.addEventListener("click", () => {

            const wrapper = button.closest(".dropdown-wrapper");

            const isOpen = wrapper.classList.contains("active");

            // Close other dropdowns
            document.querySelectorAll(".dropdown-wrapper").forEach(item => {
                item.classList.remove("active");
            });

            // Open selected dropdown
            if (!isOpen) {
                wrapper.classList.add("active");
            }

        });

    });


    // SEARCH
    const searchInput = document.getElementById("transactionSearch");
    const searchForm = document.getElementById("searchForm");

    searchForm.addEventListener("submit", event => {

        const search = searchInput.value.trim();

        searchInput.value = search;

        // Reset pagination when searching
        const pageInput = searchForm.querySelector('input[name="page"]');

        if (pageInput) {
            pageInput.remove();
        }

    });


    // CLOSE SIDEBAR WHEN NAVIGATING ON MOBILE
    document.querySelectorAll(".sidebar a").forEach(link => {
        link.addEventListener("click", closeSidebar);
    });


    // ESCAPE KEY CLOSES SIDEBAR
    document.addEventListener("keydown", event => {
        if (event.key === "Escape") {
            closeSidebar();
        }
    });

</script>

</body>
</html>
