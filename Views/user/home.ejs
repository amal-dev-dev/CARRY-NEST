<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CarryNest</title>
    <link rel="stylesheet" href="/styles/user/home.css">
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar">
            <div class="logo">CARRYNEST</div>

            <div class="nav-icons">
                <i class="fa-solid fa-cart-shopping"></i>
                <i class="fa-regular fa-heart"></i>
                <a href="/user/profile" style="color: black;"><i class="fa-regular fa-user"></i></a>
            </div>
        </nav>
    </header>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-content">
            <p>GET YOUR</p>
            <h1>BACKPACK</h1>
            <p>Explore premium collections for every journey.</p>
            <button>BUY NOW</button>
        </div>
    </section>

    <!-- Brands -->
    <section class="brands">
        <span>Nike</span>
        <span>Hush</span>
        <span>Puma</span>
        <span>Shoe</span>
        <span>Marc</span>
        <span>Supreme</span>
    </section>

    <!-- New Arrivals -->
    <section class="products">
        <h2>OUR PRODUCTS</h2>

            <div class="product-grid">

                <% products.forEach(product => { %>

                    <a href="/product/<%= product._id %>" style="text-decoration: none;">

                        <div class="card">

                            <img
                                src="<%= product.productImage[0] %>"
                                alt="<%= product.productName %>"
                            >

                            <h4><%= product.productName %></h4>

                            <p>₹<%= product.salePrice %></p>

                        </div>

                    </a>

                <% }) %>

            </div>

        <a href="/user/products" class="view-btn">View All</a>
    </section>

    <!-- Top Selling -->
    <section class="products">
        <h2>TOP SELLING</h2>

        <div class="product-grid">
            <div class="card">
                <img src="https://via.placeholder.com/200">
                <h4>Leather Bag</h4>
                <p>$210</p>
            </div>

            <div class="card">
                <img src="https://via.placeholder.com/200">
                <h4>Travel Pack</h4>
                <p>$145</p>
            </div>

            <div class="card">
                <img src="https://via.placeholder.com/200">
                <h4>Minimal Backpack</h4>
                <p>$90</p>
            </div>

            <div class="card">
                <img src="https://via.placeholder.com/200">
                <h4>Office Bag</h4>
                <p>$210</p>
            </div>
        </div>

        <button class="view-btn">View All</button>
    </section>

    <!-- Browse Style -->
    <section class="style-section">
        <h2>BROWSE BY STYLE</h2>

        <div class="style-grid">
            <div class="style-card">
                <img src="https://via.placeholder.com/400x250">
            </div>

            <div class="style-card">
                <img src="https://via.placeholder.com/400x250">
            </div>

            <div class="style-card">
                <img src="https://via.placeholder.com/400x250">
            </div>

            <div class="style-card">
                <img src="https://via.placeholder.com/400x250">
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section class="testimonial-section">
        <h2>OUR HAPPY CUSTOMERS</h2>

        <div class="testimonial-grid">
            <div class="testimonial">
                <h4>Sarah</h4>
                <p>Excellent quality and premium design.</p>
            </div>

            <div class="testimonial">
                <h4>Nick</h4>
                <p>Very comfortable and durable products.</p>
            </div>

            <div class="testimonial">
                <h4>Anna</h4>
                <p>Fast delivery and amazing customer support.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-grid">

            <div>
                <h3>CARRYNEST</h3>
                <p>Premium bags and travel accessories.</p>
            </div>

            <div>
                <h4>Services</h4>
                <ul>
                    <li>Shipping</li>
                    <li>Returns</li>
                    <li>Support</li>
                </ul>
            </div>

            <div>
                <h4>Company</h4>
                <ul>
                    <li>About</li>
                    <li>Blog</li>
                    <li>Contact</li>
                </ul>
            </div>

            <div>
                <h4>Subscribe</h4>
                <div class="subscribe">
                    <input type="email" placeholder="Email">
                    <button>Send</button>
                </div>
            </div>

        </div>
    </footer>

</body>
</html>