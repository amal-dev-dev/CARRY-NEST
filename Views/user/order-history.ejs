<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Order History</title>

    <link
        rel="stylesheet"
        href="/Styles/user/order-history.css">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

<!-- =========================
        NAVBAR
========================= -->
<nav class="navbar">

    <div class="logo">
        CARRY NEST
    </div>

    <div class="search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input
            type="text"
            placeholder="Search for products...">
    </div>

    <div class="nav-icons">
        <a href="/user/cart">
            <i class="fa-solid fa-cart-shopping"></i>
        </a>
        <a href="/user/profile">
            <i class="fa-regular fa-user"></i>
        </a>
        <a href="/user/wishlist">
            <i class="fa-regular fa-heart"></i>
        </a>
    </div>

</nav>

<!-- =========================
        ORDER HISTORY SECTION
========================= -->
<section class="order-history-section">

    <div class="order-history-container">

        <!-- LEFT SIDEBAR -->
        <aside class="profile-sidebar">

            <div class="profile-card">
                <img
                    src="/images/profile-user.png"
                    alt="Profile">

                <h3>John Doe</h3>
                <p>john.doe@gmail.com</p>
                <span>+91 9859 77827</span>
            </div>

            <div class="profile-menu">
                <a href="/user/profile">
                    <i class="fa-regular fa-user"></i>
                    Personal Information
                </a>

                <a href="/user/address">
                    <i class="fa-solid fa-location-dot"></i>
                    Addresses
                </a>

                <a href="#">
                    <i class="fa-solid fa-gift"></i>
                    Referrals
                </a>

                <a
                    href="/user/orders"
                    class="active">
                    <i class="fa-regular fa-clipboard"></i>
                    Order History
                </a>

                <a href="#">
                    <i class="fa-solid fa-wallet"></i>
                    Wallet
                </a>

                <a
                    href="/logout"
                    class="logout">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logout
                </a>
            </div>

        </aside>

        <!-- RIGHT CONTENT -->
        <div class="orders-content">

            <h2>Order History</h2>

            <!-- ORDER CARD 1 -->
            <div class="order-card">

                <div class="order-top">
                    <div>
                        <h3>ORD-2024-001</h3>
                        <p>January 15, 2024</p>
                    </div>

                    <span class="status delivered">
                        Delivered
                    </span>
                </div>

                <div class="order-body">

                    <div class="order-product">
                        <img
                            src="/images/bag1.png"
                            alt="Bag">

                        <div class="order-product-info">
                            <h4>THE ARCHIVAL BACKPACK</h4>
                            <p>Onyx / Full Grain</p>
                            <strong>$450.00</strong>
                        </div>
                    </div>

                    <div class="order-right">
                        <span class="order-price">$450.00</span>

                        <a
                            href="/user/order-details/1"
                            class="track-btn">
                            <i class="fa-regular fa-eye"></i>
                            Track Order
                        </a>
                    </div>

                </div>

            </div>

            <!-- ORDER CARD 2 -->
            <div class="order-card">

                <div class="order-top">
                    <div>
                        <h3>ORD-2024-002</h3>
                        <p>January 10, 2024</p>
                    </div>

                    <span class="status transit">
                        In Transit
                    </span>
                </div>

                <div class="order-body">

                    <div class="order-product">
                        <img
                            src="/images/bag2.png"
                            alt="Bag">

                        <div class="order-product-info">
                            <h4>THE CORE TOTE</h4>
                            <p>Obsidian / Pebbled</p>
                            <strong>$320.00</strong>
                        </div>
                    </div>

                    <div class="order-right">
                        <span class="order-price">$320.00</span>

                        <a
                            href="/user/order-details/2"
                            class="track-btn">
                            <i class="fa-regular fa-eye"></i>
                            Track Order
                        </a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- =========================
        FOOTER
========================= -->
<footer>

    <div class="footer-container">

        <div class="footer-col">
            <h3>CARRY NEST</h3>
            <p>
                Lorem ipsum dolor sit amet consectetur.
                Purus in etiam risus ut sem eu urna.
                Massa feugiat consequat nec libero.
            </p>
            <p>Lorem ipsum dolor sit</p>
        </div>

        <div class="footer-col">
            <h4>Service</h4>
            <p>Laptop Bags</p>
            <p>Trekking Bags</p>
            <p>School Bags</p>
            <p>Office Bags</p>
            <p>Travelling Bags</p>
        </div>

        <div class="footer-col">
            <h4>Company</h4>
            <p>Service</p>
            <p>Features</p>
            <p>Our Team</p>
            <p>Portfolio</p>
            <p>Blog</p>
            <p>Contact Us</p>
        </div>

        <div class="footer-col footer-contact">
            <h4>Contact Us</h4>

            <div class="footer-input-box">
                <input
                    type="text"
                    placeholder="Your Email / Phone no.">
                <button>Send</button>
            </div>

            <div class="social-icons">
                <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="#"><i class="fa-brands fa-instagram"></i></a>
                <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
                <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
            </div>
        </div>

    </div>

    <div class="footer-bottom">

        <p>Copyright Tanah Air Studio</p>

        <div class="footer-bottom-info">
            <span><i class="fa-solid fa-location-dot"></i> 8819 Ohio St. South Gate, CA 90280</span>
            <span><i class="fa-regular fa-envelope"></i> CrossLine@hello.com</span>
            <span><i class="fa-solid fa-phone"></i> +91 386-688-3295</span>
        </div>

    </div>

</footer>

</body>
</html>