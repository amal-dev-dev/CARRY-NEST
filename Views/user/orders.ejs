<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CARRY NEST - Personal Information</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/Styles/user/orders.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">CARRY NEST</div>

        <div class="nav-icons">
            <a href="/user/cart" class="cart-link">
                <i class="fa-solid fa-cart-shopping"></i>

                <% if (cartCount > 0) { %>
                    <span class="cart-badge"><%= cartCount %></span>
                <% } %>
            </a>
            
            <a href="/user/wishlist" class="wishlist-link">
                <i class="fa-regular fa-heart"></i>

                <% if (wishlistCount > 0) { %>
                    <span class="wishlist-badge">
                        <%= wishlistCount %>
                    </span>
                <% } %>
            </a>

            <a href="/user/profile">
                <i class="fa-regular fa-user"></i>
            </a>
        </div>
    </nav>

    <div class="profile-page-layout">
        <!-- Sidebar -->
        <aside class="sidebar-container">
            <div class="user-id-card">
                <div class="avatar-box">
                    <img src="<%= user.profileImage || 'https://ui-avatars.com/api/?name=' + user.name %>">
                </div>
                <h3><%= user.name %></h3>
                <p class="user-email"><%= user.email %></p>
                <p class="user-phone"><%= user.phone %></p>
            </div>

            <nav class="nav-menu">
                <!-- Personal Information is now the ACTIVE item -->
                 <a href="/user/home" class="nav-item">
                    <span class="nav-icon"> <i class="fa-solid fa-house"></i></span> Home
                </a>
                <a href="/user/profile" class="nav-item">
                    <span class="nav-icon"><i class="fa-regular fa-user"></i></span> Personal Information
                </a>
                <a href="/user/address" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-location-dot"></i></span> Addresses
                </a>
                <a href="/user/referral" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-gift"></i></span> Referrals
                </a>
                <a href="/user/orders" class="nav-item active">
                    <span class="nav-icon"><i class="fa-solid fa-box"></i></span> Order History
                </a>
                <a href="/user/wallet" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-wallet"></i></span> Wallet
                </a>
                <a href="/user/change-password" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-key"></i></span> Change Password
                </a>
                <div class="nav-divider"></div>
                <form action="/user/logout" method="POST" class="logout-form">
                    <button type="submit" class="nav-item logout-btn">
                        <span class="nav-icon">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </span>
                        Logout
                    </button>
                </form>
            </nav>
        </aside>

        <section class="order-history-section">

            <!-- TOP BAR -->
            <div class="orders-topbar">
                <h2 class="order-history-title">Order History</h2>

                <form action="/user/orders" method="GET" class="orders-search-box">
                    <input
                        type="text"
                        name="search"
                        placeholder="Search by Order ID or Product Name"
                        value="<%= search || '' %>"
                    >

                    <button type="submit">
                        Search
                    </button>

                    <% if (search) { %>
                        <a href="/user/orders" class="clear-search-btn">Clear</a>
                    <% } %>
                </form>
            </div>

            <% if (orders && orders.length > 0) { %>
                <% orders.forEach(order => { %>

                    <div class="order-history-card">
                        <div class="order-top">
                            <div>
                                <h3>
                                    Order #<%= order.orderId || order._id.toString().slice(-8).toUpperCase() %>
                                </h3>

                                <p>
                                    <%= new Date(order.createdAt).toLocaleDateString("en-IN", {
                                        day: "numeric",
                                        month: "long",
                                        year: "numeric"
                                    }) %>
                                </p>
                            </div>

                            <% if (order.paymentStatus === "failed") { %>

                                <span class="order-status payment-failed">
                                    Payment Failed
                                </span>

                            <% } else { %>

                                <span class="order-status <%= order.orderStatus %>">
                                    <%= order.orderStatus.replaceAll("_", " ") %>
                                </span>

                            <% } %>

                        </div>

                        <% if (order.products && order.products.length > 0) { %>

                        <div class="order-middle">

                            <div class="order-preview">

                                <div class="product-image-stack">

                                    <% order.products.slice(0, 3).forEach(product => { %>

                                        <div class="preview-image">

                                            <img
                                                src="<%= product.productId?.productImage?.[0] || '/images/default-product.png' %>"
                                                alt="<%= product.productId?.productName || 'Product' %>"
                                            >

                                        </div>

                                    <% }) %>

                                    <% if(order.products.length > 3){ %>

                                        <div class="more-items">
                                            +<%= order.products.length - 3 %>
                                        </div>

                                    <% } %>

                                </div>

                                <div class="order-item-summary">

                                    <strong>
                                        <%= order.products.length %>
                                        <%= order.products.length === 1 ? 'Item' : 'Items' %>
                                    </strong>

                                    <% order.products.slice(0, 2).forEach(item => { %>

                                        <p>
                                            <%= item.productId?.productName || "Product unavailable" %>
                                            × <%= item.quantity %>
                                        </p>

                                    <% }) %>

                                    <% if (order.products.length > 2) { %>
                                        <p>
                                            +<%= order.products.length - 2 %> more item(s)
                                        </p>
                                    <% } %>

                                </div>

                            </div>

                            <div class="order-price">

                                <span>Total</span>

                                <strong>
                                    ₹<%= Number(order.totalAmount || 0).toFixed(2) %>
                                </strong>

                                <% if (order.paymentStatus === "failed") { %>

                                    <small class="payment-failed-text">
                                        Payment Failed
                                    </small>

                                <% } else if (order.paymentStatus === "completed") { %>

                                    <small class="payment-success-text">
                                        Payment Completed
                                    </small>

                                <% } %>

                            </div>

                        </div>

                        <% } %>


                        <div class="order-bottom">

                            <a
                                href="/user/order-details/<%= order._id %>"
                                class="track-btn">

                                <i class="fa-solid fa-eye"></i>
                                View Order Details

                            </a>

                            <% if (
                                order.paymentStatus === "failed" &&
                                order.orderStatus !== "cancelled"
                            ) { %>

                                <form
                                    action="/user/retry-payment/<%= order._id %>"
                                    method="POST">

                                    <button type="submit" class="retry-payment-btn">
                                        <i class="fa-solid fa-rotate-right"></i>
                                        Retry Payment
                                    </button>

                                </form>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

                <% if (totalPages > 1) { %>

                    <div class="pagination">

                        <% if (currentPage > 1) { %>

                            <a
                                href="/user/orders?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>"
                                class="pagination-btn">
                                Previous
                            </a>

                        <% } %>


                        <% for (let i = 1; i <= totalPages; i++) { %>

                            <a
                                href="/user/orders?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>"
                                class="pagination-number <%= currentPage === i ? 'active' : '' %>">

                                <%= i %>

                            </a>

                        <% } %>


                        <% if (currentPage < totalPages) { %>

                            <a
                                href="/user/orders?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>"
                                class="pagination-btn">

                                Next

                            </a>

                        <% } %>

                    </div>

                <% } %>

            <% } else { %>
                <div class="no-orders">
                    <p>No orders found.</p>
                </div>
            <% } %>

        </section>
  
    </div>

    <!-- Dark Footer -->
    <footer>
        <div class="footer-container">

            <!-- Brand -->
            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p class="footer-tagline">
                    Carry Your World. Your Style, Your Journey.
                </p>
                <p>
                    Discover stylish, durable and functional bags
                    designed for everyday life, work and travel.
                </p>
            </div>

            <!-- Shop -->
            <div class="footer-col">
                <h4>Shop</h4>

                <a href="/user/products">All Products</a>
                <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
                <a href="/user/products?category=Office%20Bags">Office Bags</a>
                <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
                <a href="/user/products?category=School%20Bags">School Bags</a>
                <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
            </div>

            <!-- Quick Links -->
            <div class="footer-col">
                <h4>Quick Links</h4>
                <a href="/user/home">Home</a>
                <a href="/user/about">About Us</a>
                <a href="/user/profile">My Account</a>
                <a href="/user/orders">My Orders</a>
                <a href="/user/contact">Contact Us</a>
            </div>

            <!-- Contact -->
            <div class="footer-col footer-contact">
                <h4>Contact Us</h4>

                <p>
                    <i class="fa-regular fa-envelope"></i>
                    support@yourdomain.com
                </p>

                <p>
                    <i class="fa-solid fa-phone"></i>
                    +91 XXXXX XXXXX
                </p>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Kerala, India
                </p>

                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 CARRY NEST. All Rights Reserved.</p>

            <div class="footer-bottom-info">
                <a href="/user/privacy-policy">Privacy Policy</a>
                <a href="/user/terms">Terms & Conditions</a>
                <a href="/user/return-policy">Return Policy</a>
            </div>
        </div>
    </footer>

</body>
</html>