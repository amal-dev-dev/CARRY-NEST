<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carry Nest Products</title>

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/Styles/user/products.css">
</head>
<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">
            CARRY NEST
        </div>

                <div class="nav-icons">

                    <% if(user){ %>

                        <a href="/user/cart" class="cart-link">
                            <i class="fa-solid fa-cart-shopping"></i>

                            <% if (cartCount > 0) { %>
                                <span class="cart-badge"><%= cartCount %></span>
                            <% } %>
                        </a>
                        
                        <a href="/user/wishlist" class="wishlist-link">
                            <i class="fa-regular fa-heart"></i>

                            <% if (wishlistCount > 0) { %>
                                <span class="wishlist-badge">
                                    <%= wishlistCount %>
                                </span>
                            <% } %>
                        </a>

                        <a href="/user/profile" style="color:black;">
                            <i class="fa-regular fa-user"></i>
                        </a>

                    <% } else { %>

                        <a href="/user/login" class="login-btn">
                            Login
                        </a>

                        <a href="/user/signup" class="signup-btn">
                            Sign Up
                        </a>

                    <% } %>

                </div>

    </nav>

    <!-- MOBILE FILTER BUTTON -->

    <div class="mobile-filter">
        <button id="filterBtn">
            <i class="fa-solid fa-filter"></i>
            Filters
        </button>
    </div>

    <!-- MAIN -->

    <section class="products-page">

        <aside class="sidebar" id="sidebar">

            <form id="filterForm" method="GET" action="/user/products">

                <input type="hidden" name="sort" value="<%= sort || '' %>">
                <input type="hidden" name="search" value="<%= search || '' %>">

                <input
                    type="hidden"
                    id="categoryInput"
                    name="category"
                    value="<%= category || '' %>"
                >

                <input
                    type="hidden"
                    id="brandInput"
                    name="brand"
                    value="<%= brand || '' %>"
                >

                <input
                    type="hidden"
                    id="colorInput"
                    name="color"
                    value="<%= color || '' %>"
                >

                <!-- CATEGORY -->
                <div class="filter-box">
                    <div class="filter-header">
                        <h4>Category</h4>
                        <span><%= category ? '−' : '+' %></span>
                    </div>

                    <div class="filter-content <%= category ? 'active' : '' %>">
                        <% categories.forEach(cat => { %>
                            <label>
                                <input
                                    type="checkbox"
                                    class="category-filter"
                                    value="<%= cat._id %>"
                                    <%= String(category) === String(cat._id) ? "checked" : "" %>
                                >
                                <%= cat.name %>
                            </label>
                        <% }) %>
                    </div>
                </div>

                <!-- BRAND -->
                <div class="filter-box">
                    <div class="filter-header">
                        <h4>Brand</h4>
                        <span><%= brand ? '−' : '+' %></span>
                    </div>

                    <div class="filter-content <%= brand ? 'active' : '' %>">
                        <% brands.forEach(item => { %>
                            <label>
                                <input
                                    type="checkbox"
                                    class="brand-filter"
                                    value="<%= item.name %>"
                                    <%= brand === item.name ? "checked" : "" %>
                                >
                                <%= item.name %>
                            </label>
                        <% }) %>
                    </div>
                </div>

                <!-- COLOR -->
                <div class="filter-box">
                    <div class="filter-header">
                        <h4>Color</h4>
                        <span><%= color ? '−' : '+' %></span>
                    </div>

                    <div class="filter-content <%= color ? 'active' : '' %>">
                        <% ['Black', 'Blue', 'Brown', 'Grey'].forEach(c => { %>
                            <label>
                                <input
                                    type="checkbox"
                                    class="color-filter"
                                    value="<%= c %>"
                                    <%= color === c ? "checked" : "" %>
                                >
                                <%= c %>
                            </label>
                        <% }) %>
                    </div>
                </div>

                <!-- PRICE -->
                <div class="filter-box">
                    <div class="filter-header">
                        <h4>Price</h4>
                        <span>+</span>
                    </div>

                    <div class="filter-content">
                        <label>
                            <input type="radio" name="price" value="0-1000"
                                <%= price === '0-1000' ? 'checked' : '' %>>
                            ₹0 - ₹1000
                        </label>

                        <label>
                            <input type="radio" name="price" value="1000-3000"
                                <%= price === '1000-3000' ? 'checked' : '' %>>
                            ₹1000 - ₹3000
                        </label>

                        <label>
                            <input type="radio" name="price" value="3000-5000"
                                <%= price === '3000-5000' ? 'checked' : '' %>>
                            ₹3000 - ₹5000
                        </label>

                        <label>
                            <input type="radio" name="price" value=""
                                <%= !price ? 'checked' : '' %>>
                            All prices
                        </label>
                    </div>
                </div>

            </form>
        </aside>


    <!-- PRODUCTS -->

    <main class="products-content">

        <div class="breadcrumb">

            <a href="/user/home">Home</a>

            <span>/</span>

            <span>Products</span>

        </div>

            <h2>Our Collection Of Products</h2>

            <% if (message) { %>
                <div class="unavailable-message">
                    <%= message %>
                </div>
            <% } %>

            <form action="/user/products" method="GET" class="controls">

            <input type="hidden" name="category" value="<%= category %>">
            <input type="hidden" name="price" value="<%= price %>">

            <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="Search Product"
                class="product-search"
            >

            <button type="submit">
                Search
            </button>

            <a href="/user/products" class="clear-btn">
                Clear
            </a>

            <select name="sort" onchange="this.form.submit()">

                <option value="">Sort By</option>

                <option value="oldest"
                    <%= sort === "oldest" ? "selected" : "" %>>
                    Oldest First
                </option>

                <option value="low-high"
                    <%= sort === "low-high" ? "selected" : "" %>>
                    Price Low To High
                </option>

                <option value="high-low"
                    <%= sort === "high-low" ? "selected" : "" %>>
                    Price High To Low
                </option>

                <option value="a-z"
                    <%= sort === "a-z" ? "selected" : "" %>>
                    A-Z
                </option>

                <option value="z-a"
                    <%= sort === "z-a" ? "selected" : "" %>>
                    Z-A
                </option>

            </select>

        </form>

        <!-- GRID -->
        <div class="product-grid">

            <% products.forEach(product => { %>

                <div class="product-card">

                    <button
                        type="button"
                        class="wishlist-btn <%= wishlistProductIds && wishlistProductIds.includes(product._id.toString()) ? 'active' : '' %>"
                        data-product-id="<%= product._id %>"
                        data-variant-id="<%= product.variants[0]?._id || '' %>"
                        title="<%= wishlistProductIds && wishlistProductIds.includes(product._id.toString()) ? 'Remove from wishlist' : 'Add to wishlist' %>"
                        aria-label="Wishlist"
                    >
                        <i class="<%= wishlistProductIds && wishlistProductIds.includes(product._id.toString()) ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                    </button>

                    <a
                        href="/user/product-details/<%= product._id %>"
                        class="product-link"
                    >
                        <img
                            src="<%= product.productImage[0] %>"
                            alt="<%= product.productName %>"
                        >

                        <h4><%= product.productName %></h4>

                        <p>
                            ₹<%= product.variants[0]?.salePrice %>
                        </p>
                    </a>

                </div>

            <% }) %>

        </div>

        <div class="pagination">

            <% if(currentPage > 1){ %>

                <a href="?page=<%= currentPage-1 %>&search=<%= search %>&category=<%= category %>&brand=<%= brand %>&price=<%= price %>&sort=<%= sort %>">
                    Prev
                </a>

            <% } %>

            <% for(let i=1;i<=totalPages;i++){ %>

                <a
                    href="?page=<%= i %>&search=<%= search %>&category=<%= category %>&brand=<%= brand %>&price=<%= price %>&sort=<%= sort %>"
                    class="<%= currentPage===i ? 'active' : '' %>"
                >
                    <%= i %>
                </a>

            <% } %>

            <% if(currentPage < totalPages){ %>

                <a href="?page=<%= currentPage+1 %>&search=<%= search %>&category=<%= category %>&brand=<%= brand %>&price=<%= price %>&sort=<%= sort %>">
                    Next
                </a>

            <% } %>

        </div>

    </main>

</section>

<!-- FOOTER -->

<footer>
    <div class="footer-container">

        <!-- Brand -->
        <div class="footer-col">
            <h3>CARRY NEST</h3>
            <p class="footer-tagline">
                Carry Your World. Your Style, Your Journey.
            </p>
            <p>
                Discover stylish, durable and functional bags
                designed for everyday life, work and travel.
            </p>
        </div>

        <!-- Shop -->
        <div class="footer-col">
            <h4>Shop</h4>

            <a href="/user/products">All Products</a>
            <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
            <a href="/user/products?category=Office%20Bags">Office Bags</a>
            <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
            <a href="/user/products?category=School%20Bags">School Bags</a>
            <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
            <h4>Quick Links</h4>
            <a href="/user/home">Home</a>
            <a href="/user/about">About Us</a>
            <a href="/user/profile">My Account</a>
            <a href="/user/orders">My Orders</a>
            <a href="/user/contact">Contact Us</a>
        </div>

        <!-- Contact -->
        <div class="footer-col footer-contact">
            <h4>Contact Us</h4>

            <p>
                <i class="fa-regular fa-envelope"></i>
                support@yourdomain.com
            </p>

            <p>
                <i class="fa-solid fa-phone"></i>
                +91 XXXXX XXXXX
            </p>

            <p>
                <i class="fa-solid fa-location-dot"></i>
                Kerala, India
            </p>

            <div class="social-icons">
                <a href="#" aria-label="Facebook">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
                <a href="#" aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>
                <a href="#" aria-label="WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="footer-bottom">
        <p>© 2026 CARRY NEST. All Rights Reserved.</p>

        <div class="footer-bottom-info">
            <a href="/user/privacy-policy">Privacy Policy</a>
            <a href="/user/terms">Terms & Conditions</a>
            <a href="/user/return-policy">Return Policy</a>
        </div>
    </div>
</footer>

<script>

    // Filter accordion dropdowns
    document.querySelectorAll(".filter-header").forEach(header => {
        header.addEventListener("click", function () {
            const content = this.nextElementSibling;
            const icon = this.querySelector("span");    

            content.classList.toggle("active");

            if (icon) {
                icon.textContent = content.classList.contains("active")
                    ? "−"
                    : "+";
            }
        });
    });

    const filterForm = document.getElementById("filterForm");
    const categoryInput = document.getElementById("categoryInput");
    const brandInput = document.getElementById("brandInput");
    const colorInput = document.getElementById("colorInput");

    const sidebar = document.getElementById("sidebar");

    if (filterBtn && sidebar) {
        filterBtn.addEventListener("click", () => {
            sidebar.classList.toggle("show");
        });
    }

    const categoryCheckboxes = document.querySelectorAll(".category-filter");

    const brandCheckboxes = document.querySelectorAll(".brand-filter");

    const colorCheckboxes = document.querySelectorAll(".color-filter");

    // Category: single selection
    categoryCheckboxes.forEach(checkbox => {
        checkbox.addEventListener("change", function () {
            categoryInput.value = this.checked ? this.value : "";
            filterForm.submit();
        });
    });

    // Brand: single selection
    brandCheckboxes.forEach(checkbox => {
        checkbox.addEventListener("change", function () {
            brandCheckboxes.forEach(cb => {
                if (cb !== this) cb.checked = false;
            });

            brandInput.value = this.checked ? this.value : "";
            filterForm.submit();
        });
    });

    // Color: single selection
    colorCheckboxes.forEach(checkbox => {
        checkbox.addEventListener("change", function () {
            colorCheckboxes.forEach(cb => {
                if (cb !== this) cb.checked = false;
            });

            colorInput.value = this.checked ? this.value : "";
            filterForm.submit();
        });
    });

    // Price filter
    document.querySelectorAll('#filterForm input[name="price"]')
        .forEach(radio => {
            radio.addEventListener("change", () => filterForm.submit());
        });


    //wishlist
    document.querySelectorAll(".wishlist-btn").forEach(button => {
        button.addEventListener("click", async function (event) {
            event.preventDefault();
            event.stopPropagation();

            <% if (!user) { %>
                window.location.href = "/user/login";
                return;
            <% } %>

            const productId = this.dataset.productId;
            const variantId = this.dataset.variantId;

            if (!variantId) {
                alert("Product variant not found.");
                return;
            }

            try {
                this.disabled = true;

                const response = await fetch(
                    `/user/wishlist/toggle/${productId}`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ variantId })
                    }
                );

                const result = await response.json();

                if (!response.ok || !result.success) {
                    alert(result.message || "Unable to update wishlist.");
                    return;
                }

                const icon = this.querySelector("i");
                const isAdded = result.action === "added";

                this.classList.toggle("active", isAdded);
                icon.classList.toggle("fa-solid", isAdded);
                icon.classList.toggle("fa-regular", !isAdded);

                this.title = isAdded
                    ? "Remove from wishlist"
                    : "Add to wishlist";

                this.setAttribute(
                    "aria-label",
                    this.title
                );

                // Update navbar wishlist badge, if present
                const badge = document.querySelector(".wishlist-badge");

                if (badge) {
                    badge.textContent = result.wishlistCount;
                    badge.style.display = result.wishlistCount > 0
                        ? ""
                        : "none";
                }

            } catch (error) {
                console.error("Wishlist request failed:", error);
                alert("Something went wrong. Please try again.");
            } finally {
                this.disabled = false;
            }
        });
    });

</script>

</body>
</html>