<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success</title>

    <link rel="stylesheet" href="/Styles/user/order-success.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

    <!-- =========================
            NAVBAR
    ========================== -->
    <nav class="navbar">

        <div class="logo">
            CARRY NEST
        </div>

        <div class="nav-icons">
            <a href="/user/cart">
                <i class="fa-solid fa-cart-shopping"></i>
            </a>

            <a href="/user/wishlist">
                <i class="fa-regular fa-heart"></i>
            </a>

            <a href="/user/profile">
                <i class="fa-regular fa-user"></i>
            </a>
        </div>

    </nav>

    <!-- =========================
            SUCCESS SECTION
    ========================== -->
<section class="success-section">
    <div class="success-card">

        <div class="success-icon">
            <i class="fa-solid fa-check"></i>
        </div>

        <h1>Order Placed Successfully!</h1>
        <p class="success-text">
            Thank you for shopping with Carry Nest. Your order has been placed successfully.
        </p>

        <div class="order-info">
            <div class="info-row">
                <span>Order Number</span>
                <strong>#<%= order.orderId || order._id.toString().slice(-8).toUpperCase() %></strong>
            </div>

            <% if (order.products && order.products.length > 0) { %>

                <div class="info-row">
                    <span>Total Amount</span>
                    <strong>
                        ₹<%= Number(order.totalAmount || 0).toFixed(2) %>
                    </strong>
                </div>
                
            <% } %>

            <div class="info-row">
                <span>Payment Method</span>
                <strong><%= order.paymentMethod %></strong>
            </div>

            <div class="info-row">
                <span>Estimated Delivery</span>
                <strong>
                    <%= new Date(order.deliveryDate).toLocaleDateString("en-IN", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    }) %>
                </strong>
            </div>
        </div>

        <div class="success-actions">
            <a href="/user/orders" class="btn-dark">View Orders</a>
            <a href="/user/products" class="btn-light">Continue Shopping</a>
        </div>

    </div>
</section>

    <!-- =========================
            FOOTER
    ========================== -->
    <footer>
        <div class="footer-container">

            <!-- Brand -->
            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p class="footer-tagline">
                    Carry Your World. Your Style, Your Journey.
                </p>
                <p>
                    Discover stylish, durable and functional bags
                    designed for everyday life, work and travel.
                </p>
            </div>

            <!-- Shop -->
            <div class="footer-col">
                <h4>Shop</h4>

                <a href="/user/products">All Products</a>
                <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
                <a href="/user/products?category=Office%20Bags">Office Bags</a>
                <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
                <a href="/user/products?category=School%20Bags">School Bags</a>
                <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
            </div>

            <!-- Quick Links -->
            <div class="footer-col">
                <h4>Quick Links</h4>
                <a href="/user/home">Home</a>
                <a href="/user/about">About Us</a>
                <a href="/user/profile">My Account</a>
                <a href="/user/orders">My Orders</a>
                <a href="/user/contact">Contact Us</a>
            </div>

            <!-- Contact -->
            <div class="footer-col footer-contact">
                <h4>Contact Us</h4>

                <p>
                    <i class="fa-regular fa-envelope"></i>
                    support@yourdomain.com
                </p>

                <p>
                    <i class="fa-solid fa-phone"></i>
                    +91 XXXXX XXXXX
                </p>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Kerala, India
                </p>

                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 CARRY NEST. All Rights Reserved.</p>

            <div class="footer-bottom-info">
                <a href="/user/privacy-policy">Privacy Policy</a>
                <a href="/user/terms">Terms & Conditions</a>
                <a href="/user/return-policy">Return Policy</a>
            </div>
        </div>
    </footer>

</body>
</html>