<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carry Nest - Sign In</title>
    <link rel="stylesheet" href="/Styles/user/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <header class="main-header">
        <div class="container">
            <h1 class="logo">CARRY NEST</h1>
        </div>
    </header>

    <main class="login-section">
        <div class="login-card">
            <h2>Sign in To Your Account</h2>
            <p class="subtitle">Please login to continue to your account</p>

            <div class="social-login">
                <a href="/auth/google" style="text-decoration: none;">
                    <button class="social-btn"><img src="https://www.svgrepo.com/show/355037/google.svg" alt="Google"> Sign up</button>
                </a>
            </div>


            <form class="login-form" action="/user/login" method="POST" id="loginForm" novalidate>
                <div class="input-group">
                    <label>Email / Phone</label>
                    <input
                        type="text"
                        name="email"
                        placeholder="Enter email or phone number"
                        autocomplete="username"
                    >
                </div>

                <div class="input-group">
                    <label>Password</label>
                    <div class="password-wrapper">
                        <input
                            type="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                        >
                        <i class="far fa-eye"></i>
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" name="rememberMe">
                        Remember Me
                    </label>
                    <a href="/user/forgot-password" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-primary">SIGN IN</button>
            </form>


            <p class="signup-prompt">Don't have an account? <a href="/user/signup">Sign up</a></p>
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-grid">
            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p>Lorem ipsum dolor sit amet consectetur. Purus in etiam risus ut sem eu urna. Massa feugiat consequat nec libero.</p>
            </div>
            <div class="footer-col">
                <h4>Service</h4>
                <ul>
                    <li><a href="#">Laptop Bags</a></li>
                    <li><a href="#">Trekking Bags</a></li>
                    <li><a href="#">School Bags</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Company</h4>
                <ul>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Features</a></li>
                    <li><a href="#">Our Team</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Contact Us</h4>
                <div class="contact-form">
                    <input type="text" placeholder="Your Email/Phone no.">
                    <button>Send</button>
                </div>
                <div class="social-icons">
                    <i class="fab fa-facebook"></i>
                    <i class="fab fa-instagram"></i>
                    <i class="fab fa-whatsapp"></i>
                    <i class="fab fa-linkedin"></i>
                </div>
            </div>
        </div>
        <div class="container bottom-bar">
            <p>Copyright Tanah Air Studio</p>
            <div class="contact-info">
                <span><i class="fas fa-map-marker-alt"></i> 8819 Ohio St, South Gate, CA 90280</span>
                <span><i class="fas fa-envelope"></i> CrossLine@hello.com</span>
                <span><i class="fas fa-phone"></i> +91 386-688-3295</span>
            </div>
        </div>
    </footer>
 
    <script>
    document.addEventListener("DOMContentLoaded", () => {

        // Display server-side error messages safely
        const message = <%- JSON.stringify(
            typeof message !== "undefined" ? message : ""
        ) %>;

        if (message) {
            Swal.fire({
                icon: "error",
                title: "Login Failed",
                text: message,
                confirmButtonText: "OK"
            });
        }

        const loginForm = document.getElementById("loginForm");

        loginForm.addEventListener("submit", (e) => {
            const emailOrPhone =
                loginForm.querySelector('[name="email"]').value.trim();

            const password =
                loginForm.querySelector('[name="password"]').value;

            let title = "";
            let errorMessage = "";

            if (!emailOrPhone && !password) {
                title = "Missing Fields";
                errorMessage = "Please enter your email/phone and password.";
            } else if (!emailOrPhone) {
                title = "Email / Phone Required";
                errorMessage = "Please enter your email address or phone number.";
            } else if (!password) {
                title = "Password Required";
                errorMessage = "Please enter your password.";
            } else if (
                emailOrPhone.includes("@") &&
                !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailOrPhone)
            ) {
                title = "Invalid Email";
                errorMessage = "Please enter a valid email address.";
            } else if (
                !emailOrPhone.includes("@") &&
                !/^[6-9]\d{9}$/.test(emailOrPhone)
            ) {
                title = "Invalid Phone Number";
                errorMessage = "Enter a valid 10-digit Indian mobile number.";
            }

            if (errorMessage) {
                e.preventDefault();

                Swal.fire({
                    icon: "warning",
                    title: title,
                    text: errorMessage,
                    confirmButtonText: "OK"
                });
            }
        });

        // Show/hide password
        document.querySelectorAll(".password-wrapper .fa-eye").forEach(icon => {
            icon.addEventListener("click", () => {
                const input = icon.previousElementSibling;

                input.type = input.type === "password" ? "text" : "password";

                icon.classList.toggle("fa-eye");
                icon.classList.toggle("fa-eye-slash");
            });
        });

    });
    </script>

</body>
</html>