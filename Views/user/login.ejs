<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carry Nest - Sign In</title>
    <link rel="stylesheet" href="/Styles/user/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <header class="main-header">
        <div class="container">
            <h1 class="logo">CARRY NEST</h1>
        </div>
    </header>

    <main class="login-section">
        <div class="login-card">
            <h2>Sign in To Your Account</h2>
            <p class="subtitle">Please login to continue to your account</p>

            <div class="social-login">
                <a href="/auth/google" style="text-decoration: none;">
                    <button class="social-btn"><img src="https://www.svgrepo.com/show/355037/google.svg" alt="Google"> Sign up</button>
                </a>
            </div>


            <form class="login-form" action="/user/login" method="POST" id="loginForm" novalidate>
                <div class="input-group">
                    <label>Email / Phone</label>
                    <input
                        type="text"
                        name="email"
                        placeholder="Enter email or phone number"
                        autocomplete="username"
                    >
                </div>

                <div class="input-group">
                    <label>Password</label>
                    <div class="password-wrapper">
                        <input
                            type="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                        >
                        <i class="far fa-eye"></i>
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember-me">
                        <input type="checkbox" name="rememberMe">
                        Remember Me
                    </label>
                    <a href="/user/forgot-password" class="forgot-link">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-primary">SIGN IN</button>
            </form>


            <p class="signup-prompt">Don't have an account? <a href="/user/signup">Sign up</a></p>
        </div>
    </main>


    <footer>
        <div class="footer-container">

            <!-- Brand -->
            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p class="footer-tagline">
                    Carry Your World. Your Style, Your Journey.
                </p>
                <p>
                    Discover stylish, durable and functional bags
                    designed for everyday life, work and travel.
                </p>
            </div>

            <!-- Shop -->
            <div class="footer-col">
                <h4>Shop</h4>

                <a href="/user/products">All Products</a>
                <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
                <a href="/user/products?category=Office%20Bags">Office Bags</a>
                <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
                <a href="/user/products?category=School%20Bags">School Bags</a>
                <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
            </div>

            <!-- Quick Links -->
            <div class="footer-col">
                <h4>Quick Links</h4>
                <a href="/user/home">Home</a>
                <a href="/user/about">About Us</a>
                <a href="/user/profile">My Account</a>
                <a href="/user/orders">My Orders</a>
                <a href="/user/contact">Contact Us</a>
            </div>

            <!-- Contact -->
            <div class="footer-col footer-contact">
                <h4>Contact Us</h4>

                <p>
                    <i class="fa-regular fa-envelope"></i>
                    support@yourdomain.com
                </p>

                <p>
                    <i class="fa-solid fa-phone"></i>
                    +91 XXXXX XXXXX
                </p>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Kerala, India
                </p>

                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 CARRY NEST. All Rights Reserved.</p>

            <div class="footer-bottom-info">
                <a href="/user/privacy-policy">Privacy Policy</a>
                <a href="/user/terms">Terms & Conditions</a>
                <a href="/user/return-policy">Return Policy</a>
            </div>
        </div>
    </footer>

 
    <script>

        document.addEventListener("DOMContentLoaded", () => {

        // Display server-side messages safely
        const message = <%- JSON.stringify(
            typeof message !== "undefined" ? message : null
        ) %>;

        if (message) {

            // Signup success message (object)
            if (typeof message === "object") {

                Swal.fire({
                    icon: message.type || "success",
                    title: message.title || "Success",
                    text: message.text || "",
                    confirmButtonText: "OK",
                    confirmButtonColor: "#000",
                    timer: 3000,
                    timerProgressBar: true
                });

            }

            // Login validation error (string)
            else if (typeof message === "string") {

                Swal.fire({
                    icon: "error",
                    title: "Login Failed",
                    text: message,
                    confirmButtonText: "OK",
                    confirmButtonColor: "#000"
                });

            }
        }

            const loginForm = document.getElementById("loginForm");

            loginForm.addEventListener("submit", (e) => {
                const emailOrPhone =
                    loginForm.querySelector('[name="email"]').value.trim();

                const password =
                    loginForm.querySelector('[name="password"]').value;

                let title = "";
                let errorMessage = "";

                if (!emailOrPhone && !password) {
                    title = "Missing Fields";
                    errorMessage = "Please enter your email/phone and password.";
                } else if (!emailOrPhone) {
                    title = "Email / Phone Required";
                    errorMessage = "Please enter your email address or phone number.";
                } else if (!password) {
                    title = "Password Required";
                    errorMessage = "Please enter your password.";
                } else if (
                    emailOrPhone.includes("@") &&
                    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailOrPhone)
                ) {
                    title = "Invalid Email";
                    errorMessage = "Please enter a valid email address.";
                } else if (
                    !emailOrPhone.includes("@") &&
                    !/^[6-9]\d{9}$/.test(emailOrPhone)
                ) {
                    title = "Invalid Phone Number";
                    errorMessage = "Enter a valid 10-digit Indian mobile number.";
                }

                if (errorMessage) {
                    e.preventDefault();

                    Swal.fire({
                        icon: "warning",
                        title: title,
                        text: errorMessage,
                        confirmButtonText: "OK"
                    });
                }
            });

            // Show/hide password
            document.querySelectorAll(".password-wrapper .fa-eye").forEach(icon => {
                icon.addEventListener("click", () => {
                    const input = icon.previousElementSibling;

                    input.type = input.type === "password" ? "text" : "password";

                    icon.classList.toggle("fa-eye");
                    icon.classList.toggle("fa-eye-slash");
                });
            });

        });

    </script>

</body>
</html>