<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.productName %></title>

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/Styles/user/product-details.css">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<!-- NAVBAR -->

<nav class="navbar">

    <a href="/" class="logo">
        CARRY NEST
    </a>

            <div class="nav-icons">

                <% if(user){ %>

                    <a href="/user/cart" class="cart-link">
                        <i class="fa-solid fa-cart-shopping"></i>

                        <% if (cartCount > 0) { %>
                            <span class="cart-badge"><%= cartCount %></span>
                        <% } %>
                    </a>

                    <a href="/user/wishlist" class="wishlist-link">
                        <i class="fa-regular fa-heart"></i>

                        <% if (wishlistCount > 0) { %>
                            <span class="wishlist-badge">
                                <%= wishlistCount %>
                            </span>
                        <% } %>
                    </a>

                    <a href="/user/profile" style="color:black;">
                        <i class="fa-regular fa-user"></i>
                    </a>

                <% } else { %>

                    <a href="/user/login" class="login-btn">
                        Login
                    </a>

                    <a href="/user/signup" class="signup-btn">
                        Sign Up
                    </a>

                <% } %>

            </div>

</nav>

<!-- BREADCRUMB -->

<div class="breadcrumb">

    <a href="/user/home">Home</a>

    <span>/</span>

    <a href="/user/products">Products</a>

    <span>/</span>

    <span><%= product.productName %></span>

</div>

<!-- PRODUCT DETAILS -->

<section class="product-details">

    <div class="product-wrapper">

        <!-- IMAGE SECTION -->

        <div class="product-images">

            <div class="main-image">

                <img
                    id="mainProductImage"
                    src="<%= product.productImage[0] %>"
                    alt="<%= product.productName %>"
                >

            </div>

            <div class="thumbnail-gallery">

                <% product.productImage.forEach(image => { %>

                    <img
                        src="<%= image %>"
                        onclick="changeImage(this)"
                        alt=""
                    >

                <% }) %>

            </div>

        </div>

        <!-- PRODUCT INFO -->

        <div class="product-info">

            <h1>
                <%= product.productName %>
            </h1>

            <div class="rating-summary">

                ⭐ <%= averageRating.toFixed(1) %>

                (<%= reviews.length %> Reviews)

            </div>

            <p class="brand">
                Brand: <%= product.brand %>
            </p>

            <div class="price-box">

                <span class="sale-price" id="price">
                    ₹<%= defaultVariant ? defaultVariant.salePrice : 0 %>
                </span>

                <span class="regular-price" id="regularPrice">
                    <%= defaultVariant && defaultVariant.regularPrice ? `₹${defaultVariant.regularPrice}` : '' %>
                </span>

                <span class="discount" id="discountText">
                    <%= discountPercentage %>% OFF
                </span>

            </div>

            <p class="description">
                <%= product.description %>
            </p>

            <div class="product-meta">

                <p>
                    <strong>Category:</strong>
                    <%= product.category?.name || 'N/A' %>
                </p>

                <div class="product-colors">

                    <strong>Colors:</strong>

                    <% product.colors.forEach(color => { %>

                        <span
                            class="color-circle"
                            data-color="<%= color %>">
                        </span>

                    <% }) %>

                </div>

                <p>
                    <strong>Stock:</strong>
                    <span id="stock">
                        <%= defaultVariant ? defaultVariant.stock : 0 %>
                    </span>
                </p>

            </div>

            <div class="variant-section">
                <form id="addToCartForm" action="/user/add-to-cart" method="POST">

                    <h4>SIZE CONFIGURATION</h4>

                    <div class="variant-buttons">
                        <% if (filteredVariants.length > 0) { %>
                        <% filteredVariants.forEach((variant, index) => { %>
                            <label class="variant-option">
                                <input
                                    type="radio"
                                    name="variantId"
                                    value="<%= variant._id %>"
                                    <%= index === 0 ? "checked" : "" %>
                                    hidden
                                >
                                <span class="variant-btn"><%= variant.size %></span>
                            </label>
                        <% }) %>
                        <% } else { %>
                            <p>No variants available</p>
                        <% } %>
                    </div>

                    <div class="quantity-box">
                        <button type="button">-</button>

                        <input
                            type="number"
                            name="quantity"
                            value="1"
                            min="1"
                        >

                        <button type="button">+</button>
                    </div>

                    <div class="action-buttons">

                        <% if (defaultVariant && defaultVariant.stock > 0) { %>
                            <button type="submit" id="addToCartBtn" class="add-cart-btn">
                                Add To Cart
                            </button>
                        <% } else { %>
                            <button type="button" id="addToCartBtn" class="add-cart-btn" disabled>
                                Out Of Stock
                            </button>
                        <% } %>

                        <% if (!wishlistExists) { %>
                            <button 
                                type="button" 
                                id="wishlistBtn" 
                                class="wishlist-btn"
                                data-product-id="<%= product._id %>">
                                <i class="fa-regular fa-heart"></i>
                            </button>
                        <% } else { %>
                            <button 
                                type="button" 
                                id="wishlistBtn" 
                                class="wishlist-btn active-wishlist"
                                data-product-id="<%= product._id %>">
                                <i class="fa-solid fa-heart"></i>
                            </button>
                        <% } %>

                    </div>

                </form>
                
            </div>

        </div>

    </div>

</section>

<!-- RELATED PRODUCTS -->

<section class="related-products">

    <h2>You Might Also Like</h2>

    <div class="related-grid">

        <% relatedProducts.forEach(item => { %>

            <a
                href="/user/product-details/<%= item._id %>"
                class="related-card"
            >

                <img
                    src="<%= item.productImage[0] %>"
                    alt="<%= item.productName %>"
                >

                <h4>
                    <%= item.productName %>
                </h4>

                <p>
                    ₹<%= item.variants[0]?.salePrice %>
                </p>

            </a>

        <% }) %>

    </div>

</section>

<section class="reviews-section">

    <h2>

        Customer Reviews

    </h2>

    <% if(reviews.length > 0){ %>

        <% reviews.forEach(review=>{ %>

            <div class="review-card">

                <h4>
                    <%= review.userId?.name || "User" %>
                </h4>

                <div class="stars">

                    <% for(let i=1;i<=5;i++){ %>

                        <% if(i <= review.rating){ %>
                            ★
                        <% } else { %>
                            ☆
                        <% } %>

                    <% } %>

                </div>

                <p>
                    <%= review.comment %>
                </p>

                <!-- Review Images -->

                <% if(review.image && review.image.length > 0){ %>

                    <div class="review-images">

                        <% review.image.forEach(img => { %>

                            <img
                                src="<%= img %>"
                                alt="Review Image"
                            >

                        <% }) %>

                    </div>

                <% } %>

                <small>
                    <%= review.createdAt.toDateString() %>
                </small>

            </div>

        <% }) %>

    <% } else { %>

        <p>

            No reviews yet.

        </p>

    <% } %>

</section>

<!-- FOOTER -->

<footer>

    <div class="footer-grid">

        <div>
            <h3>CARRY NEST</h3>
            <p>Premium Bags & Travel Accessories</p>
        </div>

        <div>
            <h4>Service</h4>
            <p>Shipping</p>
            <p>Returns</p>
            <p>Support</p>
        </div>

        <div>
            <h4>Company</h4>
            <p>About Us</p>
            <p>Contact</p>
            <p>Blog</p>
        </div>

        <div>

            <h4>Newsletter</h4>

            <input
                type="email"
                placeholder="Enter Email"
            >

            <button>
                Subscribe
            </button>

        </div>

    </div>

</footer>

<script id="variantsData" type="application/json">
    <%- JSON.stringify(filteredVariants) %>
</script>

<script>
document.querySelectorAll(".color-circle").forEach(circle => {
    circle.style.backgroundColor = circle.dataset.color;
});

function changeImage(img) {
    document.getElementById("mainProductImage").src = img.src;
}

const variants = JSON.parse(
    document.getElementById("variantsData").textContent
);

const radios = document.querySelectorAll('input[name="variantId"]');
const priceEl = document.getElementById("price");
const regularPriceEl = document.getElementById("regularPrice");
const stockEl = document.getElementById("stock");
const discountEl = document.getElementById("discountText");

function updateVariantDetails(variantId) {
    const selected = variants.find(v => String(v._id) === String(variantId));

    if (!selected) return;

    priceEl.textContent = `₹${selected.salePrice}`;
    stockEl.textContent = selected.stock;

    if (selected.regularPrice) {
        regularPriceEl.textContent = `₹${selected.regularPrice}`;

        const discount = Math.round(
            ((selected.regularPrice - selected.salePrice) / selected.regularPrice) * 100
        );

        discountEl.textContent = `${discount}% OFF`;
    } else {
        regularPriceEl.textContent = "";
        discountEl.textContent = "";
    }
}

radios.forEach(radio => {
    radio.addEventListener("change", function () {
        updateVariantDetails(this.value);
    });
});

const checkedVariant = document.querySelector('input[name="variantId"]:checked');
if (checkedVariant) {
    updateVariantDetails(checkedVariant.value);
}

document.addEventListener("DOMContentLoaded", () => {

    const wishlistBtn = document.getElementById("wishlistBtn");

    if (!wishlistBtn) return;

    wishlistBtn.addEventListener("click", async function () {

        const productId = this.dataset.productId;

        // Get currently selected variant
        const selectedVariant = document.querySelector(
            'input[name="variantId"]:checked'
        );

        if (!selectedVariant) {

            return Swal.fire({
                icon: "warning",
                title: "Select a size",
                text: "Please select a size before adding to wishlist"
            });

        }

        const variantId = selectedVariant.value;

        try {

            const response = await fetch(
                `/user/wishlist/toggle/${productId}`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({
                        variantId: variantId
                    })
                }
            );

            const data = await response.json();

            if (!data.success) {

                return Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: data.message
                });

            }

            if (data.action === "added") {

                this.classList.add("active-wishlist");

                this.innerHTML =
                    `<i class="fa-solid fa-heart"></i>`;

                Swal.fire({
                    icon: "success",
                    title: "Added",
                    text: data.message,
                    timer: 1200,
                    showConfirmButton: false
                });

            } else {

                this.classList.remove("active-wishlist");

                this.innerHTML =
                    `<i class="fa-regular fa-heart"></i>`;

                Swal.fire({
                    icon: "success",
                    title: "Removed",
                    text: data.message,
                    timer: 1200,
                    showConfirmButton: false
                });

            }

        } catch (err) {

            console.log("WISHLIST ERROR:", err);

            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong"
            });

        }

    });

});

const addToCartForm = document.getElementById("addToCartForm");

if (addToCartForm) {

    addToCartForm.addEventListener("submit", async function (e) {

        e.preventDefault();

        const variantId = document.querySelector('input[name="variantId"]:checked').value;
        const quantity = document.querySelector('input[name="quantity"]').value;

        try {

            const response = await fetch(this.action, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    variantId,
                    quantity
                })
            });

            const data = await response.json();

            if (data.success) {

                await Swal.fire({
                    icon: "success",
                    title: "Added!",
                    text: data.message,
                    timer: 1500,
                    showConfirmButton: false
                });

                window.location.href = "/user/cart";

            } else {

                Swal.fire({
                    icon: "warning",
                    title: "Oops!",
                    text: data.message
                });

            }

        } catch (err) {

            console.log(err);

            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong."
            });

        }

    });

}
</script>

</body>
</html>