<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.productName %></title>

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/Styles/user/product-details.css">
</head>
<body>

<!-- NAVBAR -->

<nav class="navbar">

    <a href="/" class="logo">
        CARRY NEST
    </a>

            <div class="nav-icons">

                <% if(user){ %>

                    <a href="/user/cart" style="color:black;">
                        <i class="fa-solid fa-cart-shopping"></i>
                    </a>

                    <a href="/user/wishlist" style="color:black;">
                        <i class="fa-regular fa-heart"></i>
                    </a>

                    <a href="/user/profile" style="color:black;">
                        <i class="fa-regular fa-user"></i>
                    </a>

                <% } else { %>

                    <a href="/user/login" class="login-btn">
                        Login
                    </a>

                    <a href="/user/signup" class="signup-btn">
                        Sign Up
                    </a>

                <% } %>

            </div>

</nav>

<!-- BREADCRUMB -->

<div class="breadcrumb">

    <a href="/user/home">Home</a>

    <span>/</span>

    <a href="/user/products">Products</a>

    <span>/</span>

    <span><%= product.productName %></span>

</div>

<!-- PRODUCT DETAILS -->

<section class="product-details">

    <div class="product-wrapper">

        <!-- IMAGE SECTION -->

        <div class="product-images">

            <div class="main-image">

                <img
                    id="mainProductImage"
                    src="<%= product.productImage[0] %>"
                    alt="<%= product.productName %>"
                >

            </div>

            <div class="thumbnail-gallery">

                <% product.productImage.forEach(image => { %>

                    <img
                        src="<%= image %>"
                        onclick="changeImage(this)"
                        alt=""
                    >

                <% }) %>

            </div>

        </div>

        <!-- PRODUCT INFO -->

        <div class="product-info">

            <h1>
                <%= product.productName %>
            </h1>

            <div class="rating-summary">

                ⭐ <%= averageRating.toFixed(1) %>

                (<%= reviews.length %> Reviews)

            </div>

            <p class="brand">
                Brand: <%= product.brand %>
            </p>

            <div class="price-box">

                <span class="sale-price" id="price">
                    ₹<%= product.variants[0]?.salePrice %>
                </span>

                <% if(product.variants[0]?.regularPrice){ %>

                    <span class="regular-price" id="regularPrice">
                        ₹<%= product.variants[0]?.regularPrice %>
                    </span>

                <% } %>

                    <span class="discount">
                        <%= discountPercentage %>% OFF
                    </span>

            </div>

            <p class="description">
                <%= product.description %>
            </p>

            <div class="product-meta">

                <p>
                    <strong>Category:</strong>
                    <%= product.category?.name || 'N/A' %>
                </p>

                <div class="product-colors">

                    <strong>Colors:</strong>

                    <% product.colors.forEach(color => { %>

                        <span
                            class="color-circle"
                            data-color="<%= color %>">
                        </span>

                    <% }) %>

                </div>

                    <p>
                        <strong>Stock:</strong>
                        <span id="stock">
                            <%= product.variants[0]?.stock %>
                        </span>
                    </p>

            </div>

            <div class="variant-section">

                <h4>Variants</h4>

                <% product.variants.forEach((variant,index)=>{ %>

                    <% if(variant.stock > 0){ %>

                        <label>

                            <input
                                type="radio"
                                name="variant"
                                value="<%= index %>"
                            >

                            <%= variant.size %>

                        </label>

                    <% } %>

                <% }) %>

            </div>

            <div class="quantity-box">

                <button>-</button>

                <input
                    type="number"
                    value="1"
                    min="1"
                    max="<%= product.variants.reduce((sum,v)=>sum+v.stock,0) %>"
                >

                <button>+</button>

            </div>

            <form
                action="/user/add-to-cart/<%= product._id %>"
                method="POST"
            >

                <% if(product.variants[0]?.stock > 0){ %>

                    <button
                        type="submit"
                        class="add-cart-btn"
                    >
                        Add To Cart
                    </button>

                <% } else { %>

                    <button
                        type="button"
                        class="add-cart-btn"
                        disabled
                    >
                        Out Of Stock
                    </button>

                <% } %>

            </form>

        </div>

    </div>

</section>

<!-- RELATED PRODUCTS -->

<section class="related-products">

    <h2>You Might Also Like</h2>

    <div class="related-grid">

        <% relatedProducts.forEach(item => { %>

            <a
                href="/user/product-details/<%= item._id %>"
                class="related-card"
            >

                <img
                    src="<%= item.productImage[0] %>"
                    alt="<%= item.productName %>"
                >

                <h4>
                    <%= item.productName %>
                </h4>

                <p>
                    ₹<%= item.variants[0]?.salePrice %>
                </p>

            </a>

        <% }) %>

    </div>

</section>

<section class="reviews-section">

    <h2>

        Customer Reviews

    </h2>

    <% if(reviews.length > 0){ %>

        <% reviews.forEach(review=>{ %>

            <div class="review-card">

                <h4>
                    <%= review.userId?.name || "User" %>
                </h4>

                <div class="stars">

                    <% for(let i=1;i<=5;i++){ %>

                        <% if(i <= review.rating){ %>
                            ★
                        <% } else { %>
                            ☆
                        <% } %>

                    <% } %>

                </div>

                <p>
                    <%= review.comment %>
                </p>

                <!-- Review Images -->

                <% if(review.image && review.image.length > 0){ %>

                    <div class="review-images">

                        <% review.image.forEach(img => { %>

                            <img
                                src="<%= img %>"
                                alt="Review Image"
                            >

                        <% }) %>

                    </div>

                <% } %>

                <small>
                    <%= review.createdAt.toDateString() %>
                </small>

            </div>

        <% }) %>

    <% } else { %>

        <p>

            No reviews yet.

        </p>

    <% } %>

</section>

<!-- FOOTER -->

<footer>

    <div class="footer-grid">

        <div>
            <h3>CARRY NEST</h3>
            <p>Premium Bags & Travel Accessories</p>
        </div>

        <div>
            <h4>Service</h4>
            <p>Shipping</p>
            <p>Returns</p>
            <p>Support</p>
        </div>

        <div>
            <h4>Company</h4>
            <p>About Us</p>
            <p>Contact</p>
            <p>Blog</p>
        </div>

        <div>

            <h4>Newsletter</h4>

            <input
                type="email"
                placeholder="Enter Email"
            >

            <button>
                Subscribe
            </button>

        </div>

    </div>

</footer>

<script>

document.querySelectorAll(".color-circle").forEach(circle => {
    circle.style.backgroundColor = circle.dataset.color;
});

function changeImage(img){

    document
    .getElementById("mainProductImage")
    .src = img.src;

}


const variants = JSON.parse(
    '<%- JSON.stringify(product.variants) %>'
);

const radios =
document.querySelectorAll(
    'input[name="variant"]'
);

const price =
document.getElementById("price");

const stock =
document.getElementById("stock");

radios.forEach(radio => {

    radio.addEventListener("change", () => {

        const selected =
        variants[radio.value];

        price.textContent =
        `₹${selected.salePrice}`;

        regularPrice.textContent =
        `₹${selected.regularPrice}`;

        stock.textContent =
        selected.stock;

    });

});

</script>

</body>
</html>