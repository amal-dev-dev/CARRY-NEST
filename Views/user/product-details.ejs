<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.productName %></title>

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet" href="/Styles/user/product-details.css">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<!-- NAVBAR -->


<nav class="navbar">

    <a href="/" class="logo">
        CARRY NEST
    </a>

    <div class="nav-icons">

        <% if (user) { %>

            <!-- Cart Icon -->
            <a href="/user/cart" class="cart-link">
                <i class="fa-solid fa-cart-shopping"></i>

                <span
                    id="cartCountBadge"
                    class="cart-badge"
                    style="<%= Number(cartCount || 0) > 0 ? '' : 'display: none;' %>"
                ><%= Number(cartCount || 0) %></span>
            </a>

            <!-- Wishlist Icon -->
            <a href="/user/wishlist" class="wishlist-link">
                <i class="fa-regular fa-heart"></i>

                <span
                    id="wishlistCountBadge"
                    class="wishlist-badge"
                    style="<%= (wishlistCount || 0) > 0 ? '' : 'display: none;' %>"
                ><%= wishlistCount || 0 %></span>
            </a>

            <!-- Profile Icon -->
            <a href="/user/profile" style="color: black;">
                <i class="fa-regular fa-user"></i>
            </a>

        <% } else { %>

            <a href="/user/login" class="login-btn">
                Login
            </a>

            <a href="/user/signup" class="signup-btn">
                Sign Up
            </a>

        <% } %>

    </div>

</nav>


<!-- BREADCRUMB -->

<div class="breadcrumb">

    <a href="/user/home">Home</a>

    <span>/</span>

    <a href="/user/products">Products</a>

    <span>/</span>

    <span><%= product.productName %></span>

</div>

<!-- PRODUCT DETAILS -->

<section class="product-details">

    <div class="product-wrapper">

        <!-- IMAGE SECTION -->

        <div class="product-images">

            <div class="main-image">

                <img
                    id="mainProductImage"
                    src="<%= product.productImage[0] %>"
                    alt="<%= product.productName %>"
                >

            </div>

            <div class="thumbnail-gallery">

                <% product.productImage.forEach(image => { %>

                    <img
                        src="<%= image %>"
                        onclick="changeImage(this)"
                        alt=""
                    >

                <% }) %>

            </div>

        </div>

        <!-- PRODUCT INFO -->

        <div class="product-info">

            <h1>
                <%= product.productName %>
            </h1>

            <div class="rating-summary">

                ⭐ <%= averageRating.toFixed(1) %>

                (<%= reviews.length %> Reviews)

            </div>

            <p class="brand">
                Brand: <%= product.brand %>
            </p>


            <div class="price-box">

                <span class="sale-price" id="price">
                    ₹<%= defaultVariant ? (offerPrice ?? defaultVariant.salePrice) : 0 %>
                </span>

                <span class="regular-price" id="regularPrice">
                    <%= defaultVariant && defaultVariant.regularPrice > (offerPrice ?? defaultVariant.salePrice)
                        ? `₹${defaultVariant.regularPrice}`
                        : '' %>
                </span>

                <span class="discount" id="discountText">
                    <%= discountPercentage %>% OFF
                </span>

                <span
                    id="offerBadge"
                    class="offer-badge"
                    style="<%= appliedOffer ? '' : 'display:none;' %>"
                >
                    <%= appliedOffer ? `${offerDiscountPercentage}% OFFER` : '' %>
                </span>

                <p
                    id="offerTitle"
                    class="offer-title"
                    style="<%= appliedOffer ? '' : 'display:none;' %>"
                >
                    <%= appliedOffer ? appliedOffer.title : '' %>
                </p>

            </div>  

            <p class="description">
                <%= product.description %>
            </p>

            <div class="product-meta">

                <p>
                    <strong>Category:</strong>
                    <%= product.category?.name || 'N/A' %>
                </p>

                <div class="product-colors">

                    <strong>Colors:</strong>

                    <% product.colors.forEach(color => { %>

                        <span
                            class="color-circle"
                            data-color="<%= color %>">
                        </span>

                    <% }) %>

                </div>

                <p>
                    <strong>Stock:</strong>
                    <span id="stock">
                        <%= defaultVariant ? defaultVariant.stock : 0 %>
                    </span>
                </p>

            </div>

            <div class="variant-section">
                <form id="addToCartForm" action="/user/add-to-cart" method="POST">

                    <h4>SIZE CONFIGURATION</h4>

                    <div class="variant-buttons">
                        <% if (filteredVariants.length > 0) { %>
                        <% filteredVariants.forEach((variant, index) => { %>
                            <label class="variant-option">
                                <input
                                    type="radio"
                                    name="variantId"
                                    value="<%= variant._id %>"
                                    <%= index === 0 ? "checked" : "" %>
                                    hidden
                                >
                                <span class="variant-btn"><%= variant.size %></span>
                            </label>
                        <% }) %>
                        <% } else { %>
                            <p>No variants available</p>
                        <% } %>
                    </div>

                    <div class="quantity-box">
                        <button type="button" id="decreaseQty">-</button>

                        <input
                            type="number"
                            id="quantity"
                            name="quantity"
                            value="1"
                            min="1"
                            max="5"
                        >

                        <button type="button" id="increaseQty">+</button>
                    </div>


                    <div class="action-buttons">

                        <%
                            const hasAvailableVariant = filteredVariants.some(
                                variant => Number(variant.stock) > 0
                            );

                            const initialVariant = filteredVariants.find(
                                variant => String(variant._id) === String(defaultVariant?._id)
                            ) || filteredVariants.find(
                                variant => Number(variant.stock) > 0
                            ) || filteredVariants[0];

                            const initialVariantAvailable = initialVariant &&
                                Number(initialVariant.stock) > 0;
                        %>

                        <button
                            type="submit"
                            id="addToCartBtn"
                            class="add-cart-btn"
                            <%= !hasAvailableVariant || !initialVariantAvailable ? "disabled" : "" %>
                        >
                            <%= !hasAvailableVariant || !initialVariantAvailable
                                ? "Out Of Stock"
                                : "Add To Cart" %>
                        </button>


                        <% if (!wishlistExists) { %>
                            <button 
                                type="button" 
                                id="wishlistBtn" 
                                class="wishlist-btn"
                                data-product-id="<%= product._id %>">
                                <i class="fa-regular fa-heart"></i>
                            </button>
                        <% } else { %>
                            <button 
                                type="button" 
                                id="wishlistBtn" 
                                class="wishlist-btn active-wishlist"
                                data-product-id="<%= product._id %>">
                                <i class="fa-solid fa-heart"></i>
                            </button>
                        <% } %>

                    </div>

                </form>
                
            </div>

        </div>

    </div>

</section>

<!-- RELATED PRODUCTS -->

<section class="related-products">

    <h2>You Might Also Like</h2>

    <div class="related-grid">

        <% relatedProducts.forEach(item => { %>

            <a
                href="/user/product-details/<%= item._id %>"
                class="related-card"
            >

                <img
                    src="<%= item.productImage[0] %>"
                    alt="<%= item.productName %>"
                >

                <h4>
                    <%= item.productName %>
                </h4>

                <p>
                    ₹<%= item.variants[0]?.salePrice %>
                </p>

            </a>

        <% }) %>

    </div>

</section>

<section class="reviews-section">

    <h2>

        Customer Reviews

    </h2>

    <% if(reviews.length > 0){ %>

        <% reviews.forEach(review=>{ %>

            <div class="review-card">

                <h4>
                    <%= review.userId?.name || "User" %>
                </h4>

                <div class="stars">

                    <% for(let i=1;i<=5;i++){ %>

                        <% if(i <= review.rating){ %>
                            ★
                        <% } else { %>
                            ☆
                        <% } %>

                    <% } %>

                </div>

                <p>
                    <%= review.comment %>
                </p>

                <!-- Review Images -->

                <% if(review.image && review.image.length > 0){ %>

                    <div class="review-images">

                        <% review.image.forEach(img => { %>

                            <img
                                src="<%= img %>"
                                alt="Review Image"
                            >

                        <% }) %>

                    </div>

                <% } %>

                <small>
                    <%= review.createdAt.toDateString() %>
                </small>

            </div>

        <% }) %>

    <% } else { %>

        <p>

            No reviews yet.

        </p>

    <% } %>

</section>

<!-- FOOTER -->

<footer>
    <div class="footer-container">

        <!-- Brand -->
        <div class="footer-col">
            <h3>CARRY NEST</h3>
            <p class="footer-tagline">
                Carry Your World. Your Style, Your Journey.
            </p>
            <p>
                Discover stylish, durable and functional bags
                designed for everyday life, work and travel.
            </p>
        </div>

        <!-- Shop -->
        <div class="footer-col">
            <h4>Shop</h4>

            <a href="/user/products">All Products</a>
            <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
            <a href="/user/products?category=Office%20Bags">Office Bags</a>
            <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
            <a href="/user/products?category=School%20Bags">School Bags</a>
            <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
            <h4>Quick Links</h4>
            <a href="/user/home">Home</a>
            <a href="/user/about">About Us</a>
            <a href="/user/profile">My Account</a>
            <a href="/user/orders">My Orders</a>
            <a href="/user/contact">Contact Us</a>
        </div>

        <!-- Contact -->
        <div class="footer-col footer-contact">
            <h4>Contact Us</h4>

            <p>
                <i class="fa-regular fa-envelope"></i>
                support@yourdomain.com
            </p>

            <p>
                <i class="fa-solid fa-phone"></i>
                +91 XXXXX XXXXX
            </p>

            <p>
                <i class="fa-solid fa-location-dot"></i>
                Kerala, India
            </p>

            <div class="social-icons">
                <a href="#" aria-label="Facebook">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
                <a href="#" aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>
                <a href="#" aria-label="WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="footer-bottom">
        <p>© 2026 CARRY NEST. All Rights Reserved.</p>

        <div class="footer-bottom-info">
            <a href="/user/privacy-policy">Privacy Policy</a>
            <a href="/user/terms">Terms & Conditions</a>
            <a href="/user/return-policy">Return Policy</a>
        </div>
    </div>
</footer>

<script id="variantsData" type="application/json">
    <%- JSON.stringify(filteredVariants) %>
</script>

<script>
document.querySelectorAll(".color-circle").forEach(circle => {
    circle.style.backgroundColor = circle.dataset.color;
});

function changeImage(img) {
    document.getElementById("mainProductImage").src = img.src;
}

const variants = JSON.parse(
    document.getElementById("variantsData").textContent
);

const radios = document.querySelectorAll('input[name="variantId"]');
const priceEl = document.getElementById("price");
const regularPriceEl = document.getElementById("regularPrice");
const stockEl = document.getElementById("stock");
const discountEl = document.getElementById("discountText");
const offerBadgeEl = document.getElementById("offerBadge");
const offerTitleEl = document.getElementById("offerTitle");
const addToCartBtn = document.getElementById("addToCartBtn");

// Offer percentage calculated by the backend
const offerDiscountPercentage = <%- JSON.stringify(typeof offerDiscountPercentage !== "undefined" ? offerDiscountPercentage : 0) %>;

const appliedOfferTitle = <%- JSON.stringify(typeof appliedOffer !== "undefined" && appliedOffer ? appliedOffer.title : "") %>;


function updateVariantDetails(variantId) {
    const selected = variants.find(
        v => String(v._id) === String(variantId)
    );

    if (!selected) return;

    const stock = Number(selected.stock || 0);
    const basePrice = Number(selected.salePrice || 0);

    const finalPrice = Math.round(
        basePrice * (1 - offerDiscountPercentage / 100)
    );

    // Update price and stock
    priceEl.textContent = `₹${finalPrice}`;
    stockEl.textContent = stock;

    // Update regular price and discount
    const regularPrice = Number(selected.regularPrice || 0);

    if (regularPrice > finalPrice) {
        regularPriceEl.textContent = `₹${regularPrice}`;

        const totalDiscount = Math.round(
            ((regularPrice - finalPrice) / regularPrice) * 100
        );

        discountEl.textContent = `${totalDiscount}% OFF`;
    } else {
        regularPriceEl.textContent = "";
        discountEl.textContent = "";
    }

    // Update offer information
    if (offerDiscountPercentage > 0 && appliedOfferTitle) {
        offerBadgeEl.textContent =
            `${offerDiscountPercentage}% OFFER`;

        offerBadgeEl.style.display = "inline-block";
        offerTitleEl.textContent = appliedOfferTitle;
        offerTitleEl.style.display = "block";
    } else {
        offerBadgeEl.style.display = "none";
        offerTitleEl.style.display = "none";
    }

    // Update Add To Cart button for the selected variant
    if (addToCartBtn) {
        if (stock > 0) {
            addToCartBtn.disabled = false;
            addToCartBtn.textContent = "Add To Cart";
            addToCartBtn.type = "submit";
        } else {
            addToCartBtn.disabled = true;
            addToCartBtn.textContent = "Out Of Stock";
            addToCartBtn.type = "button";
        }
    }
}


radios.forEach(radio => {
    radio.addEventListener("change", function () {
        updateVariantDetails(this.value);
    });
});

const checkedVariant = document.querySelector('input[name="variantId"]:checked');
if (checkedVariant) {
    updateVariantDetails(checkedVariant.value);
}

document.addEventListener("DOMContentLoaded", () => {

    const wishlistBtn = document.getElementById("wishlistBtn");

    if (!wishlistBtn) return;

    wishlistBtn.addEventListener("click", async function () {

        const productId = this.dataset.productId;

        // Get currently selected variant
        const selectedVariant = document.querySelector(
            'input[name="variantId"]:checked'
        );

        if (!selectedVariant) {

            return Swal.fire({
                icon: "warning",
                title: "Select a size",
                text: "Please select a size before adding to wishlist"
            });

        }

        const variantId = selectedVariant.value;

        try {

            const response = await fetch(
                `/user/wishlist/toggle/${productId}`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({
                        variantId: variantId
                    })
                }
            );

            const data = await response.json();

            if (!data.success) {

                return Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: data.message
                });

            }

            // ADD THIS: Update wishlist count immediately
            updateNavbarCounts({
                wishlistCount: data.wishlistCount
            });

            if (data.action === "added") {

                this.classList.add("active-wishlist");

                this.innerHTML =
                    `<i class="fa-solid fa-heart"></i>`;

                Swal.fire({
                    icon: "success",
                    title: "Added",
                    text: data.message,
                    timer: 1200,
                    showConfirmButton: false
                });

            } else {

                this.classList.remove("active-wishlist");

                this.innerHTML =
                    `<i class="fa-regular fa-heart"></i>`;

                Swal.fire({
                    icon: "success",
                    title: "Removed",
                    text: data.message,
                    timer: 1200,
                    showConfirmButton: false
                });

            }

        } catch (err) {

            console.log("WISHLIST ERROR:", err);

            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong"
            });

        }

    });

});

const addToCartForm = document.getElementById("addToCartForm");

if (addToCartForm) {

    addToCartForm.addEventListener("submit", async function (e) {

        e.preventDefault();

        const variantId = document.querySelector('input[name="variantId"]:checked').value;
        const quantity = document.querySelector('input[name="quantity"]').value;

        try {

            const response = await fetch(this.action, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    variantId,
                    quantity
                })
            });

            const data = await response.json();

            if (data.success) {

                updateNavbarCounts({
                    cartCount: data.cartCount,
                    wishlistCount: data.wishlistCount
                });

                await Swal.fire({
                    icon: "success",
                    title: "Added!",
                    text: data.message,
                    timer: 1500,
                    showConfirmButton: false
                });
            } else {

                Swal.fire({
                    icon: "warning",
                    title: "Oops!",
                    text: data.message
                });

            }

        } catch (err) {

            console.log(err);

            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Something went wrong."
            });

        }

    });

}


// Quantity Increase and Decrease

const quantityInput = document.getElementById("quantity");
const decreaseBtn = document.getElementById("decreaseQty");
const increaseBtn = document.getElementById("increaseQty");

function updateQuantityLimit() {
    const selectedVariant = document.querySelector(
        'input[name="variantId"]:checked'
    );

    const variant = variants.find(
        v => String(v._id) === String(selectedVariant?.value)
    );

    const stock = variant ? Number(variant.stock) : 0;

    // Maximum quantity is 5 or available stock, whichever is lower
    quantityInput.max = Math.min(5, stock);

    let quantity = Number(quantityInput.value);

    if (!Number.isFinite(quantity) || quantity < 1) {
        quantity = 1;
    }

    if (stock > 0) {
        quantity = Math.min(quantity, Number(quantityInput.max));
    } else {
        quantity = 1;
    }

    quantityInput.value = quantity;

    decreaseBtn.disabled = quantity <= 1;
    increaseBtn.disabled =
        stock <= 0 || quantity >= Number(quantityInput.max);
}

decreaseBtn.addEventListener("click", () => {
    let quantity = Number(quantityInput.value);

    if (quantity > 1) {
        quantityInput.value = quantity - 1;
    }

    updateQuantityLimit();
});

increaseBtn.addEventListener("click", () => {
    let quantity = Number(quantityInput.value);
    const maxQuantity = Number(quantityInput.max);

    if (quantity < maxQuantity) {
        quantityInput.value = quantity + 1;
    }

    updateQuantityLimit();
});

// Handle manual quantity entry
quantityInput.addEventListener("input", () => {
    if (quantityInput.value !== "") {
        updateQuantityLimit();
    }
});

// Update the quantity when the selected size changes
radios.forEach(radio => {
    radio.addEventListener("change", updateQuantityLimit);
});

// Initial quantity setup
updateQuantityLimit();



function updateNavbarCounts({ cartCount, wishlistCount } = {}) {
    const cartBadge = document.getElementById("cartCountBadge");
    const wishlistBadge = document.getElementById("wishlistCountBadge");

    if (cartBadge && cartCount !== undefined) {
        cartBadge.textContent = cartCount;
        cartBadge.style.display = cartCount > 0 ? "inline-flex" : "none";
    }

    if (wishlistBadge && wishlistCount !== undefined) {
        wishlistBadge.textContent = wishlistCount;
        wishlistBadge.style.display =
            wishlistCount > 0 ? "inline-flex" : "none";
    }
}



</script>

</body>
</html>