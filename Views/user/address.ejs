<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CARRY NEST - Saved Addresses</title>
    <link rel="stylesheet" href="/Styles/user/address.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">CARRY NEST</div>

        <div class="nav-icons">
            <a href="/user/cart" class="cart-link">
                <i class="fa-solid fa-cart-shopping"></i>

                <% if (cartCount > 0) { %>
                    <span class="cart-badge"><%= cartCount %></span>
                <% } %>
            </a>
            
            <a href="/user/wishlist" class="wishlist-link">
                <i class="fa-regular fa-heart"></i>

                <% if (wishlistCount > 0) { %>
                    <span class="wishlist-badge">
                        <%= wishlistCount %>
                    </span>
                <% } %>
            </a>

            <a href="/user/profile">
                <i class="fa-regular fa-user"></i>
            </a>
        </div>
    </nav>

    <div class="profile-page-layout">
        <!-- Sidebar -->
        <aside class="sidebar-container">
            <div class="user-id-card">
                <div class="avatar-box">
                    <img src="<%= user.profileImage || 'https://ui-avatars.com/api/?name=' + user.name %>">
                </div>
                <h3><%= user.name %></h3>
                <p class="user-email"><%= user.email %></p>
                <p class="user-phone"><%= user.phone %></p>
            </div>

            <nav class="nav-menu">
                  <a href="/user/home" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-house"></i></span> Home
                </a>
                <a href="/user/profile" class="nav-item">
                    <span class="nav-icon"><i class="fa-regular fa-user"></i></span> Personal Information
                </a>
                <!-- Addresses is now the ACTIVE item with black background -->
                <a href="/user/address" class="nav-item active">
                    <span class="nav-icon"><i class="fa-solid fa-location-dot"></i></span> Addresses
                </a>
                <a href="/user/referral" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-gift"></i></span> Referrals
                </a>
                <a href="/user/orders" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-box"></i></span> Order History
                </a>
                <a href="/user/wallet" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-wallet"></i></span> Wallet
                </a>
                <a href="/user/change-password" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-key"></i></span> Change Password
                </a>
                <div class="nav-divider"></div>
                <form action="/user/logout" method="POST" class="logout-form">
                    <button type="submit" class="nav-item logout-btn">
                        <span class="nav-icon">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </span>
                        Logout
                    </button>
                </form>
            </nav>
        </aside>

        <!-- Main Content: Saved Addresses -->
        <main class="main-content-container">
            <section class="content-card">
                <div class="card-header">
                    <h2>Saved Addresses</h2>
                    <a href="/user/address/add" style="text-decoration: none;">+ Add New Address</a>
                </div>

                <div class="address-list">
                    <!-- Home Address Card -->
                    <% addresses.forEach(address => { %>
                    <div class="address-card">
                        <div class="address-top">
                            <div class="address-label">
                                <span class="badge-home">
                                    <%= address.type %>
                                </span>
                                <% if(address.isDefault){ %>
                                    <span class="badge-default">
                                        Default
                                    </span>
                                <% } %>
                            </div>
                            <a href="/user/address/edit/<%= address._id %>"
                            class="icon-btn">
                                ✎ 
                            </a>
                        </div>
                        <div class="address-details">
                            <p><%= address.fullName %></p>
                            <p>
                               
                                <%= address.houseName %>,
                                <%= address.address %>
                            </p>
                            <p>
                                <%= address.city %>,
                                <%= address.state %>
                                - <%= address.pincode %>
                            </p>
                            <p><%= address.mobile %></p>
                        </div>
                        <div class="address-actions">
                            <form action="/user/address/delete/<%= address._id %>" method="POST"
                                onsubmit="return confirmDelete(event, this)">

                                <input type="hidden" name="from" value="address">

                                <button
                                    type="button"
                                    class="delete-address"
                                    data-address-id="<%= address._id %>"
                                    onclick="confirmDelete(this)">
                                    <i class="fa-solid fa-trash"></i>
                                    Delete
                                </button>

                            </form>
                        </div>
                    </div>
                    <% }) %>

                </div>
            </section>
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-container">

            <!-- Brand -->
            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p class="footer-tagline">
                    Carry Your World. Your Style, Your Journey.
                </p>
                <p>
                    Discover stylish, durable and functional bags
                    designed for everyday life, work and travel.
                </p>
            </div>

            <!-- Shop -->
            <div class="footer-col">
                <h4>Shop</h4>

                <a href="/user/products">All Products</a>
                <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
                <a href="/user/products?category=Office%20Bags">Office Bags</a>
                <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
                <a href="/user/products?category=School%20Bags">School Bags</a>
                <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
            </div>

            <!-- Quick Links -->
            <div class="footer-col">
                <h4>Quick Links</h4>
                <a href="/user/home">Home</a>
                <a href="/user/about">About Us</a>
                <a href="/user/profile">My Account</a>
                <a href="/user/orders">My Orders</a>
                <a href="/user/contact">Contact Us</a>
            </div>

            <!-- Contact -->
            <div class="footer-col footer-contact">
                <h4>Contact Us</h4>

                <p>
                    <i class="fa-regular fa-envelope"></i>
                    support@yourdomain.com
                </p>

                <p>
                    <i class="fa-solid fa-phone"></i>
                    +91 XXXXX XXXXX
                </p>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Kerala, India
                </p>

                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 CARRY NEST. All Rights Reserved.</p>

            <div class="footer-bottom-info">
                <a href="/user/privacy-policy">Privacy Policy</a>
                <a href="/user/terms">Terms & Conditions</a>
                <a href="/user/return-policy">Return Policy</a>
            </div>
        </div>
    </footer>

<script>

    async function confirmDelete(button) {

        const addressId = button.dataset.addressId;

        const result = await Swal.fire({
            title: "Are you sure?",
            text: "You won't be able to recover this address!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Yes, delete it"
        });

        if (!result.isConfirmed) return;

        try {

            const response = await fetch(`/user/address/delete/${addressId}`, {
                method: "DELETE"
            });

            const data = await response.json();

            if (!data.success) {
                return Swal.fire({
                    icon: "error",
                    title: "Delete Failed",
                    text: data.message
                });
            }

            await Swal.fire({
                icon: "success",
                title: "Address Deleted!",
                text: data.message,
                confirmButtonColor: "#000"
            });

            window.location.reload();

        } catch (error) {

            console.error("DELETE ADDRESS ERROR:", error);

            Swal.fire({
                icon: "error",
                title: "Something went wrong",
                text: "Unable to delete address."
            });
        }
    }

</script>

</body>
</html>