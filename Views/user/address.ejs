<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CARRY NEST - Saved Addresses</title>
    <link rel="stylesheet" href="/Styles/user/address.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">CARRY NEST</div>

        <div class="nav-icons">
            <a href="/user/cart" class="cart-link">
                <i class="fa-solid fa-cart-shopping"></i>

                <% if (cartCount > 0) { %>
                    <span class="cart-badge"><%= cartCount %></span>
                <% } %>
            </a>
            
            <a href="/user/wishlist" class="wishlist-link">
                <i class="fa-regular fa-heart"></i>

                <% if (wishlistCount > 0) { %>
                    <span class="wishlist-badge">
                        <%= wishlistCount %>
                    </span>
                <% } %>
            </a>

            <a href="/user/profile">
                <i class="fa-regular fa-user"></i>
            </a>
        </div>
    </nav>

    <div class="profile-page-layout">
        <!-- Sidebar -->
        <aside class="sidebar-container">
            <div class="user-id-card">
                <div class="avatar-box">
                    <img src="<%= user.profileImage || 'https://ui-avatars.com/api/?name=' + user.name %>">
                </div>
                <h3><%= user.name %></h3>
                <p class="user-email"><%= user.email %></p>
                <p class="user-phone"><%= user.phone %></p>
            </div>

            <nav class="nav-menu">
                  <a href="/user/home" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-house"></i></span> Home
                </a>
                <a href="/user/profile" class="nav-item">
                    <span class="nav-icon"><i class="fa-regular fa-user"></i></span> Personal Information
                </a>
                <!-- Addresses is now the ACTIVE item with black background -->
                <a href="/user/address" class="nav-item active">
                    <span class="nav-icon"><i class="fa-solid fa-location-dot"></i></span> Addresses
                </a>
                <a href="#" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-gift"></i></span> Referrals
                </a>
                <a href="/user/orders" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-box"></i></span> Order History
                </a>
                <a href="#" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-wallet"></i></span> Wallet
                </a>
                <a href="/user/change-password" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-key"></i></span> Change Password
                </a>
                <div class="nav-divider"></div>
                <a href="/user/logout" class="nav-item logout-btn">
                    <span class="nav-icon"><i class="fa-solid fa-right-from-bracket"></i></span>Logout
                </a>
            </nav>
        </aside>

        <!-- Main Content: Saved Addresses -->
        <main class="main-content-container">
            <section class="content-card">
                <div class="card-header">
                    <h2>Saved Addresses</h2>
                    <a href="/user/address/add" style="text-decoration: none;">+ Add New Address</a>
                </div>

                <div class="address-list">
                    <!-- Home Address Card -->
                    <% addresses.forEach(address => { %>
                    <div class="address-card">
                        <div class="address-top">
                            <div class="address-label">
                                <span class="badge-home">
                                    <%= address.type %>
                                </span>
                                <% if(address.isDefault){ %>
                                    <span class="badge-default">
                                        Default
                                    </span>
                                <% } %>
                            </div>
                            <a href="/user/address/edit/<%= address._id %>"
                            class="icon-btn">
                                ✎ 
                            </a>
                        </div>
                        <div class="address-details">
                            <p><%= address.fullName %></p>
                            <p><%= address.address %></p>
                            <p>
                                <%= address.city %>,
                                <%= address.state %>
                                - <%= address.pincode %>
                            </p>
                            <p><%= address.mobile %></p>
                        </div>
                        <div class="address-actions">
                            <form action="/user/address/delete/<%= address._id %>" 
                                method="POST"
                                class="delete-form">
                                <button type="submit" class="delete-btn">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                    <% }) %>

                </div>
            </section>
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-top">
            <div class="footer-col about">
                <h3 class="footer-logo">CARRY NEST</h3>
                <p>Lorem ipsum dolor sit amet consectetur. Purus in etiam risus ut sem eu urna. Massa feugiat consequat nec libero.</p>
                <p>Lorem ipsum dolor sit</p>
            </div>
            
            <div class="footer-col">
                <h3>Service</h3>
                <ul>
                    <li><a href="#">Laptop Bags</a></li>
                    <li><a href="#">Trekking Bags</a></li>
                    <li><a href="#">School Bags</a></li>
                    <li><a href="#">Office Bags</a></li>
                    <li><a href="#">Travelling Bags</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Company</h3>
                <ul>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Features</a></li>
                    <li><a href="#">Our Team</a></li>
                    <li><a href="#">Portfolio</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-col contact-form">
                <h3>Contact Us</h3>
                <p>Your Email/Phone no.</p>
                <div class="subscribe-box">
                    <input type="text" placeholder="Enter Your Email or Phone no.">
                    <button class="send-btn">Send</button>
                </div>
                <div class="social-icons">
                    <div class="social-icon fb"></div>
                    <div class="social-icon ig"></div>
                    <div class="social-icon wa"></div>
                    <div class="social-icon li"></div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>Copyright Tanah Air Studio</p>
            <div class="info-links">
                <span>📍 8819 Ohio St. South Gate, CA 90280</span>
                <span>✉️ CrossLine@hello.com</span>
                <span>📞 +91 386-688-3295</span>
            </div>
        </div>
    </footer>

<script>

document.querySelectorAll(".delete-form").forEach(form => {

    form.addEventListener("submit", (e) => {

        e.preventDefault();

        Swal.fire({
            title: "Delete Address?",
            text: "This address will be removed permanently",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Delete",
            cancelButtonText: "Cancel"
        }).then((result) => {

            if(result.isConfirmed){

                form.submit();
            }
        });
    });
});

</script>

</body>
</html>