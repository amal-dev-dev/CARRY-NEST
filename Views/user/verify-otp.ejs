<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verify OTP - Carry Nest</title>

<link rel="stylesheet" href="/Styles/user/verify-otp.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

<header class="main-header">
    <div class="container">
        <h1 class="logo">CARRY NEST</h1>
    </div>
</header>

<main class="login-section">
    <div class="login-card otp-container">

        <h2>Verify OTP</h2>
        <p class="subtitle">Enter the 6-digit code sent to your email</p>

        <% if (typeof message !== 'undefined') { %>
            <div class="error-message">
                <%= message %>
            </div>
        <% } %>

        <form action="/user/verify-otp" method="POST" id="otpForm">

            <div class="otp-inputs">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
            </div>

            <input type="hidden" name="otp" id="otpValue">

            <button type="submit" class="btn-primary">VERIFY</button>

        </form>

        <div class="resend">
            <p>Didn't receive OTP?</p>
            <a href="/user/resend-otp">Resend OTP</a>
        </div>

    </div>
</main>

<script src="/JS/otp.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter OTP - CARRY NEST</title>
    <link rel="stylesheet" href="/styles/user/verify-otp.css">
</head>
<body>

    <header class="header">
        <h1 class="logo">CARRY NEST</h1>
    </header>

    <main class="auth-container">
        <div class="auth-card">
            <h2>Enter The OTP</h2>
            <p class="subtitle">The OTP was sent to your registered email.<br>Please check the spam folder.</p>

            <% if (typeof message !== 'undefined') { %>
                <p style="color:red; text-align:center;"><%= message %></p>
            <% } %>
            
            <form class="auth-form" action="/user/verify-otp" method="POST">
                <div class="input-group">
                    <label for="otp">OTP</label>
                    <input type="text" id="otp" name="otp" placeholder="******" maxlength="7" required>
                </div>
                <button type="submit" class="btn-primary">Reset Password</button>
            </form>
            <a href="/user/login" class="back-link">Back To Sign in</a>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-top">
            <div class="footer-col about">
                <h3>CARRY NEST</h3>
                <p>Lorem ipsum dolor sit amet consectetur. Purus in etiam risus ut sem eu urna. Massa feugiat consequat nec libero.</p>
                <p>Lorem ipsum dolor sit</p>
            </div>
            
            <div class="footer-col">
                <h3>Service</h3>
                <ul>
                    <li><a href="#">Laptop Bags</a></li>
                    <li><a href="#">Trekking Bags</a></li>
                    <li><a href="#">School Bags</a></li>
                    <li><a href="#">Office Bags</a></li>
                    <li><a href="#">Travelling Bags</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Company</h3>
                <ul>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Features</a></li>
                    <li><a href="#">Our Team</a></li>
                    <li><a href="#">Portfolio</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-col contact-form">
                <h3>Contact Us</h3>
                <p>Your Email/Phone no.</p>
                <div class="subscribe-box">
                    <input type="text" placeholder="Enter Your Email or Phone no.">
                    <button class="send-btn">Send</button>
