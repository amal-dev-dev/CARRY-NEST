<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CARRY NEST - Edit Review</title>

    <link rel="stylesheet" href="/Styles/user/write-review.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <a href="/user/home" class="logo">CARRYNEST</a>

        <div class="nav-icons">
            <% if (typeof user !== "undefined" && user) { %>
                <a href="/user/cart" title="Cart">
                    <i class="fa-solid fa-cart-shopping"></i>
                </a>

                <a href="/user/wishlist" title="Wishlist">
                    <i class="fa-regular fa-heart"></i>
                </a>

                <a href="/user/profile" title="Profile">
                    <i class="fa-regular fa-user"></i>
                </a>
            <% } else { %>
                <a href="/user/login">Login</a>
                <a href="/user/signup">Sign Up</a>
            <% } %>
        </div>
    </nav>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    >

    <main class="review-page">

        <!-- Back Link -->
        <a class="back-link"
           href="<%= backUrl || '/user/orders' %>">
            <span aria-hidden="true">‹</span> Back to Orders
        </a>

        <!-- Edit Review Form -->
        <form
            id="reviewForm"
            class="review-form"
            action="/user/reviews/<%= review._id %>/edit"
            method="POST"
        >

            <!-- Product Information -->
            <section class="product-card">

                <img
                    class="product-image"
                    src="<%= product.productImage?.[0] || '/images/no-image.png' %>"
                    alt="<%= product.productName %>"
                >

                <div class="product-info">
                    <h1><%= product.productName %></h1>
                    <p>Update your experience with this product.</p>
                </div>

            </section>

            <!-- Rating Section -->
            <section class="rating-card">

                <label class="section-label">
                    Overall Rating <span>*</span>
                </label>

                <div class="stars" role="radiogroup" aria-label="Overall rating">

                    <% for (let i = 1; i <= 5; i++) { %>

                        <input
                            type="radio"
                            id="star<%= i %>"
                            name="rating"
                            value="<%= i %>"
                            <%= Number(review.rating) === i ? "checked" : "" %>
                            required
                        >

                        <label
                            for="star<%= i %>"
                            title="<%= i %> star<%= i > 1 ? 's' : '' %>"
                        >★</label>

                    <% } %>

                </div>

                <p id="ratingText" class="rating-hint">
                    <%= review.rating
                        ? ["Very poor", "Poor", "Average", "Good", "Excellent"][Number(review.rating) - 1]
                        : "Select a rating" %>
                </p>

            </section>

            <!-- Review Fields -->
            <section class="review-fields">

                <div class="field-group">
                    <label for="title">
                        Review Title <span>*</span>
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= review.title || '' %>"
                        placeholder="Sum up your experience"
                        minlength="3"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="field-group">
                    <label for="comment">
                        Review <span>*</span>
                    </label>

                    <textarea
                        id="comment"
                        name="comment"
                        placeholder="Share your thoughts about this product..."
                        minlength="3"
                        maxlength="1000"
                        required
                    ><%= review.comment || '' %></textarea>

                    <div class="character-count">
                        <span id="charCount"><%= (review.comment || '').length %></span>
                        / 1000 characters
                    </div>
                </div>

            </section>

            <!-- Optional Photo Section -->
            <section class="photo-card">

                <div class="photo-heading">
                    <label for="photos">Add Photos</label>
                    <span>(Optional)</span>
                </div>

                <label for="photos" class="upload-box">
                    <span class="upload-icon">⇧</span>
                    <span>Click to upload</span>
                    <small>JPG or PNG</small>
                </label>

                <input
                    type="file"
                    id="photos"
                    name="photos"
                    accept="image/jpeg,image/png"
                    multiple
                >

                <p class="photo-help">
                    You can upload up to 5 photos.
                </p>

                <div id="photoPreview" class="photo-preview"></div>

            </section>

            <!-- Message -->
            <p id="formMessage" class="form-message" role="status"></p>

            <!-- Update Button -->
            <button
                type="submit"
                class="submit-button"
                id="submitButton"
            >
                Update Review
            </button>

        </form>

    </main>

    <script>
        const form = document.getElementById("reviewForm");
        const ratingInputs = document.querySelectorAll('input[name="rating"]');
        const ratingText = document.getElementById("ratingText");
        const comment = document.getElementById("comment");
        const charCount = document.getElementById("charCount");
        const photos = document.getElementById("photos");
        const photoPreview = document.getElementById("photoPreview");
        const formMessage = document.getElementById("formMessage");
        const submitButton = document.getElementById("submitButton");

        const ratingLabels = [
            "Very poor",
            "Poor",
            "Average",
            "Good",
            "Excellent"
        ];

        // Display selected rating
        function updateStars() {
            const selectedRating = document.querySelector(
                'input[name="rating"]:checked'
            );

            document.querySelectorAll(".stars label").forEach(label => {
                label.classList.remove("selected");
            });

            if (selectedRating) {
                const selectedValue = Number(selectedRating.value);

                const selectedLabel = document.querySelector(
                    `label[for="star${selectedValue}"]`
                );

                if (selectedLabel) {
                    selectedLabel.classList.add("selected");
                }

                ratingText.textContent = ratingLabels[selectedValue - 1];
            } else {
                ratingText.textContent = "Select a rating";
            }
        }

        ratingInputs.forEach(input => {
            input.addEventListener("change", updateStars);
        });

        // Set initial rating appearance
        updateStars();

        // Update character count
        comment.addEventListener("input", () => {
            charCount.textContent = comment.value.length;
        });

        // Photo preview and validation
        photos.addEventListener("change", () => {
            photoPreview.innerHTML = "";
            formMessage.textContent = "";
            formMessage.className = "form-message";

            const selectedFiles = Array.from(photos.files);
            const allowedTypes = ["image/jpeg", "image/png"];
            const maxFileSize = 5 * 1024 * 1024;

            if (selectedFiles.length > 5) {
                formMessage.textContent = "You can upload a maximum of 5 photos.";
                photos.value = "";
                return;
            }

            for (const file of selectedFiles) {
                if (!allowedTypes.includes(file.type)) {
                    formMessage.textContent =
                        "Only JPG and PNG images are allowed.";
                    photos.value = "";
                    photoPreview.innerHTML = "";
                    return;
                }

                if (file.size > maxFileSize) {
                    formMessage.textContent =
                        "Each photo must be smaller than 5 MB.";
                    photos.value = "";
                    photoPreview.innerHTML = "";
                    return;
                }
            }

            selectedFiles.forEach(file => {
                const image = document.createElement("img");

                image.className = "preview-image";
                image.alt = "Selected review photo";
                image.src = URL.createObjectURL(file);

                photoPreview.appendChild(image);
            });
        });

        // Update review
        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            formMessage.textContent = "";
            formMessage.className = "form-message";

            const selectedRating = document.querySelector(
                'input[name="rating"]:checked'
            );

            if (!selectedRating) {
                formMessage.textContent = "Please select a rating.";
                return;
            }

            const title = document.getElementById("title").value.trim();
            const reviewComment = comment.value.trim();

            if (title.length < 3) {
                formMessage.textContent =
                    "Review title must contain at least 3 characters.";
                return;
            }

            if (reviewComment.length < 3) {
                formMessage.textContent =
                    "Review must contain at least 3 characters.";
                return;
            }

            if (photos.files.length > 5) {
                formMessage.textContent =
                    "You can upload a maximum of 5 photos.";
                return;
            }

            submitButton.disabled = true;
            submitButton.textContent = "Updating...";

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        rating: Number(selectedRating.value),
                        title: title,
                        comment: reviewComment
                    })
                });

                const responseText = await response.text();

                let result;

                try {
                    result = JSON.parse(responseText);
                } catch (error) {
                    throw new Error(
                        "Server returned HTML instead of JSON. Check the browser console."
                    );
                }

                if (!response.ok || !result.success) {
                    throw new Error(
                        result.message || "Unable to update review."
                    );
                }

                formMessage.textContent =
                    result.message || "Review updated successfully.";

                formMessage.classList.add("success");

                setTimeout(() => {
                    window.location.href =
                        "<%= backUrl || '/user/orders' %>";
                }, 1000);

            } catch (error) {
                formMessage.textContent =
                    error.message || "Something went wrong. Please try again.";

                formMessage.classList.add("error");

            } finally {
                submitButton.disabled = false;
                submitButton.textContent = "Update Review";
            }
        });
    </script>

</body>
</html>