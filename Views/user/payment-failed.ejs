<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payment Failed - Carry Nest</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        .payment-failed-container {
            width: 90%;
            max-width: 500px;
            background: white;

            padding: 40px 30px;

            border-radius: 12px;

            text-align: center;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .failed-icon {
            width: 80px;
            height: 80px;

            margin: 0 auto 20px;

            border-radius: 50%;

            background: #ffe5e5;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 40px;
        }

        h1 {
            margin-bottom: 15px;
            color: #222;
        }

        .message {
            color: #666;
            margin-bottom: 10px;
        }

        .error-message {
            color: #d32f2f;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .buttons {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            display: block;

            padding: 13px 20px;

            border-radius: 6px;

            text-decoration: none;

            font-size: 15px;

            cursor: pointer;

            border: none;
        }

        .retry-btn {
            background: #111;
            color: white;
        }

        .orders-btn {
            background: #eee;
            color: #222;
        }

        .shopping-btn {
            background: white;
            color: #222;
            border: 1px solid #ddd;
        }

        .btn:hover {
            opacity: 0.85;
        }

    </style>
</head>

<body>

    <div class="payment-failed-container">

        <div class="failed-icon">
            ❌
        </div>

        <h1>Payment Failed</h1>

        <p class="message">
            We couldn't complete your payment.
        </p>

        <% if (message) { %>

            <p class="error-message">
                <%= message %>
            </p>

        <% } %>


        <div class="buttons">

            <% if (orderId) { %>
                <a href="/user/retry-payment/<%= orderId %>"
                class="btn retry-btn">
                    Retry Payment
                </a>
            <% } else { %>
                <a href="/user/checkout"
                class="btn retry-btn">
                    Return to Checkout
                </a>
            <% } %>

            <a href="/user/orders" class="btn orders-btn">
                My Orders
            </a>

            <a href="/user/products" class="btn shopping-btn">
                Continue Shopping
            </a>

        </div>

    </div>

</body>
</html>