<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - CARRY NEST</title>
    <link rel="stylesheet" href="/Styles/user/forgot-password.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>
<body>

    <!-- Header Section -->
    <header class="header">
        <h1 class="logo">CARRY NEST</h1>
    </header>

    <!-- Main Content -->
    <main class="auth-container">
        <div class="auth-card">
            <h2>Forgot Password</h2>
            <p class="subtitle">Enter Your Email And We Will Send You Instructions To Reset Your Password</p>
            
            <form class="auth-form" action="/user/forgot-password" method="POST">
                <div class="input-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="Pandfvnidmk@gmail.com">
                </div>
                <button type="submit" class="btn-primary">Send OTP</button>
            </form>
            <a href="/user/login" class="back-link">Back To Sign in</a>
        </div>
    </main>

    <!-- Footer Section -->
    <footer class="footer">
        <div class="footer-top">
            <div class="footer-col about">
                <h3>CARRY NEST</h3>
                <p>Lorem ipsum dolor sit amet consectetur. Purus in etiam risus ut sem eu urna. Massa feugiat consequat nec libero.</p>
                <p>Lorem ipsum dolor sit</p>
            </div>
            
            <div class="footer-col">
                <h3>Service</h3>
                <ul>
                    <li><a href="#">Laptop Bags</a></li>
                    <li><a href="#">Trekking Bags</a></li>
                    <li><a href="#">School Bags</a></li>
                    <li><a href="#">Office Bags</a></li>
                    <li><a href="#">Travelling Bags</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Company</h3>
                <ul>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Features</a></li>
                    <li><a href="#">Our Team</a></li>
                    <li><a href="#">Portfolio</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-col contact-form">
                <h3>Contact Us</h3>
                <p>Your Email/Phone no.</p>
                <div class="subscribe-box">
                    <input type="text" placeholder="Enter Your Email or Phone no.">
                    <button>Send</button>
                </div>
                <div class="social-icons">
                    <!-- Placeholder Icons -->
                    <span class="icon fb"></span>
                    <span class="icon ig"></span>
                    <span class="icon wa"></span>
                    <span class="icon li"></span>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>Copyright Tanah Air Studio</p>
            <div class="info-links">
                <span>📍 8819 Ohio St. South Gate, CA 90280</span>
                <span>✉️ CrossLine@hello.com</span>
                <span>📞 +91 386-688-3295</span>
            </div>
        </div>
    </footer>

    <script>

        const message = `<%= typeof message !== 'undefined' ? message : '' %>`;

        if(message){

            Swal.fire({
                icon: "error",
                title: "Error",
                text: message
            });
        }

        const forgotForm = document.querySelector("form");

        forgotForm.addEventListener("submit", (e) => {
            const email = document.getElementById("email").value.trim();

            if(!email){
                e.preventDefault();
                Swal.fire({
                    icon: "warning",
                    title: "Email Required",
                    text: "Please enter your email"
                });
            }
        });

    </script>

</body>
</html>