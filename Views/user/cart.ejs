<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Carry Nest Cart</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet"
          href="/Styles/user/cart.css">

</head>
<body>

<!-- NAVBAR -->

<nav class="navbar">

    <div class="logo">
        CARRY NEST
    </div>

    <div class="nav-icons">

        <a href="/user/cart" class="cart-link">
            <i class="fa-solid fa-cart-shopping"></i>
            
            <span
                id="cartCountBadge"
                class="cart-badge"
                style="<%= Number(cartCount || 0) > 0 ? '' : 'display: none;' %>"
            ><%= Number(cartCount || 0) %></span>
        </a>

        <a href="/user/wishlist" class="wishlist-link">
            <i class="fa-regular fa-heart"></i>

            <span
                id="wishlistCountBadge"
                class="wishlist-badge"
                style="<%= Number(wishlistCount || 0) > 0 ? '' : 'display: none;' %>"
            ><%= wishlistCount || 0 %></span>
        </a>

        <a href="/user/profile" style="color: black;">
            <i class="fa-regular fa-user"></i>
        </a>

    </div>

</nav>

<!-- BREADCRUMB -->

<div class="breadcrumb">

    <a href="/user/home">Home</a>

    <span>/</span>

    <a href="/user/products">Products</a>

    <span>/</span>

    <span>Cart</span>

</div>

<!-- CART -->

<section class="cart-container">

    <!-- LEFT -->

        <div class="cart-items">

            <h1>YOUR CART</h1>

            <% if (hasBlockedItems) { %>

                <div class="cart-warning">
                    <i class="fa-solid fa-triangle-exclamation"></i>

                    <span>
                        Some products in your cart are currently unavailable.
                        They will not be included in checkout.
                        You can remove them from your cart.
                    </span>
                </div>

            <% } %>

            <% if(cartItems && cartItems.length > 0){ %>

            <div id="cartItemsWrapper">

            <% cartItems.forEach(item => { %>

                <% if(item.productId && item.variant){ %>

                <div
                    class="cart-card <%= item.productId.isBlocked ? 'blocked-cart-item' : '' %>"
                    data-variant-id="<%= item.variantId %>"
                >

                    <% if(item.productId.isBlocked){ %>
                        <div class="blocked-warning">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            This product is currently unavailable.
                        </div>
                    <% } %>

                        <img
                            src="<%= item.productId.productImage[0] || '/images/no-image.png' %>"
                            alt="<%= item.productId.productName %>"
                        >

                        <div class="cart-info">

                            <h3>
                                <%= item.productId.productName %>
                            </h3>

                            <p>
                                Brand:
                                <%= item.productId.brand %>
                            </p>

                            <p>
                                Color:
                                <%= item.productId.colors.join(", ") %>
                            </p>

                            <p>
                                Size:
                                <%= item.variant.size %>
                            </p>

                            <p>
                                Stock:
                                <%= item.variant.stock %>
                            </p>

                            <% if (item.isUnavailable) { %>
                                <div class="product-unavailable-warning">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    <%= item.unavailableReason %>
                                </div>
                            <% } %>

                            <h4 id="itemTotal-<%= item.variantId %>">
                                ₹<%= Number(item.itemTotal ?? (item.variant.salePrice * item.quantity)).toFixed(2) %>
                            </h4>

                            <% if (item.offerDiscountPercentage > 0) { %>
                                <p class="cart-offer-label">
                                    <%= item.offerDiscountPercentage %>% OFF
                                    <% if (item.appliedOfferTitle) { %>
                                        — <%= item.appliedOfferTitle %>
                                    <% } %>
                                </p>
                            <% } %>

                            <% if(item.variant.stock <= 0){ %>
                                <span class="out-stock">
                                    Out Of Stock
                                </span>
                            <% } %>

                        </div>

                        <div class="cart-actions">

                            <button
                                type="button"
                                class="qty-btn decrease-btn"
                                data-id="<%= item.variantId %>"
                                <%= item.productId.isBlocked ? "disabled" : "" %>>
                                -
                            </button>

                            <span id="qty-<%= item.variantId %>">
                                <%= item.quantity %>
                            </span>

                            <button
                                type="button"
                                class="qty-btn increase-btn"
                                data-id="<%= item.variantId %>"
                                <%= item.productId.isBlocked ? "disabled" : "" %>>
                                +
                            </button>

                        </div>

                        <button
                            type="button"
                            class="delete-btn remove-btn"
                            data-id="<%= item.variantId %>">

                            <i class="fa-solid fa-trash"></i>

                        </button>

                    </div>

                    <% } %>

                <% }) %>

            </div>

            <!-- empty cart placeholder -->
            <div class="empty-cart" id="emptyCartBox" style="display:none;">
                <h2>Your Cart Is Empty</h2>
                <a href="/user/products">Continue Shopping</a>
            </div>

        <% } else { %>

            <div class="empty-cart" id="emptyCartBox">
                <h2>Your Cart Is Empty</h2>
                <a href="/user/products">Continue Shopping</a>
            </div>

        <% } %>

    </div>

    <!-- RIGHT -->

    <div class="summary-box">

        <h2>Order Summary</h2>

        <div class="summary-row">
            <span>Subtotal</span>
            <span id="subtotalValue">
                ₹<%= Number(subtotal || 0).toFixed(2) %>
            </span>
        </div>

        <div class="summary-row">
            <span>Discount</span>
            <span class="discount" id="discountValue">
                -₹<%= Number(discount || 0).toFixed(2) %>
            </span>
        </div>

        <hr>

        <div class="summary-row total">
            <span>Total</span>
            <span id="grandTotalValue">
                ₹<%= Number(grandTotal || 0).toFixed(2) %>
            </span>
        </div>

        <% const hasBlockedProduct = cart && cart.items.some(
            item => item.productId && item.productId.isBlocked
        ); %>

        <% if (hasAvailableItems) { %>

            <a
                href="/user/checkout"
                class="checkout-btn"
                id="checkoutBtn">
                Go To Checkout
            </a>

        <% } else { %>

            <button
                type="button"
                class="checkout-btn checkout-disabled"
                id="checkoutBtn"
                disabled>
                Go To Checkout
            </button>

        <% } %>

    </div>

</section>

<!-- FOOTER -->

<footer>
    <div class="footer-container">

        <!-- Brand -->
        <div class="footer-col">
            <h3>CARRY NEST</h3>
            <p class="footer-tagline">
                Carry Your World. Your Style, Your Journey.
            </p>
            <p>
                Discover stylish, durable and functional bags
                designed for everyday life, work and travel.
            </p>
        </div>

        <!-- Shop -->
        <div class="footer-col">
            <h4>Shop</h4>

            <a href="/user/products">All Products</a>
            <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
            <a href="/user/products?category=Office%20Bags">Office Bags</a>
            <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
            <a href="/user/products?category=School%20Bags">School Bags</a>
            <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
            <h4>Quick Links</h4>
            <a href="/user/home">Home</a>
            <a href="/user/about">About Us</a>
            <a href="/user/profile">My Account</a>
            <a href="/user/orders">My Orders</a>
            <a href="/user/contact">Contact Us</a>
        </div>

        <!-- Contact -->
        <div class="footer-col footer-contact">
            <h4>Contact Us</h4>

            <p>
                <i class="fa-regular fa-envelope"></i>
                support@yourdomain.com
            </p>

            <p>
                <i class="fa-solid fa-phone"></i>
                +91 XXXXX XXXXX
            </p>

            <p>
                <i class="fa-solid fa-location-dot"></i>
                Kerala, India
            </p>

            <div class="social-icons">
                <a href="#" aria-label="Facebook">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
                <a href="#" aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>
                <a href="#" aria-label="WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="footer-bottom">
        <p>© 2026 CARRY NEST. All Rights Reserved.</p>

        <div class="footer-bottom-info">
            <a href="/user/privacy-policy">Privacy Policy</a>
            <a href="/user/terms">Terms & Conditions</a>
            <a href="/user/return-policy">Return Policy</a>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if(typeof message !== "undefined" && message){ %>
<script>
Swal.fire({
    icon: "warning",
    title: "<%= message %>",
    timer: 2000,
    showConfirmButton: false
});
</script>
<% } %>

<script>

document.addEventListener("DOMContentLoaded", () => {

    const subtotalValue = document.getElementById("subtotalValue");
    const discountValue = document.getElementById("discountValue");
    const grandTotalValue = document.getElementById("grandTotalValue");
    const cartItemsWrapper = document.getElementById("cartItemsWrapper");
    const emptyCartBox = document.getElementById("emptyCartBox");
    const checkoutBtn = document.getElementById("checkoutBtn");
    const cartCountBadge = document.getElementById("cartCountBadge");

    // Format currency to 2 decimal places
    function formatMoney(amount) {
        return Number(amount || 0).toFixed(2);
    }

    async function updateCart(url) {

        try {

            const response = await fetch(url, {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json"
                }
            });

            const data = await response.json();

            console.log("CART RESPONSE:", data);

            if (!data.success) {

                Swal.fire({
                    icon: "warning",
                    title: data.message || "Something went wrong",
                    timer: 1800,
                    showConfirmButton: false
                });

                return;
            }

            /*
            =====================================
            FIND PRODUCT CARD
            =====================================
            */

            const card = document.querySelector(
                `.cart-card[data-variant-id="${data.variantId}"]`
            );


            /*
            =====================================
            REMOVE ITEM
            =====================================
            */

            if (data.removed) {

                if (card) {
                    card.remove();
                }

            }


            /*
            =====================================
            UPDATE QUANTITY
            =====================================
            */

            else {

                if (card) {

                    const qtyEl = card.querySelector(
                        `[id="qty-${data.variantId}"]`
                    );

                    if (qtyEl) {
                        qtyEl.textContent = data.quantity;
                    }

                }

            }


            /*
            =====================================
            UPDATE ITEM PRICE
            =====================================
            */

            if (!data.removed && card) {

                const itemTotalEl = card.querySelector(
                    `[id="itemTotal-${data.variantId}"]`
                );

                if (itemTotalEl) {
                    itemTotalEl.textContent = `₹${formatMoney(data.itemTotal)}`;
                }

            }

            /*
            =====================================
            UPDATE SUMMARY
            =====================================
            */

            if (subtotalValue) {
                subtotalValue.textContent =
                    `₹${formatMoney(data.subtotal)}`;
            }

            if (discountValue) {
                discountValue.textContent =
                    `-₹${formatMoney(data.discount)}`;
            }

            if (grandTotalValue) {
                grandTotalValue.textContent =
                    `₹${formatMoney(data.grandTotal)}`;
            }


            /*
            =====================================
            UPDATE CART BADGE
            =====================================
            */

            if (cartCountBadge) {

                if (data.cartCount > 0) {

                    cartCountBadge.textContent =
                        data.cartCount;

                } else {

                    cartCountBadge.remove();

                }

            }


            /*
            =====================================
            EMPTY CART
            =====================================
            */

            const remainingCards =
                document.querySelectorAll(".cart-card");

            if (remainingCards.length === 0) {

                if (cartItemsWrapper) {
                    cartItemsWrapper.style.display = "none";
                }

                if (emptyCartBox) {
                    emptyCartBox.style.display = "block";
                }

                if (checkoutBtn) {
                    checkoutBtn.style.display = "none";
                }

            }

        } catch (error) {

            console.error("CART AJAX ERROR:", error);

            Swal.fire({
                icon: "error",
                title: "Something went wrong",
                timer: 1800,
                showConfirmButton: false
            });

        }

    }


    /*
    =====================================
    INCREASE
    =====================================
    */

    document.querySelectorAll(".increase-btn").forEach(btn => {

        btn.addEventListener("click", () => {

            const variantId = btn.dataset.id;

            console.log("INCREASE:", variantId);

            updateCart(
                `/user/cart/increase/${variantId}`
            );

        });

    });


    /*
    =====================================
    DECREASE
    =====================================
    */

    document.querySelectorAll(".decrease-btn").forEach(btn => {

        btn.addEventListener("click", () => {

            const variantId = btn.dataset.id;

            console.log("DECREASE:", variantId);

            updateCart(
                `/user/cart/decrease/${variantId}`
            );

        });

    });


    /*
    =====================================
    REMOVE
    =====================================
    */

    document.querySelectorAll(".remove-btn").forEach(btn => {

        btn.addEventListener("click", () => {

            const variantId = btn.dataset.id;

            Swal.fire({
                title: "Remove this item?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, remove"
            }).then(result => {

                if (result.isConfirmed) {

                    console.log("REMOVE:", variantId);

                    updateCart(
                        `/user/cart/remove/${variantId}`
                    );

                }

            });

        });

    });

});

</script>

<script>
    const moveAllResult = <%- JSON.stringify(moveAllResult) %>;
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const addedCount = moveAllResult.addedCount || 0;
    const unavailableItems = moveAllResult.unavailableItems || [];

    let message = "";

    if (addedCount > 0) {
        message +=
            `${addedCount} item${addedCount > 1 ? "s" : ""} added to cart.`;
    }

    if (unavailableItems.length > 0) {

        if (message) {
            message += "<br><br>";
        }

        message +=
            `<strong>${unavailableItems.length} item${unavailableItems.length > 1 ? "s were" : " was"} not added:</strong>`;

        unavailableItems.forEach(item => {
            message += `<br>• ${item.name} - ${item.reason}`;
        });
    }

    if (message) {

        Swal.fire({
            icon: unavailableItems.length > 0
                ? "warning"
                : "success",

            title: unavailableItems.length > 0
                ? "Some items could not be added"
                : "Wishlist moved to cart",

            html: message,

            confirmButtonText: "OK"
        });

    }

});
</script>

</body>
</html>