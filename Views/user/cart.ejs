<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Carry Nest Cart</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <link rel="stylesheet"
          href="/Styles/user/cart.css">

</head>
<body>

<!-- NAVBAR -->

<nav class="navbar">

    <div class="logo">
        CARRY NEST
    </div>

    <div class="nav-icons">

        <a href="/user/cart" style="color: black;"><i class="fa-solid fa-cart-shopping"></i></a>

        <a href="/user/wishlist" style="color: black;"><i class="fa-regular fa-heart"></i></a>

        <a href="/user/profile" style="color: black;"><i class="fa-regular fa-user"></i></a>

    </div>

</nav>

<!-- BREADCRUMB -->

<div class="breadcrumb">

    <a href="/user/home">Home</a>

    <span>/</span>

    <a href="/user/products">Products</a>

    <span>/</span>

    <span>Cart</span>

</div>

<!-- CART -->

<section class="cart-container">

    <!-- LEFT -->

    <div class="cart-items">

    <h1>YOUR CART</h1>

    <% if(cart && cart.items.length > 0){ %>

        <% cart.items.forEach(item => { %>

            <% if(item.productId && item.variant){ %>

            <div class="cart-card">

                <img
                    src="<%= item.productId.productImage[0] || '/images/no-image.png' %>"
                    alt="<%= item.productId.productName %>"
                >

                <div class="cart-info">

                    <h3>
                        <%= item.productId.productName %>
                    </h3>

                    <p>
                        Brand:
                        <%= item.productId.brand %>
                    </p>

                    <p>
                        Color:
                        <%= item.productId.colors.join(", ") %>
                    </p>

                    <p>
                        Size:
                        <%= item.variant.size %>
                    </p>

                    <p>
                        Stock:
                        <%= item.variant.stock %>
                    </p>

                    <h4>
                        ₹<%= item.variant.salePrice %>
                    </h4>

                    <% if(item.variant.stock <= 0){ %>

                        <span class="out-stock">
                            Out Of Stock
                        </span>

                    <% } %>

                </div>

                <div class="cart-actions">

                    <form
                        action="/user/cart/decrease/<%= item.variantId %>?_method=PATCH"
                        method="POST">

                        <button type="submit">-</button>

                    </form>

                    <span>
                        <%= item.quantity %>
                    </span>

                    <form
                        action="/user/cart/increase/<%= item.variantId %>?_method=PATCH"
                        method="POST">

                        <button type="submit">+</button>

                    </form>

                </div>

                <form
                    action="/user/cart/remove/<%= item.variantId %>?_method=PATCH"
                    method="POST">

                    <button
                        type="submit"
                        class="delete-btn">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </form>

            </div>

            <% } %>

        <% }) %>

    <% } else { %>

        <div class="empty-cart">

            <h2>
                Your Cart Is Empty
            </h2>

            <a href="/user/products">

                Continue Shopping

            </a>

        </div>

    <% } %>

    </div>

    <!-- RIGHT -->

    <div class="summary-box">

        <h2>
            Order Summary
        </h2>

        <div class="summary-row">

            <span>Subtotal</span>

            <span>
                ₹<%= subtotal %>
            </span>

        </div>

        <div class="summary-row">

            <span>Discount</span>

            <span class="discount">

                -₹<%= discount %>

            </span>

        </div>

        <div class="summary-row">

            <span>Delivery Fee</span>

            <span>

                ₹<%= deliveryFee %>

            </span>

        </div>

        <hr>

        <div class="summary-row total">

            <span>Total</span>

            <span>

                ₹<%= grandTotal %>

            </span>

        </div>

        <a
        href="/user/checkout"
        class="checkout-btn">

            Go To Checkout

        </a>

    </div>

</section>

<!-- FOOTER -->

    <footer>

        <div class="footer-container">

            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p>Lorem ipsum dolor sit amet consectetur. Purus in etiam risus ut sem eu urna. Massa feugiat consequat nec libero.</p>
                <p>Lorem ipsum dolor sit</p>
            </div>

            <div class="footer-col">
                <h4>Service</h4>
                <p>Laptop Bags</p>
                <p>Trekking Bags</p>
                <p>School Bags</p>
                <p>Office Bags</p>
                <p>Travelling Bags</p>
            </div>

            <div class="footer-col">
                <h4>Company</h4>
                <p>Service</p>
                <p>Features</p>
                <p>Our Team</p>
                <p>Portfolio</p>
                <p>Blog</p>
                <p>Contact Us</p>
            </div>

            <div class="footer-col footer-contact">
                <h4>Contact Us</h4>

                <div class="footer-input-box">
                    <input type="text" placeholder="Your Email / Phone no.">
                    <button>Send</button>
                </div>

                <div class="social-icons">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
                    <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">

            <p>Copyright Tanah Air Studio</p>

            <div class="footer-bottom-info">
                <span><i class="fa-solid fa-location-dot"></i> 8819 Ohio St. South Gate, CA 90280</span>
                <span><i class="fa-regular fa-envelope"></i> CrossLine@hello.com</span>
                <span><i class="fa-solid fa-phone"></i> +91 386-688-3295</span>
            </div>

        </div>

    </footer>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if(typeof message !== "undefined" && message){ %>

<script>

Swal.fire({
    icon: "warning",
    title: "<%= message %>",
    timer: 2000,
    showConfirmButton: false
});

</script>

<% } %>

</body>
</html>