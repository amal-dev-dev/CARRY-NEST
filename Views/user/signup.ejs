<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carry Nest - Sign Up</title>
    <link rel="stylesheet" href="/Styles/user/signup.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<header class="main-header">
    <div class="container">
        <h1 class="logo">CARRY NEST</h1>
    </div>
</header>

<main class="login-section">
    <div class="login-card">

        <h2>Create Account</h2>
        <p class="subtitle">Please fill the details to create your account</p>

        <!-- Social -->
        <div class="social-login">
            <a href="/auth/google" style="text-decoration: none;">
                <button type="button" class="social-btn">
                    <img src="https://www.svgrepo.com/show/355037/google.svg">
                    Sign up
                </button>
            </a>
        </div>
        
        <form class="login-form" action="/user/signup" method="POST">

            <div class="input-group">
                <label>Name</label>
                <input type="text" name="name" placeholder="Enter your name" >
            </div>

            <div class="input-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="example@gmail.com" >
            </div>

            <div class="input-group">
                <label>Phone</label>
                <input type="text" name="phone" placeholder="Enter phone number">
            </div>

            <div class="input-group">
                <label>Password</label>
                <div class="password-wrapper">
                    <input type="password" name="password" placeholder="••••••••" >
                    <i class="far fa-eye"></i>
                </div>
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <div class="password-wrapper">
                    <input type="password" name="confirmPassword" placeholder="••••••••">
                    <i class="far fa-eye"></i>
                </div>
            </div>

            <div class="input-group">
                <label>Referral Code</label>
                <input type="text" name="referralCode" placeholder="Optional">
            </div>

            <!-- Terms -->
            <div class="form-options">
                <label>
                    <input type="checkbox"> I agree to privacy policy & terms
                </label>
            </div>

            <button type="submit" class="btn-primary">CREATE ACCOUNT</button>
        </form>

        <p class="signup-prompt">
            Already have an account? <a href="/user/login">Sign in</a>
        </p>

    </div>
</main>

<!-- SAME FOOTER (no change needed) -->
<footer class="footer">
    <div class="container footer-grid">

        <div class="footer-col">
            <h3>CARRY NEST</h3>
            <p>Lorem ipsum dolor sit amet consectetur.</p>
        </div>

        <div class="footer-col">
            <h4>Service</h4>
            <ul>
                <li><a href="#">Laptop Bags</a></li>
                <li><a href="#">Trekking Bags</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Company</h4>
            <ul>
                <li><a href="#">Features</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>Contact</h4>
            <div class="contact-form">
                <input type="text" placeholder="Email">
                <button>Send</button>
            </div>
        </div>

    </div>
</footer>

<<script>

 const message = `<%= typeof message !== 'undefined' ? message : '' %>`;

        if(message){
            
            Swal.fire({
            icon: "error",
            title: "Error",
            text: message
        });
    }

const signupForm = document.querySelector("form");

signupForm.addEventListener("submit", (e) => {

    const name = document.querySelector('input[name="name"]').value.trim();
    const email = document.querySelector('input[name="email"]').value.trim();
    const phone = document.querySelector('input[name="phone"]').value.trim();
    const password = document.querySelector('input[name="password"]').value.trim();
    const confirmPassword = document.querySelector('input[name="confirmPassword"]').value.trim();

    if(!name && !email && !password && !confirmPassword){
        e.preventDefault();
        Swal.fire({
            icon: "warning",
            title: "Missing Fields",
            text: "Please fill all fields"
        });

        return;
    }
    
    if(!name){
        e.preventDefault();
        Swal.fire({
            icon: "warning",
            title: "Name Required",
            text: "Please enter your name"
        });

        return;
    }

    if(!email){
        e.preventDefault();
        Swal.fire({
            icon: "warning",
            title: "Email Required",
            text: "Please enter your email"
        });

        return;
    }


    if(!phone){
        e.preventDefault();
        Swal.fire({
            icon: "warning",
            title: "Phone Required",
            text: "Please enter your phone number"
        });

        return;
    }

    if(!password){
        e.preventDefault();
        Swal.fire({
            icon: "warning",
            title: "Password Required",
            text: "Please enter your password"
        });

        return;
    }


    if(!confirmPassword){
        e.preventDefault();
        Swal.fire({
            icon: "warning",
            title: "Confirm Password",
            text: "Please confirm your password"
        });

        return;
    }

    if(password !== confirmPassword){
        e.preventDefault();
        Swal.fire({
            icon: "error",
            title: "Password Error",
            text: "Passwords do not match"
        });

        return;
    }
});


document.querySelectorAll(".fa-eye").forEach(icon => {
    icon.addEventListener("click", () => {
        const input = icon.previousElementSibling;
        input.type = input.type === "password"? "text": "password";
    });
});

</script>

</body>
</html>