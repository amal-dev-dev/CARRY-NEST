<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carry Nest - Sign Up</title>
    <link rel="stylesheet" href="/Styles/user/signup.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<header class="main-header">
    <div class="container">
        <h1 class="logo">CARRY NEST</h1>
    </div>
</header>

<main class="login-section">
    <div class="login-card">

        <h2>Create Account</h2>
        <p class="subtitle">Please fill the details to create your account</p>

        <!-- Social -->
        <div class="social-login">
            <a href="/auth/google" style="text-decoration: none;">
                <button type="button" class="social-btn">
                    <img src="https://www.svgrepo.com/show/355037/google.svg">
                    Sign up
                </button>
            </a>
        </div>
        
        <form class="login-form" action="/user/signup" method="POST" id="signupForm" novalidate>

            <div class="input-group">
                <label>Name</label>
                <input type="text" name="name" placeholder="Enter your name" >
            </div>

            <div class="input-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="example@gmail.com">
            </div>

            <div class="input-group">
                <label>Phone</label>
                <input type="text" name="phone" placeholder="Enter phone number">
            </div>

            <div class="input-group">
                <label>Password</label>
                <div class="password-wrapper">
                    <input type="password" name="password" placeholder="••••••••" >
                    <i class="far fa-eye"></i>
                </div>
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <div class="password-wrapper">
                    <input type="password" name="confirmPassword" placeholder="••••••••">
                    <i class="far fa-eye"></i>
                </div>
            </div>

            <div class="input-group">
                <label>Referral Code</label>
                <input type="hidden" name="referralCode" value="<%= referralCode || '' %>">
            </div>

            <!-- Terms -->
            <div class="form-options">
                <label>
                    <input type="checkbox" name="terms" id="terms">
                    I agree to privacy policy & terms
                </label>
            </div>

            <button type="submit" class="btn-primary">CREATE ACCOUNT</button>
        </form>

        <p class="signup-prompt">
            Already have an account? <a href="/user/login">Sign in</a>
        </p>

    </div>
</main>


<footer>
    <div class="footer-container">

        <!-- Brand -->
        <div class="footer-col">
            <h3>CARRY NEST</h3>
            <p class="footer-tagline">
                Carry Your World. Your Style, Your Journey.
            </p>
            <p>
                Discover stylish, durable and functional bags
                designed for everyday life, work and travel.
            </p>
        </div>

        <!-- Shop -->
        <div class="footer-col">
            <h4>Shop</h4>

            <a href="/user/products">All Products</a>
            <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
            <a href="/user/products?category=Office%20Bags">Office Bags</a>
            <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
            <a href="/user/products?category=School%20Bags">School Bags</a>
            <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
            <h4>Quick Links</h4>
            <a href="/user/home">Home</a>
            <a href="/user/about">About Us</a>
            <a href="/user/profile">My Account</a>
            <a href="/user/orders">My Orders</a>
            <a href="/user/contact">Contact Us</a>
        </div>

        <!-- Contact -->
        <div class="footer-col footer-contact">
            <h4>Contact Us</h4>

            <p>
                <i class="fa-regular fa-envelope"></i>
                support@yourdomain.com
            </p>

            <p>
                <i class="fa-solid fa-phone"></i>
                +91 XXXXX XXXXX
            </p>

            <p>
                <i class="fa-solid fa-location-dot"></i>
                Kerala, India
            </p>

            <div class="social-icons">
                <a href="#" aria-label="Facebook">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
                <a href="#" aria-label="Instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>
                <a href="#" aria-label="WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                </a>
            </div>
        </div>

    </div>

    <div class="footer-bottom">
        <p>© 2026 CARRY NEST. All Rights Reserved.</p>

        <div class="footer-bottom-info">
            <a href="/user/privacy-policy">Privacy Policy</a>
            <a href="/user/terms">Terms & Conditions</a>
            <a href="/user/return-policy">Return Policy</a>
        </div>
    </div>
</footer>


<script>
document.addEventListener("DOMContentLoaded", () => {

    // Show server-side validation errors
    const message = <%- JSON.stringify(
        typeof message !== "undefined" ? message : ""
    ) %>;

    if (message) {
        Swal.fire({
            icon: "error",
            title: "Signup Error",
            text: message
        });
    }

    const signupForm = document.getElementById("signupForm");

    signupForm.addEventListener("submit", (e) => {
        const name = signupForm.querySelector('[name="name"]').value.trim();
        const email = signupForm.querySelector('[name="email"]').value.trim();
        const phone = signupForm.querySelector('[name="phone"]').value.trim();
        const password = signupForm.querySelector('[name="password"]').value;
        const confirmPassword =
            signupForm.querySelector('[name="confirmPassword"]').value;
        const terms = signupForm.querySelector('[name="terms"]').checked;

        let errorTitle = "";
        let errorMessage = "";

        if (!name || !email || !phone || !password || !confirmPassword) {
            errorTitle = "Missing Fields";
            errorMessage = "Please fill in all required fields.";
        } else if (!/^[A-Za-z ]{2,50}$/.test(name)) {
            errorTitle = "Invalid Name";
            errorMessage = "Name must contain 2–50 letters and spaces.";
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            errorTitle = "Invalid Email";
            errorMessage = "Please enter a valid email address.";
        } else if (!/^[6-9]\d{9}$/.test(phone)) {
            errorTitle = "Invalid Phone";
            errorMessage = "Enter a valid 10-digit Indian mobile number.";
        } else if (
            !/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9\s])\S{8,}$/.test(password)
        ) {
            errorTitle = "Weak Password";
            errorMessage =
                "Password must be at least 8 characters with uppercase, lowercase, a number and a special character.";
        } else if (password !== confirmPassword) {
            errorTitle = "Password Mismatch";
            errorMessage = "Passwords do not match.";
        } else if (!terms) {
            errorTitle = "Terms Required";
            errorMessage = "Please agree to the privacy policy and terms.";
        }

        if (errorMessage) {
            e.preventDefault();

            Swal.fire({
                icon: "warning",
                title: errorTitle,
                text: errorMessage,
                confirmButtonText: "OK"
            });

            return;
        }
    });

    // Show/hide password
    document.querySelectorAll(".fa-eye").forEach(icon => {
        icon.addEventListener("click", () => {
            const input = icon.previousElementSibling;

            input.type = input.type === "password" ? "text" : "password";

            icon.classList.toggle("fa-eye");
            icon.classList.toggle("fa-eye-slash");
        });
    });

});
</script>


</body>
</html>