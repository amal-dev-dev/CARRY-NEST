<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CARRY NEST - Personal Information</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/Styles/user/referral.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">CARRY NEST</div>

        <div class="nav-icons">
            <a href="/user/cart" class="cart-link">
                <i class="fa-solid fa-cart-shopping"></i>

                <% if (cartCount > 0) { %>
                    <span class="cart-badge"><%= cartCount %></span>
                <% } %>
            </a>
            
            <a href="/user/wishlist" class="wishlist-link">
                <i class="fa-regular fa-heart"></i>

                <% if (wishlistCount > 0) { %>
                    <span class="wishlist-badge">
                        <%= wishlistCount %>
                    </span>
                <% } %>
            </a>

            <a href="/user/profile">
                <i class="fa-regular fa-user"></i>
            </a>
        </div>
    </nav>

    <div class="profile-page-layout">
        <!-- Sidebar -->
        <aside class="sidebar-container">
            <div class="user-id-card">
                <div class="avatar-box">
                    <img src="<%= user.profileImage || 'https://ui-avatars.com/api/?name=' + user.name %>">
                </div>
                <h3><%= user.name %></h3>
                <p class="user-email"><%= user.email %></p>
                <p class="user-phone"><%= user.phone %></p>
            </div>

            <nav class="nav-menu">
                <!-- Personal Information is now the ACTIVE item -->
                 <a href="/user/home" class="nav-item">
                    <span class="nav-icon"> <i class="fa-solid fa-house"></i></span> Home
                </a>
                <a href="/user/profile" class="nav-item">
                    <span class="nav-icon"><i class="fa-regular fa-user"></i></span> Personal Information
                </a>
                <a href="/user/address" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-location-dot"></i></span> Addresses
                </a>
                <a href="#" class="nav-item active">
                    <span class="nav-icon"><i class="fa-solid fa-gift"></i></span> Referrals
                </a>
                <a href="/user/orders" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-box"></i></span> Order History
                </a>
                <a href="/user/wallet" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-wallet"></i></span> Wallet
                </a>
                <a href="/user/change-password" class="nav-item">
                    <span class="nav-icon"><i class="fa-solid fa-key"></i></span> Change Password
                </a>
                <div class="nav-divider"></div>
                <form action="/user/logout" method="POST" class="logout-form">
                    <button type="submit" class="nav-item logout-btn">
                        <span class="nav-icon">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </span>
                        Logout
                    </button>
                </form>
            </nav>
        </aside>

        <main class="main-content">

            <!-- Page Title -->
            <div class="page-title">
                <h2>Referrals</h2>
            </div>


            <!-- Invite Friends -->
            <section class="referral-invite-card">

                <div class="invite-icon">
                    <i class="ri-gift-line"></i>
                </div>

                <div class="invite-content">

                    <h3>Invite Friends & Earn Rewards</h3>

                    <p>
                        Get ₹100 in your wallet for every friend who signs up
                        using your referral code!
                    </p>

                    <div class="referral-action">

                        <!-- Referral Code -->
                        <div class="referral-field">

                            <label>Referral Code</label>

                            <div class="referral-code-box">

                                <input
                                    type="text"
                                    id="referralCode"
                                    value="<%= referralCode %>"
                                    readonly
                                >

                                <button
                                    type="button"
                                    onclick="copyReferralCode()"
                                    title="Copy referral code"
                                >
                                    <i class="fa-regular fa-copy"></i>
                                </button>

                            </div>

                        </div>


                        <!-- Referral Link -->
                        <div class="referral-field">

                            <label>Referral Link</label>

                            <div class="referral-code-box">

                                <input
                                    type="text"
                                    id="referralLink"
                                    value="<%= referralLink %>"
                                    readonly
                                >

                                <button
                                    type="button"
                                    onclick="copyReferralLink()"
                                    title="Copy referral link"
                                >
                                    <i class="fa-regular fa-copy"></i>
                                </button>

                            </div>

                        </div>


                        <button
                            type="button"
                            class="share-btn"
                            onclick="shareReferralLink()"
                        >
                            Share Link
                        </button>

                    </div>

                </div>

            </section>


            <!-- ==============================
                REFERRAL STATISTICS
            =============================== -->

            <section class="referral-stats">

                <div class="stat-card">

                    <span class="stat-title">
                        Total Referrals
                    </span>

                    <strong>
                        <%= totalReferrals || 0 %>
                    </strong>

                    <small>
                        Successful referrals
                    </small>

                </div>


                <div class="stat-card">

                    <span class="stat-title">
                        Pending Rewards
                    </span>

                    <strong>
                        ₹<%= pendingRewards || 0 %>
                    </strong>

                    <small>
                        Pending rewards
                    </small>

                </div>


                <div class="stat-card">

                    <span class="stat-title">
                        Total Earned
                    </span>

                    <strong>
                        ₹<%= totalEarned || 0 %>
                    </strong>

                    <small>
                        Referral rewards earned
                    </small>

                </div>

            </section>


            <!-- ==============================
                REFERRAL HISTORY
            =============================== -->

            <section class="referral-history">

                <div class="section-heading">
                    <h3>Referral History</h3>
                </div>


                <div class="referral-table-wrapper">

                    <table class="referral-table">

                        <thead>

                            <tr>
                                <th>Name</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Reward</th>
                            </tr>

                        </thead>


                        <tbody>

                            <% if (referralHistory && referralHistory.length > 0) { %>

                                <% referralHistory.forEach(referral => { %>

                                    <tr>

                                        <td>
                                            <%= referral.name %>
                                        </td>

                                        <td>
                                            <%= new Date(referral.date).toLocaleDateString("en-IN", {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric"
                                            }) %>
                                        </td>

                                        <td>

                                            <% if (referral.status === "completed") { %>

                                                <span class="status completed">
                                                    Completed
                                                </span>

                                            <% } else { %>

                                                <span class="status pending">
                                                    Pending
                                                </span>

                                            <% } %>

                                        </td>

                                        <td class="reward">
                                            ₹<%= referral.reward %>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } else { %>

                                <tr>

                                    <td
                                        colspan="4"
                                        class="no-referrals"
                                    >
                                        No referral history available.
                                    </td>

                                </tr>

                            <% } %>

                        </tbody>

                    </table>

                </div>

            </section>

        </main>
  
    </div>

    <!-- Dark Footer -->
    <footer>
        <div class="footer-container">

            <!-- Brand -->
            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p class="footer-tagline">
                    Carry Your World. Your Style, Your Journey.
                </p>
                <p>
                    Discover stylish, durable and functional bags
                    designed for everyday life, work and travel.
                </p>
            </div>

            <!-- Shop -->
            <div class="footer-col">
                <h4>Shop</h4>

                <a href="/user/products">All Products</a>
                <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
                <a href="/user/products?category=Office%20Bags">Office Bags</a>
                <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
                <a href="/user/products?category=School%20Bags">School Bags</a>
                <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
            </div>

            <!-- Quick Links -->
            <div class="footer-col">
                <h4>Quick Links</h4>
                <a href="/user/home">Home</a>
                <a href="/user/about">About Us</a>
                <a href="/user/profile">My Account</a>
                <a href="/user/orders">My Orders</a>
                <a href="/user/contact">Contact Us</a>
            </div>

            <!-- Contact -->
            <div class="footer-col footer-contact">
                <h4>Contact Us</h4>

                <p>
                    <i class="fa-regular fa-envelope"></i>
                    support@yourdomain.com
                </p>

                <p>
                    <i class="fa-solid fa-phone"></i>
                    +91 XXXXX XXXXX
                </p>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Kerala, India
                </p>

                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 CARRY NEST. All Rights Reserved.</p>

            <div class="footer-bottom-info">
                <a href="/user/privacy-policy">Privacy Policy</a>
                <a href="/user/terms">Terms & Conditions</a>
                <a href="/user/return-policy">Return Policy</a>
            </div>
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <% if (typeof message !== "undefined" && message) { %>
        <script>
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "<%= message %>"
            });
        </script>
        <% } %>

        <% if (typeof success !== "undefined" && message) { %>
        <script>
        Swal.fire({
            icon: "success",
            title: "<%= success %>",
            confirmButtonColor: "#000"
        });
        </script>
        <% } %>

    <script>

        function togglePassword(inputId, icon){

            const input = document.getElementById(inputId);

            if(input.type === "password"){

                input.type = "text";

                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");

            }else{

                input.type = "password";

                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");

            }

        }

    </script>   
    
    <script>

        function copyReferralLink() {

            const referralLink =
                document.getElementById("referralLink").value;

            navigator.clipboard.writeText(referralLink)
                .then(() => {

                    Swal.fire({
                        icon: "success",
                        title: "Copied!",
                        text: "Referral link copied successfully.",
                        timer: 1500,
                        showConfirmButton: false
                    });

                })
                .catch(() => {

                    Swal.fire({
                        icon: "error",
                        title: "Failed",
                        text: "Unable to copy referral link."
                    });

                });
        }


        async function shareReferralLink() {

            const referralLink =
                document.getElementById("referralLink").value;

            if (navigator.share) {

                try {

                    await navigator.share({
                        title: "Join Carry Nest",
                        text: "Join Carry Nest using my referral link!",
                        url: referralLink
                    });

                } catch (error) {

                    console.log("Sharing cancelled");

                }

            } else {

                copyReferralLink();

            }
        }

        function copyReferralCode() {

            const code =
                document.getElementById("referralCode").value;

            navigator.clipboard.writeText(code);

            Swal.fire({
                icon: "success",
                title: "Copied!",
                text: "Referral code copied.",
                timer: 1200,
                showConfirmButton: false
            });
        }


        function copyReferralLink() {

            const link =
                document.getElementById("referralLink").value;

            navigator.clipboard.writeText(link);

            Swal.fire({
                icon: "success",
                title: "Copied!",
                text: "Referral link copied.",
                timer: 1200,
                showConfirmButton: false
            });
        }


        async function shareReferralLink() {

            const link =
                document.getElementById("referralLink").value;

            if (navigator.share) {

                try {

                    await navigator.share({
                        title: "Join Carry Nest",
                        text: "Join Carry Nest using my referral link!",
                        url: link
                    });

                } catch (error) {

                    console.log("Share cancelled");
                }

            } else {

                copyReferralLink();
            }
        }

    </script>

</body>
</html>