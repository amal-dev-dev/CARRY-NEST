    <main class="auth-container">
        <div class="auth-card">
            <h2>Enter The OTP</h2>
            <p class="subtitle">The OTP was sent to your registered email.<br>Please check the spam folder.</p>
            
            <form class="auth-form" action="/user/forgot-otp" method="POST">
                <div class="input-group">
                    <label for="otp">OTP</label>
                    <input type="text" id="otp" name="otp" placeholder="******" maxlength="6">
                </div>
                <button type="submit" class="btn-primary">Verify OTP</button>
            </form>
              <div class="otp-extra">
                    <p id="timer" class="timer-text"></p>
                    <form action="/user/forgot/resend-otp" method="POST">
                            <button type="submit"
                                id="resendBtn"
                                class="resend-btn"
                                disabled>
                            Resend OTP
                        </button>
                    </form>
                </div>
            <a href="/user/login" class="back-link">Back To Sign in</a>
        </div>
    </main>

    <footer>
        <div class="footer-container">

            <!-- Brand -->
            <div class="footer-col">
