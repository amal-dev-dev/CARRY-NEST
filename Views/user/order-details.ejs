<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>CARRY NEST - Order Details</title>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

    <link
        rel="stylesheet"
        href="/Styles/user/order-details.css"
    >
</head>
<body>

    <!-- =========================
            HEADER
    ========================= -->
    <nav class="navbar">

        <div class="logo">
            CARRY NEST
        </div>

        <div class="nav-icons">
            <a href="/user/cart" style="color: black;">
                <i class="fa-solid fa-cart-shopping"></i>
            </a>

            <a href="/user/wishlist" style="color: black;">
                <i class="fa-regular fa-heart"></i>
            </a>

            <a href="/user/profile" style="color: black;">
                <i class="fa-regular fa-user"></i>
            </a>
        </div>

    </nav>

    <div class="breadcrumb">
        <a href="/user/orders">Orders</a>
        <span>/</span>
        <span>Order Details</span>
    </div>

    <!-- =========================
            ORDER DETAILS PAGE
    ========================= -->
    <main class="order-details-page">

        <!-- ORDER TOP -->
        <section class="order-top-bar">

            <div class="order-id-block">
                <h2>
                    Order ID:
                    <span>
                        <%= order.orderId || order._id.toString().slice(-10).toUpperCase() %>
                    </span>
                </h2>

                <div class="top-order-actions">

                    <span class="top-status-badge <%= order.orderStatus %>">
                        <%= order.orderStatus.replaceAll("_", " ") %>
                    </span>

                    <% if (order.orderStatus !== "cancelled") { %>

                        <a href="/user/orders/<%= order._id %>/invoice"
                        class="invoice-btn">

                            <i class="fa-solid fa-file-invoice"></i>
                            Download Invoice

                        </a>

                    <% } %>

                </div>

            </div>

            <div class="order-date-block">
                <p>
                    <span>Order date:</span>
                    <%= new Date(order.createdAt).toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    }) %>
                </p>

                <p>
                    <span>Estimated delivery:</span>
                    <%= order.deliveryDate
                        ? new Date(order.deliveryDate).toLocaleDateString("en-IN", {
                            day: "numeric",
                            month: "short",
                            year: "numeric"
                        })
                        : "Not available" %>
                </p>
            </div>

        </section>

        <!-- =========================
                ORDER STATUS TRACKER
        ========================= -->
        <%
        const totalProducts = order.products.length;

        const shippedCount = order.products.filter(item =>
            ["shipped","out_for_delivery","delivered","return_requested","returned"]
            .includes(item.status)
        ).length;

        const outForDeliveryCount = order.products.filter(item =>
            ["out_for_delivery","delivered","return_requested","returned"]
            .includes(item.status)
        ).length;

        const deliveredCount = order.products.filter(item =>
            ["delivered","return_requested","returned"]
            .includes(item.status)
        ).length;
        %>
        <section class="order-tracker">

            <!-- Order Confirmed -->
            <div class="tracker-step active">
                <div class="step-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h4>Order Confirmed</h4>

                <p>
                    <%= totalProducts %> / <%= totalProducts %> Products
                </p>
            </div>

            <div class="tracker-line <%= shippedCount > 0 ? 'active' : '' %>"></div>

            <!-- Shipped -->
            <div class="tracker-step <%= shippedCount > 0 ? 'active' : '' %>">

                <div class="step-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h4>Shipped</h4>

                <p>
                    <%= shippedCount %> / <%= totalProducts %> Products
                </p>

            </div>

            <div class="tracker-line <%= outForDeliveryCount > 0 ? 'active' : '' %>"></div>

            <!-- Out For Delivery -->
            <div class="tracker-step <%= outForDeliveryCount > 0 ? 'active' : '' %>">

                <div class="step-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h4>Out For Delivery</h4>

                <p>
                    <%= outForDeliveryCount %> / <%= totalProducts %> Products
                </p>

            </div>

            <div class="tracker-line <%= deliveredCount > 0 ? 'active' : '' %>"></div>

            <!-- Delivered -->
            <div class="tracker-step <%= deliveredCount > 0 ? 'active' : '' %>">

                <div class="step-icon">
                    <i class="fa-solid fa-check"></i>
                </div>

                <h4>Delivered</h4>

                <p>
                    <%= deliveredCount %> / <%= totalProducts %> Products
                </p>

            </div>

        </section>

        <!-- cancelled message -->
        <% if (order.orderStatus === "cancelled") { %>
            <div class="order-alert cancelled-alert">
                This order has been cancelled.
            </div>
        <% } %>

        <!-- =========================
                CONTENT GRID
        ========================= -->
        <section class="order-content-grid">

            <!-- LEFT -->
            <div class="order-left">

                <!-- ORDER DETAILS CARD -->
                <div class="details-card">

                    <h3 class="section-title">Order Details</h3>

                    <% if (order.products && order.products.length > 0) { %>

                        <% order.products.forEach((product) => { %>

                            <div class="order-product-item">

                                <div class="product-image-box">
                                    <img
                                        src="<%= product.productId?.productImage?.[0] || '/images/default-product.png' %>"
                                        alt="<%= product.productId?.productName || 'Product' %>"
                                    >
                                </div>

                                <div class="product-info-box">
                                    <h4>
                                        <%= product.productId?.productName || 'Product not available' %>
                                    </h4>

                                    <p>Qty : <%= product.quantity %></p>

                                    <% if(product.size){ %>
                                        <p>Size : <%= product.size %></p>
                                    <% } %>

                                    <span class="product-status <%= product.status || order.orderStatus %>">
                                        <%= (product.status || order.orderStatus).replaceAll("_", " ") %>
                                    </span>
                                </div>

                                <div class="product-price-box">
                                    ₹<%= product.price * product.quantity %>
                                </div>

                                <div class="order-actions">

                                    <!-- CANCEL BUTTON -->
                                    <% const canCancel =
                                        ![
                                            "cancelled",
                                            "delivered",
                                            "returned",
                                            "return_requested"
                                        ].includes(product.status) &&
                                        ![
                                            "cancelled",
                                            "delivered",
                                            "returned",
                                            "return_requested",
                                            "partially_returned"
                                        ].includes(order.orderStatus);
                                    %>

                                    <%
                                    const canCancelProduct =
                                        ["pending", "confirmed"].includes(
                                            product.status || order.orderStatus
                                        );
                                    %>

                                    <% if (canCancelProduct) { %>

                                        <button
                                            type="button"
                                            class="cancel-order-btn"
                                            onclick="openCancelProductModal(
                                                '<%= order._id %>',
                                                '<%= product.productId?._id || product.productId %>'
                                            )">

                                            Cancel Product

                                        </button>

                                    <% } %>

                                    <!-- RETURN BUTTON -->
                                    <% const canReturn =
                                        product.status === "delivered" &&
                                        order.orderStatus === "delivered";
                                    %>

                                    <% if (canReturn) { %>

                                    <button
                                        type="button"
                                        class="return-order-btn"
                                        onclick="openReturnProductModal('<%= order._id %>','<%= product.productId?._id || product.productId %>')">

                                        Return Product

                                    </button>

                                    <% } %>

                                    <!-- returned label -->
                                    <% if(product.status === "returned"){ %>

                                    <span class="returned-label">
                                        Returned
                                    </span>

                                    <% } %>

                                    <% if(product.status === "return_requested"){ %>

                                    <span class="returned-label pending-return">
                                        Return Requested
                                    </span>

                                    <% } %>

                                </div>

                            </div>

                        <% }) %>

                    <% } else { %>

                        <p>No products found in this order.</p>

                    <% } %>

                </div>

                <!-- PAYMENT CARD -->
                <div class="details-card">

                    <h3 class="section-title">Payment</h3>

                    <div class="simple-info">
                        <p>
                            By
                            <strong>
                                <%= order.paymentMethod || "Cash On Delivery" %>
                            </strong>
                        </p>

                        <p>
                            Status :
                            <strong>
                                <%= order.orderStatus.replaceAll("_", " ") || "pending" %>
                            </strong>
                        </p>
                    </div>

                </div>

                <!-- DELIVERY CARD -->
                <div class="details-card">

                    <h3 class="section-title">Delivery</h3>

                    <div class="delivery-info">
                        <p class="delivery-name">
                            <%= order.deliveryAddress?.name || "" %>
                        </p>

                        <p><%= order.deliveryAddress?.addressLine1 || "" %></p>

                        <% if(order.deliveryAddress?.addressLine2){ %>
                            <p><%= order.deliveryAddress.addressLine2 %></p>
                        <% } %>

                        <p>
                            <%= order.deliveryAddress?.city || "" %>,
                            <%= order.deliveryAddress?.state || "" %> -
                            <%= order.deliveryAddress?.pincode || "" %>
                        </p>

                        <p><%= order.deliveryAddress?.phone || "" %></p>
                    </div>

                </div>

                <!-- WHOLE ORDER CANCEL BUTTON -->
                <%
                const activeProducts = order.products.filter(product =>
                    ![
                        "cancelled",
                        "returned",
                        "return_requested"
                    ].includes(product.status)
                );

                const canCancelAll =
                    activeProducts.length > 0 &&
                    activeProducts.every(product =>
                        ["pending", "confirmed"].includes(product.status || order.orderStatus)
                    );
                %>

                <% if (canCancelAll) { %>

                    <button
                        type="button"
                        class="bottom-cancel-btn"
                        onclick="openCancelOrderModal('<%= order._id %>')">

                        <i class="fa-solid fa-xmark"></i>
                        Cancel All

                    </button>

                <% } %>

                <!-- WHOLE ORDER RETURN BUTTON -->
                <%
                const canReturnAll =
                    order.orderStatus === "delivered" &&
                    order.products.some(p => p.status === "delivered");
                %>

                <% if(canReturnAll){ %>

                <button
                    type="button"
                    class="bottom-return-btn"
                    onclick="openReturnOrderModal('<%= order._id %>')">

                    Return Full Order

                </button>

                <% } %>

            </div>

            <!-- RIGHT -->
            <aside class="order-right">

                <div class="summary-card">

                    <h3 class="section-title">Order Summary</h3>

                    <%
                        let subtotal = 0;
                        const discount = order.discountApplied || 0;
                        const delivery = 0;
                    %>

                    <% order.products.forEach(product => { %>

                        <%
                            const isCancelled = product.status === "cancelled";
                            const itemTotal = product.price * product.quantity;

                            if (!isCancelled) {
                                subtotal += itemTotal;
                            }
                        %>

                        <div class="summary-row product-row">

                            <div>

                                <p class="summary-product-name">
                                    <%= product.productId?.productName || "Product" %>
                                </p>

                                <% if (isCancelled) { %>

                                    <small class="cancelled-text">
                                        Cancelled
                                    </small>

                                <% } else { %>

                                    <small>
                                        ₹<%= product.price %> × <%= product.quantity %>
                                    </small>

                                <% } %>

                            </div>

                            <span>

                                <% if (isCancelled) { %>

                                    --

                                <% } else { %>

                                    ₹<%= itemTotal %>

                                <% } %>

                            </span>

                        </div>

                    <% }) %>

                    <div class="summary-divider"></div>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>₹<%= subtotal %></span>
                    </div>

                    <div class="summary-row">
                        <span>Discount</span>
                        <span>₹<%= discount %></span>
                    </div>

                    <div class="summary-row">
                        <span>Delivery</span>
                        <span><%= delivery === 0 ? "FREE" : "₹" + delivery %></span>
                    </div>

                    <div class="summary-divider"></div>

                    <div class="summary-row total-row">
                        <span>Total</span>
                        <span>₹<%= subtotal - discount + delivery %></span>
                    </div>

                </div>

            </aside>

        </section>

    </main>

    <!-- =========================
            FOOTER
    ========================= -->
    <footer class="footer">
        <div class="footer-top">
            <div class="footer-col about">
                <h3 class="footer-logo">CARRY NEST</h3>
                <p>Lorem ipsum dolor sit amet consectetur. Purus in etiam risus ut sem eu urna. Massa feugiat consequat nec libero.</p>
                <p>Lorem ipsum dolor sit</p>
            </div>

            <div class="footer-col">
                <h3>Service</h3>
                <ul>
                    <li><a href="#">Laptop Bags</a></li>
                    <li><a href="#">Trekking Bags</a></li>
                    <li><a href="#">School Bags</a></li>
                    <li><a href="#">Office Bags</a></li>
                    <li><a href="#">Travelling Bags</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Company</h3>
                <ul>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Features</a></li>
                    <li><a href="#">Our Team</a></li>
                    <li><a href="#">Portfolio</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-col contact-form">
                <h3>Contact Us</h3>
                <p>Your Email/Phone no.</p>
                <div class="subscribe-box">
                    <input type="text" placeholder="Enter Your Email or Phone no.">
                    <button class="send-btn">Send</button>
                </div>
                <div class="social-icons">
                    <div class="social-icon fb"></div>
                    <div class="social-icon ig"></div>
                    <div class="social-icon wa"></div>
                    <div class="social-icon li"></div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>Copyright Tanah Air Studio</p>
            <div class="info-links">
                <span>📍 8819 Ohio St. South Gate, CA 90280</span>
                <span>✉️ CrossLine@hello.com</span>
                <span>📞 +91 386-688-3295</span>
            </div>
        </div>
    </footer>

    <!-- =========================
            CANCEL FULL ORDER MODAL
    ========================= -->
    <div id="cancelOrderModal" class="cancel-modal-overlay">
        <div class="cancel-modal">

            <div class="cancel-modal-header">
                <h3>Cancel Full Order</h3>
                <button type="button" class="close-modal-btn" onclick="closeCancelOrderModal()">
                    &times;
                </button>
            </div>

            <form id="cancelOrderForm" method="POST">
                <div class="cancel-modal-body">
                    <label for="cancelOrderReason">Reason for cancellation</label>

                    <div class="cancel-input-box">
                        <input
                            type="text"
                            id="cancelOrderReason"
                            name="reason"
                            placeholder="Type the reason for cancelling the full order"
                            required
                        >
                    </div>
                </div>

                <div class="cancel-modal-footer">
                    <button type="button" class="modal-cancel-btn" onclick="closeCancelOrderModal()">
                        Close
                    </button>

                    <button type="submit" class="modal-submit-btn">
                        Submit
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- =========================
            CANCEL SINGLE PRODUCT MODAL
    ========================= -->
    <div id="cancelProductModal" class="cancel-modal-overlay">
        <div class="cancel-modal">

            <div class="cancel-modal-header">
                <h3>Cancel Product</h3>
                <button type="button" class="close-modal-btn" onclick="closeCancelProductModal()">
                    &times;
                </button>
            </div>

            <form id="cancelProductForm" method="POST">
                <div class="cancel-modal-body">
                    <label for="cancelProductReason">Reason for cancellation</label>

                    <div class="cancel-input-box">
                        <input
                            type="text"
                            id="cancelProductReason"
                            name="reason"
                            placeholder="Type the reason for cancelling this product"
                            required
                        >
                    </div>
                </div>

                <div class="cancel-modal-footer">
                    <button type="button" class="modal-cancel-btn" onclick="closeCancelProductModal()">
                        Close
                    </button>

                    <button type="submit" class="modal-submit-btn">
                        Submit
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- =========================
            RETURN PRODUCT MODAL
    ========================= -->
    <div id="returnProductModal" class="cancel-modal-overlay">
        <div class="cancel-modal">

            <div class="cancel-modal-header">
                <h3>Return Product</h3>
                <button type="button" class="close-modal-btn" onclick="closeReturnProductModal()">
                    &times;
                </button>
            </div>

            <form id="returnProductForm" method="POST">
                <div class="cancel-modal-body">
                    <label for="returnProductReason">Reason for return</label>

                    <div class="cancel-input-box">
                        <input
                            type="text"
                            id="returnProductReason"
                            name="reason"
                            placeholder="Type the reason for returning this product"
                            required
                        >
                    </div>
                </div>

                <div class="cancel-modal-footer">
                    <button type="button" class="modal-cancel-btn" onclick="closeReturnProductModal()">
                        Close
                    </button>

                    <button type="submit" class="modal-submit-btn">
                        Submit
                    </button>
                </div>
            </form>

        </div>
    </div>

<script>
    const cancelOrderModal = document.getElementById("cancelOrderModal");
    const cancelOrderForm = document.getElementById("cancelOrderForm");

    const cancelProductModal = document.getElementById("cancelProductModal");
    const cancelProductForm = document.getElementById("cancelProductForm");

    const returnProductModal = document.getElementById("returnProductModal");
    const returnProductForm = document.getElementById("returnProductForm");

    // FULL ORDER CANCEL
    function openCancelOrderModal(orderId) {
        cancelOrderModal.classList.add("show");
        cancelOrderForm.action = `/user/orders/${orderId}/cancel`;
    }

    function closeCancelOrderModal() {
        cancelOrderModal.classList.remove("show");
        document.getElementById("cancelOrderReason").value = "";
    }

    // SINGLE PRODUCT CANCEL
    function openCancelProductModal(orderId, productId) {
        cancelProductModal.classList.add("show");
        cancelProductForm.action = `/user/orders/${orderId}/products/${productId}/cancel`;
    }

    function closeCancelProductModal() {
        cancelProductModal.classList.remove("show");
        document.getElementById("cancelProductReason").value = "";
    }

    // RETURN PRODUCT
    function openReturnProductModal(orderId, productId) {
        returnProductModal.classList.add("show");
        returnProductForm.action = `/user/orders/${orderId}/products/${productId}/return`;
    }

    function closeReturnProductModal() {
        returnProductModal.classList.remove("show");
        document.getElementById("returnProductReason").value = "";
    }

    // close modal on outside click
    window.addEventListener("click", function (e) {
        if (e.target === cancelOrderModal) {
            closeCancelOrderModal();
        }

        if (e.target === cancelProductModal) {
            closeCancelProductModal();
        }

        if (e.target === returnProductModal) {
            closeReturnProductModal();
        }
    });
</script>

</body>
</html>