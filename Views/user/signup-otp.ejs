<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter OTP - CARRY NEST</title>
    <link rel="stylesheet" href="/styles/user/signup-otp.css">
</head>
<body>

    <header class="header">
        <h1 class="logo">CARRY NEST</h1>
    </header>

    <main class="auth-container">
        <div class="auth-card">
            <h2>Enter The OTP</h2>
            <p class="subtitle">The OTP was sent to your registered email.<br>Please check the spam folder.</p>

            <% if (typeof message !== 'undefined') { %>
                <p style="color:red; text-align:center;"><%= message %></p>
            <% } %>
            
            <form class="auth-form" action="/user/signup/otp" method="POST">
                <div class="input-group">
                    <label for="otp">OTP</label>
                    <input type="text" id="otp" name="otp" placeholder="******" maxlength="6" required>
                </div>
                <button type="submit" class="btn-primary">Verify OTP</button>
                    <div class="otp-extra">
                        <p id="timer" class="timer-text"></p>
                    </div>
                </form>
                <div class="otp-extra">
                    <p id="timer" class="timer-text"></p>
                    <form action="/user/resend-otp" method="POST">
                            <button type="submit"
                                id="resendBtn"
                                class="resend-btn"
                                disabled>
                            Resend OTP
                        </button>
                    </form>
                </div>
            <a href="/user/signup" class="back-link">Back To Sign up</a>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-top">
            <div class="footer-col about">
                <h3>CARRY NEST</h3>
                <p>Lorem ipsum dolor sit amet consectetur. Purus in etiam risus ut sem eu urna. Massa feugiat consequat nec libero.</p>
                <p>Lorem ipsum dolor sit</p>
            </div>
            
            <div class="footer-col">
                <h3>Service</h3>
                <ul>
                    <li><a href="#">Laptop Bags</a></li>
                    <li><a href="#">Trekking Bags</a></li>
                    <li><a href="#">School Bags</a></li>
                    <li><a href="#">Office Bags</a></li>
                    <li><a href="#">Travelling Bags</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Company</h3>
                <ul>
                    <li><a href="#">Service</a></li>
                    <li><a href="#">Features</a></li>
                    <li><a href="#">Our Team</a></li>
                    <li><a href="#">Portfolio</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-col contact-form">
                <h3>Contact Us</h3>
                <p>Your Email/Phone no.</p>
                <div class="subscribe-box">
                    <input type="text" placeholder="Enter Your Email or Phone no.">
                    <button class="send-btn">Send</button>
                </div>
                <div class="social-icons">
                    <div class="social-icon fb"></div>
                    <div class="social-icon ig"></div>
                    <div class="social-icon wa"></div>
                    <div class="social-icon li"></div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>Copyright Tanah Air Studio</p>
            <div class="info-links">
                <span><i class="location-icon"></i> 8819 Ohio St. South Gate, CA 90280</span>
                <span><i class="email-icon"></i> CrossLine@hello.com</span>
                <span><i class="phone-icon"></i> +91 386-688-3295</span>
            </div>
        </div>
    </footer>

<script>

    document.querySelectorAll(".fa-solid.fa-eye.toggle-eye").forEach(icon => {
        icon.addEventListener("click", () => {
            const input = icon.previousElementSibling;
            input.type = input.type === "password" ? "text" : "password";
        });
    });


    const expiryTime = new Date("<%= otpExpiry %>").getTime();

    const timer = document.getElementById('timer');

    const resendBtn = document.getElementById('resendBtn');

    function updateTimer(){

        const now = Date.now();

        const remaining = expiryTime - now;

        if(remaining <= 0){

            timer.innerHTML = "OTP Expired";

            resendBtn.disabled = false;

            clearInterval(interval);

            return;
        }

        const minutes = Math.floor(remaining / 1000 / 60);

        const seconds = Math.floor((remaining / 1000) % 60);

        timer.innerHTML =
        `OTP expires in ${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
    }

    updateTimer();

    const interval = setInterval(updateTimer, 1000);

</script>
</body>
</html>