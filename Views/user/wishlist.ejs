<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist</title>

    <link rel="stylesheet" href="/Styles/user/wishlist.css">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <!-- Include Navbar -->

    <nav class="navbar">

    <div class="logo">
        CARRY NEST
    </div>

    <div class="nav-icons">

        <a href="/user/cart" class="cart-link">
            <i class="fa-solid fa-cart-shopping"></i>

            <% if (cartCount > 0) { %>
                <span class="cart-badge"><%= cartCount %></span>
            <% } %>
        </a>

        <a href="/user/wishlist" class="wishlist-link">
            <i class="fa-regular fa-heart"></i>

            <% if (wishlistCount > 0) { %>
                <span class="wishlist-badge">
                    <%= wishlistCount %>
                </span>
            <% } %>
        </a>

        <a href="/user/profile" style="color: black;"><i class="fa-regular fa-user"></i></a>

    </div>

</nav>

<section class="wishlist-section">

    <div class="container">

        <!-- Breadcrumb -->

        <div class="breadcrumb-box">
            <a href="/user/home" style="color: #777;text-decoration: none;">Home</a>
            <span>/</span>
            <span>Wishlist</span>
        </div>

        <!-- Heading -->

        <div class="wishlist-header">

            <div>
                <h2>Your Wishlist</h2>
            </div>

            <div class="wishlist-info">

                <p>
                    <%= wishlistItems.length %> Items
                </p>

                <% if(wishlistItems.length > 0){ %>

                <form action="/user/wishlist/move-all" method="POST">

                    <button type="submit" class="move-all-btn">
                        Move All To Cart
                    </button>

                </form>

                <% } %>

            </div>

        </div>

        <!-- Wishlist Grid -->

        <div class="wishlist-grid">

            <% if(wishlistItems.length > 0){ %>

            <% wishlistItems.forEach(item=>{ %>

            <div class="wishlist-card">

                <!-- Remove -->

                <form action="/user/wishlist/remove/<%= item.productId %>?_method=PATCH" method="POST">

                    <button type="submit" class="remove-btn">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </form>

                <!-- Image -->

                <div class="wishlist-image">

                    <a href="/user/product-details/<%= item.productId %>">

                        <img
                            src="<%= item.image %>"
                            alt="<%= item.productName %>">

                    </a>

                </div>

                <!-- Content -->

                <div class="wishlist-content">

                    <h5>

                        <%= item.productName %>

                    </h5>

                    <p class="brand">

                        <%= item.brand %>

                    </p>

                    <div class="price-box">

                        <% if(item.salePrice < item.regularPrice){ %>

                        <span class="sale-price">

                            ₹<%= item.salePrice %>

                        </span>

                        <span class="regular-price">

                            ₹<%= item.regularPrice %>

                        </span>

                        <% } else { %>

                        <span class="sale-price">

                            ₹<%= item.regularPrice %>

                        </span>

                        <% } %>

                    </div>

                    <p class="size">

                        Size :
                        <strong>

                            <%= item.size %>

                        </strong>

                    </p>

                    <form action="/user/add-to-cart" method="POST" class="addToCartForm">

                        <input
                            type="hidden"
                            name="variantId"
                            value="<%= item.variantId %>">

                        <input
                            type="hidden"
                            name="quantity"
                            value="1">

                        <button type="submit" class="cart-btn">
                            Add To Cart
                        </button>

                    </form>

                </div>

            </div>

            <% }) %>   

            <!-- Continue Shopping Card -->

            <div class="continue-card">

                <div>

                    <i class="bi bi-plus-circle"></i>

                    <h5>

                        Continue Shopping

                    </h5>

                    <p>

                        Explore our latest collection.

                    </p>

                    <a href="/user/products">

                        Shop Collection

                    </a>

                </div>

            </div>

            <% } else { %>

            <!-- Empty Wishlist -->

            <div class="empty-wishlist">

                <i class="bi bi-heart"></i>

                <h3>

                    Your Wishlist is Empty

                </h3>

                <p>

                    Save your favourite products here.

                </p>

                <a href="/user/products"
                class="shop-btn">

                    Continue Shopping

                </a>

            </div>

            <% } %>

        </div>

    </div>

</section>

<!-- Footer -->

<script>
    
document.querySelectorAll(".addToCartForm").forEach(form => {

    form.addEventListener("submit", async function(e) {

        e.preventDefault();

        const variantId = this.querySelector("[name='variantId']").value;
        const quantity = this.querySelector("[name='quantity']").value;

        const response = await fetch(this.action, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                variantId,
                quantity
            })
        });

        const data = await response.json();

        if (data.success) {

            await Swal.fire({
                icon: "success",
                title: "Success",
                text: data.message,
                timer: 1500,
                showConfirmButton: false
            });

            location.reload();

        } else {

            Swal.fire({
                icon: "warning",
                title: "Unavailable",
                text: data.message
            });

        }

    });

});

</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>