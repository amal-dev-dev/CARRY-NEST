<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - Carry Nest</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- CSS -->
  <link rel="stylesheet" href="/Styles/user/reset-password.css">
</head>
<body>

<header class="header">
  <h2>CARRY NEST</h2>
</header>

<main class="container">
  <div class="card">
    <h2>Reset Password</h2>
    <p class="subtitle">
      Your new password must be different from previously used passwords
    </p>

     <% if (typeof message !== 'undefined') { %>
        <p style="color:red; text-align:center;"><%= message %></p>
    <% } %>

    <form action="/user/reset-password" method="POST">

      <!-- New Password -->
      <div class="input-group password-field">
        <input type="password" name="newPassword" placeholder="New Password" required>
        <i class="fa-solid fa-eye toggle-eye"></i>
      </div>

      <!-- Confirm Password -->
      <div class="input-group password-field">
        <input type="password" name="confirmPassword" placeholder="Confirm Password" required>
        <i class="fa-solid fa-eye toggle-eye"></i>
      </div>

      <button type="submit" class="btn">Reset Password</button>

      <a href="#" class="back-link">Back To Sign in</a>

    </form>
  </div>
</main>

<footer class="footer">
  <div class="footer-container">

    <div class="footer-col">
      <h4>CARRY NEST</h4>
      <p>Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>
    </div>

    <div class="footer-col">
      <h4>Service</h4>
      <ul>
        <li>Laptop Bags</li>
        <li>Trekking Bags</li>
        <li>School Bags</li>
        <li>Office Bags</li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li>About Us</li>
        <li>Portfolio</li>
        <li>Blog</li>
        <li>Contact</li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contact Us</h4>
      <input type="text" placeholder="Enter your email">
      <button class="send-btn">Send</button>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© 2026 Carry Nest. All rights reserved.</p>
  </div>
</footer>

   <script>

        document.querySelectorAll(".fa-solid.fa-eye").forEach(icon => {
        icon.addEventListener("click", () => {
            const input = icon.previousElementSibling;
            input.type = input.type === "password" ? "text" : "password";
            });
        });

    </script>

</body>
</html>