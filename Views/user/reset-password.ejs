<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - Carry Nest</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/Styles/user/reset-password.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

  <header class="header">
    <h2>CARRY NEST</h2>
  </header>

  <main class="container">
    <div class="card">
      <h2>Reset Password</h2>
      <p class="subtitle">
        Your new password must be different from previously used passwords
      </p>

      <form action="/user/reset-password" method="POST">

        <!-- New Password -->
        <div class="input-group password-field">
          <input type="password" name="newPassword" placeholder="New Password">
          <i class="fa-solid fa-eye toggle-eye"></i>
        </div>

        <!-- Confirm Password -->
        <div class="input-group password-field">
          <input type="password" name="confirmPassword" placeholder="Confirm Password">
          <i class="fa-solid fa-eye toggle-eye"></i>
        </div>

        <button type="submit" class="btn">Reset Password</button>

        <a href="#" class="back-link">Back To Sign in</a>

      </form>
    </div>
  </main>

    <footer>
        <div class="footer-container">

            <!-- Brand -->
            <div class="footer-col">
                <h3>CARRY NEST</h3>
                <p class="footer-tagline">
                    Carry Your World. Your Style, Your Journey.
                </p>
                <p>
                    Discover stylish, durable and functional bags
                    designed for everyday life, work and travel.
                </p>
            </div>

            <!-- Shop -->
            <div class="footer-col">
                <h4>Shop</h4>

                <a href="/user/products">All Products</a>
                <a href="/user/products?category=Laptop%20Bags">Laptop Bags</a>
                <a href="/user/products?category=Office%20Bags">Office Bags</a>
                <a href="/user/products?category=Travel%20Bags">Travel Bags</a>
                <a href="/user/products?category=School%20Bags">School Bags</a>
                <a href="/user/products?category=Trekking%20Bags">Trekking Bags</a>
            </div>

            <!-- Quick Links -->
            <div class="footer-col">
                <h4>Quick Links</h4>
                <a href="/user/home">Home</a>
                <a href="/user/about">About Us</a>
                <a href="/user/profile">My Account</a>
                <a href="/user/orders">My Orders</a>
                <a href="/user/contact">Contact Us</a>
            </div>

            <!-- Contact -->
            <div class="footer-col footer-contact">
                <h4>Contact Us</h4>

                <p>
                    <i class="fa-regular fa-envelope"></i>
                    support@yourdomain.com
                </p>

                <p>
                    <i class="fa-solid fa-phone"></i>
                    +91 XXXXX XXXXX
                </p>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Kerala, India
                </p>

                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a href="#" aria-label="WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 CARRY NEST. All Rights Reserved.</p>

            <div class="footer-bottom-info">
                <a href="/user/privacy-policy">Privacy Policy</a>
                <a href="/user/terms">Terms & Conditions</a>
                <a href="/user/return-policy">Return Policy</a>
            </div>
        </div>
    </footer>

  <script>

      const message = `<%= typeof message !== 'undefined' ? message : '' %>`;

        if(message){

            Swal.fire({
                icon: "error",
                title: "Error",
                text: message
            });
        }

      const resetForm = document.querySelector("form");

      resetForm.addEventListener("submit", (e) => {
        const newPassword = document.querySelector('input[name="newPassword"]').value.trim();
        const confirmPassword = document.querySelector('input[name="confirmPassword"]').value.trim();

          if(!newPassword){
              e.preventDefault();
              Swal.fire({
                  icon: "warning",
                  title: "Password Required",
                  text: "Please enter new password"
              });
              return;
          }

          if(!confirmPassword){
              e.preventDefault();
              Swal.fire({
                  icon: "warning",
                  title: "Confirm Password Required",
                  text: "Please confirm your password"
              });
              return;
          }

          if(newPassword !== confirmPassword){
              e.preventDefault();
              Swal.fire({
                  icon: "error",
                  title: "Password Error",
                  text: "Passwords do not match"
              });
              return;
          }
      });


      document.querySelectorAll(".fa-solid.fa-eye").forEach(icon => {
        icon.addEventListener("click", () => {
            const input = icon.previousElementSibling;
            input.type = input.type === "password" ? "text" : "password";
            });
        });

  </script>

</body>
</html>